    {
      "id": "snapshot",
      "name_zh": "截屏",
      "name_en": "Snapshot",
      "description_zh": "保存摄像头当前拍摄的画面快照。完成后触发 '截屏完成' 条件。",
      "description_en": "Take a snapshot of the current image from the camera.  Use 'SnapshotURL' expression to get result.",
      "display_zh": "截屏 (格式: {0}, 质量: [i]{1}[/i])",
      "display_en": "Take snapshot ({0}, quality [i]{1}[/i])",
      "scriptName": "Snapshot",
      "isAsync": true,
      "category": "media-request",
      "params": [
        {
          "id": "format",
          "type": "combo",
          "name_zh": "格式",
          "name_en": "Format",
          "desc_zh": "选择快照保存的文件格式。PNG为无损图像，但JPEG文件小。",
          "desc_en": "Choose the file format to save the snapshot.  PNG is lossless but JPEG files are smaller.",
          "items": [
            "png",
            "jpeg"
          ],
          "items_i18n": {
            "png": {
              "zh": "PNG",
              "en": "PNG"
            },
            "jpeg": {
              "zh": "JPEG",
              "en": "JPEG"
            }
          }
        },
        {
          "id": "jpeg-quality",
          "type": "number",
          "name_zh": "JPEG品质",
          "name_en": "JPEG quality",
          "desc_zh": "仅适用于 'JPEG' 格式，控制输出品质从 0 (最差) 到 100 (最好)，但品质越小图像则越模糊，设为 100 则无损输出。",
          "desc_en": "If 'Format' is 'JPEG', the JPEG quality from 0 (worst) to 100 (best).  Ignored for PNG.",
          "initialValue": "75"
        }
      ],
      "category_zh": "媒体捕获",
      "category_en": "Media request"
    },
    {
      "id": "request-microphone",
      "name_zh": "请求使用麦克风",
