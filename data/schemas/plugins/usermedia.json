    {
      "id": "request-camera",
      "name_zh": "请求使用摄像头",
      "name_en": "Request camera",
      "description_zh": "向用户请求访问相机的权限作为视频输入。（如果设备支持）",
      "description_en": "Prompt the user for access to video input from a camera, if one is present.",
      "display_zh": "请求使用摄像头权限 (设备源: [i]{0}[/i],  摄像头: [i]{1}[/i],  预设分辨率: {2}x{3}, 麦克风: [i]{4}[/i], 麦克风设备源: [i]{5}[/i])",
      "display_en": "Request camera source [i]{0}[/i] (prefer [i]{1}[/i] at {2} x {3}, include mic [i]{4}[/i] source [i]{5}[/i])",
      "scriptName": "RequestCamera",
      "isAsync": true,
      "category": "media-request",
      "params": [
        {
          "id": "source",
          "type": "number",
          "name_zh": "设备源",
          "name_en": "Source",
          "desc_zh": "要使用的相机源的从0开始的索引。",
          "desc_en": "The zero-based index of the camera source to use."
        },
        {
          "id": "preferred-direction",
          "type": "combo",
          "name_zh": "摄像头",
          "name_en": "Preferred direction",
          "desc_zh": "如果存在多个摄像头，优先选择的摄像头朝向。移动设备通常包含多个摄像头。",
          "desc_en": "The preferred camera facing mode, if multiple cameras are present. Commonly mobile devices have both user-facing (front) and environment-facing (back) cameras.",
          "items": [
            "any",
            "user",
            "environment"
          ],
          "items_i18n": {
            "any": {
              "zh": "任意",
              "en": "Any"
            },
            "user": {
              "zh": "前置",
              "en": "User-facing"
            },
            "environment": {
              "zh": "后置",
              "en": "Environment-facing"
            }
          }
        },
        {
          "id": "preferred-width",
          "type": "number",
          "name_zh": "预设宽度",
          "name_en": "Preferred width",
          "desc_zh": "预设的水平分辨率。 默认值为0。",
          "desc_en": "The preferred horizontal resolution. Leave at 0 for default."
        },
        {
          "id": "preferred-height",
          "type": "number",
          "name_zh": "预设高度",
          "name_en": "Preferred height",
          "desc_zh": "预设的垂直分辨率。 默认值为0。",
          "desc_en": "The preferred vertical resolution. Leave at 0 for default."
        },
        {
          "id": "include-mic",
          "type": "boolean",
          "name_zh": "包含麦克风",
          "name_en": "Include microphone",
          "desc_zh": "是否请求麦克风作为音频输入的权限，有助于同时录制视频和音频。",
          "desc_en": "Whether to also request audio input from the user's microphone. Useful to allow recording combined video and audio."
        },
        {
          "id": "mic-source",
          "type": "number",
          "name_zh": "麦克风源",
          "name_en": "Microphone source",
          "desc_zh": "使用麦克风时，指定麦克风设备源的索引，从 0 开始计数。",
          "desc_en": "The zero-based index of the audio source to use, if microphone is included."
        }
      ],
      "category_zh": "媒体捕获",
      "category_en": "Media request"
    },
