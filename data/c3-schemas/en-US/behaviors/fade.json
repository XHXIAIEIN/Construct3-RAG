{
  "id": "fade",
  "name": "Fade",
  "description": "Change an object's opacity over time.  Useful for making objects gradually disappear.",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "on-fade-out-finished",
      "scriptName": "OnFadeOutEnd",
      "category": "",
      "list-name": "On fade-out finished",
      "display-text": "On {my} fade-out finished",
      "description": "Triggered when the fade-out has finished.",
      "isTrigger": true
    },
    {
      "id": "on-fade-in-finished",
      "scriptName": "OnFadeInEnd",
      "category": "",
      "list-name": "On fade-in finished",
      "display-text": "On {my} fade-in finished",
      "description": "Triggered when the fade-in has finished.",
      "isTrigger": true
    },
    {
      "id": "on-wait-finished",
      "scriptName": "OnWaitEnd",
      "category": "",
      "list-name": "On wait finished",
      "display-text": "On {my} wait finished",
      "description": "Triggered when the wait has finished.",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "restart-fade",
      "scriptName": "RestartFade",
      "category": "",
      "list-name": "Restart fade",
      "display-text": "{my}: restart fade",
      "description": "Run the fade again."
    },
    {
      "id": "start-fade",
      "scriptName": "StartFade",
      "category": "",
      "list-name": "Start fade",
      "display-text": "{my}: start fade",
      "description": "Start the fade, if not active on start."
    },
    {
      "id": "set-fade-in-time",
      "scriptName": "SetFadeInTime",
      "category": "",
      "list-name": "Set fade-in time",
      "display-text": "{my}: set fade-in time to [i]{0}[/i]",
      "description": "Set the fade-in time property.",
      "params": {
        "fade-in-time": {
          "type": "number",
          "name": "Fade-in time",
          "desc": "Time in seconds to spend in the fade-in phase."
        }
      }
    },
    {
      "id": "set-wait-time",
      "scriptName": "SetWaitTime",
      "category": "",
      "list-name": "Set wait time",
      "display-text": "{my}: set wait time to [i]{0}[/i]",
      "description": "Set the wait time property.",
      "params": {
        "wait-time": {
          "type": "number",
          "name": "Wait time",
          "desc": "Time in seconds to spend in the wait phase."
        }
      }
    },
    {
      "id": "set-fade-out-time",
      "scriptName": "SetFadeOutTime",
      "category": "",
      "list-name": "Set fade-out time",
      "display-text": "{my}: set fade-out time to [i]{0}[/i]",
      "description": "Set the fade-out time property.",
      "params": {
        "fade-out-time": {
          "type": "number",
          "name": "Fade-out time",
          "desc": "Time in seconds to spend in the fade-out phase."
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "fadeintime",
      "scriptName": "FadeInTime",
      "category": "",
      "translated-name": "FadeInTime",
      "description": "The fade-in time in seconds.",
      "returnType": "number"
    },
    {
      "id": "waittime",
      "scriptName": "WaitTime",
      "category": "",
      "translated-name": "WaitTime",
      "description": "The wait time in seconds.",
      "returnType": "number"
    },
    {
      "id": "fadeouttime",
      "scriptName": "FadeOutTime",
      "category": "",
      "translated-name": "FadeOutTime",
      "description": "The fade-out time in seconds.",
      "returnType": "number"
    }
  ],
  "properties": {
    "fade-in-time": {
      "name": "Fade in time",
      "desc": "Duration in seconds of fade-in, or zero to skip."
    },
    "wait-time": {
      "name": "Wait time",
      "desc": "Duration in seconds of time to wait between fade-in and fade-out, or zero to skip."
    },
    "fade-out-time": {
      "name": "Fade out time",
      "desc": "Duration in seconds of fade-out, or zero to skip."
    },
    "destroy": {
      "name": "Destroy",
      "desc": "Automatically destroy the object after it has faded out."
    },
    "enabled": {
      "name": "Enabled",
      "desc": "Whether the fade starts running immediately, or on the 'Start' action."
    },
    "live-preview": {
      "name": "Preview",
      "desc": "Tick to run a live preview in the editor."
    }
  }
}