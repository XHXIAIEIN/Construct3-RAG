  "conditions": [
    {
      "id": "is-supported",
      "scriptName": "IsSupported",
      "category": "midi-access",
      "list-name": "Is supported",
      "display-text": "Is supported",
      "description": "True if the current platform supports MIDI access."
    },
    {
      "id": "has-access",
      "scriptName": "HasAccess",
      "category": "midi-access",
      "list-name": "Has access",
      "display-text": "Has access",
      "description": "True after requesting MIDI access completes successfully."
    },
    {
      "id": "on-request-access-success",
      "scriptName": "OnRequestAccessSuccess",
      "category": "midi-access",
      "list-name": "On request access success",
      "display-text": "On request access success",
      "description": "Triggered after a successful request to access MIDI devices.",
      "isTrigger": true
    },
    {
      "id": "on-request-access-failed",
      "scriptName": "OnRequestAccessFailed",
      "category": "midi-access",
