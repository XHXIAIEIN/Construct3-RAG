      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The device type.",
          "items": {
            "input": "input",
            "output": "output"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-device-error",
      "scriptName": "OnAnyDeviceError",
      "category": "midi-devices",
      "list-name": "On any device error",
      "display-text": "On any {0} device error",
      "description": "Triggered when any MIDI device encounters an error.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The device type.",
          "items": {
            "input": "input",
            "output": "output"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-binary-message",
      "scriptName": "OnAnyBinaryMessage",
      "category": "midi-input",
      "list-name": "On any binary message",
      "display-text": "On any binary message (in {0})",
      "description": "Triggered when any MIDI message is received, storing the raw message data in a Binary Data object.",
      "params": {
        "receive-to": {
          "type": "object",
          "name": "Receive to",
          "desc": "Choose a Binary Data object to write the received binary message to."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-message",
      "scriptName": "OnAnyMessage",
      "category": "midi-input",
      "list-name": "On any message",
      "display-text": "On any [b]{0}[/b] message",
      "description": "Triggered when a MIDI message of a specific type is received from any device.",
      "params": {
        "message-type": {
          "type": "combo",
          "name": "Message type",
          "desc": "The type of MIDI message received.",
          "items": {
            "note-off": "Note Off",
            "note-on": "Note On",
            "after-touch": "AfterTouch",
            "control-change": "Control Change",
            "program-change": "Program Change",
            "channel-pressure": "Channel Pressure",
            "pitch-wheel": "Pitch Wheel"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-message",
      "scriptName": "OnMessage",
      "category": "midi-input",
      "list-name": "On message",
      "display-text": "On [i]{0}[/i] [b]{1}[/b] message",
      "description": "Triggered when a MIDI message of a specific type is received from a specific device.",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the last opened input device."
        },
        "message-type": {
          "type": "combo",
          "name": "Message type",
          "desc": "The type of MIDI message received.",
          "items": {
            "note-off": "Note Off",
            "note-on": "Note On",
            "after-touch": "AfterTouch",
            "control-change": "Control Change",
            "program-change": "Program Change",
            "channel-pressure": "Channel Pressure",
            "pitch-wheel": "Pitch Wheel"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "compare-parameter",
      "scriptName": "CompareParameter",
      "category": "midi-input",
      "list-name": "Compare parameter",
      "display-text": "{0} {1} {2}",
      "description": "Compare the current value of a parameter like the note number or velocity.",
      "params": {
        "parameter": {
          "type": "combo",
          "name": "Parameter",
          "desc": "Choose the parameter to compare.",
          "items": {
            "note-number": "Note number",
            "channel": "Channel",
            "velocity": "Velocity",
            "pressure": "Pressure",
            "controller-number": "Controller number",
            "controller-value": "Controller value",
            "program-number": "Program number",
            "pitch-wheel-value": "Pitch wheel value"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "Choose the way to compare the parameter."
        },
        "value": {
          "type": "number",
          "name": "Value",
          "desc": "The value to compare to."
        }
      }
    }
  ],
  "actions": [
    {
      "id": "request-midi-access",
      "scriptName": "RequestMIDIAccess",
      "category": "midi-access",
      "list-name": "Request MIDI access",
      "display-text": "Request MIDI access (sysex: {0}, software: {1})",
      "description": "Request permission to access connected MIDI devices.",
      "params": {
        "sysex": {
          "type": "boolean",
          "name": "System exclusive",
          "desc": "Enable sending and receiving system exclusive (sysex) messages."
        },
        "software": {
          "type": "boolean",
          "name": "Software",
          "desc": "Allow the system to utilize any installed software synthesizers."
        }
      },
      "isAsync": true
    },
    {
      "id": "open-device",
      "scriptName": "OpenDevice",
      "category": "midi-devices",
      "list-name": "Open device",
      "display-text": "Open {0} device [i]{1}[/i]",
      "description": "Open a MIDI input or output to send or receive messages.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The device type.",
          "items": {
            "input": "input",
            "output": "output"
          }
        },
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the first available device."
        }
      },
      "isAsync": true
    },
    {
      "id": "close-device",
      "scriptName": "CloseDevice",
      "category": "midi-devices",
      "list-name": "Close device",
      "display-text": "Close {0} device [i]{1}[/i]",
      "description": "Close a MIDI input or output so it is no longer able to send or receive messages.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The device type.",
          "items": {
            "input": "input",
            "output": "output"
          }
        },
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to close the last opened device."
        }
      },
      "isAsync": true
    },
    {
      "id": "send-binary-message",
      "scriptName": "SendBinaryMessage",
      "category": "midi-output",
      "list-name": "Send binary message",
      "display-text": "Send [i]{0}[/i] binary message {1}",
      "description": "Send raw binary data as a MIDI message to a device.",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the last opened output device."
        },
        "binary-data": {
          "type": "object",
          "name": "Binary data",
          "desc": "Choose a Binary Data object to send as a MIDI message."
        }
      }
    },
    {
      "id": "send-note-message",
      "scriptName": "SendNoteMessage",
      "category": "midi-output",
      "list-name": "Send note message",
      "display-text": "Send [i]{0}[/i] {1} message for note [i]{2}[/i] velocity [i]{3}[/i]",
      "description": "Send a note on/off or aftertouch message.",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the last opened output device."
        },
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The message type to send.",
          "items": {
            "note-off": "note off",
            "note-on": "note on",
            "aftertouch": "aftertouch"
          }
        },
        "note": {
          "type": "any",
          "name": "Note",
          "desc": "The MIDI note number, or string of the note name e.g. \"C4\"."
        },
        "velocity": {
          "type": "number",
          "name": "Velocity",
          "desc": "The velocity, or pressure for aftertouch messages, from 0-127."
        }
      }
    },
    {
      "id": "send-control-change-message",
      "scriptName": "SendControlChangeMessage",
      "category": "midi-output",
      "list-name": "Send control change message",
      "display-text": "Send [i]{0}[/i] controller [i]{1}[/i] change message with value [i]{2}[/i]",
      "description": "Send a note on/off or aftertouch message.",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the last opened output device."
        },
        "controller-number": {
          "type": "number",
          "name": "Controller number",
          "desc": "The MIDI controller number, e.g. 1 for modulation wheel (coarse)."
        },
        "controller-value": {
          "type": "number",
          "name": "Controller value",
          "desc": "The controller value to set, from 0-127."
        }
      }
    },
    {
      "id": "send-message",
      "scriptName": "SendMessage",
      "category": "midi-output",
      "list-name": "Send message",
      "display-text": "Send [i]{0}[/i] {1} message value [i]{2}[/i]",
      "description": "Send a program change, channel pressure or pitch wheel message.",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID. Leave empty to use the last opened output device."
        },
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The message type to send.",
          "items": {
            "program-change": "program change",
            "channel-pressure": "channel pressure",
            "pitch-wheel": "pitch wheel"
          }
        },
        "value": {
          "type": "number",
          "name": "Value",
          "desc": "The value to send, from 0-127 for program change or channel pressure messages, or 0-16383 for pitch wheel messages."
        }
      }
    },
    {
      "id": "schedule-next-message",
      "scriptName": "ScheduleNextMessage",
      "category": "midi-output",
      "list-name": "Schedule next message",
      "display-text": "Schedule next message for [i]{0}[/i] seconds",
      "description": "Schedule the next sent MIDI message to be sent after a delay.",
      "params": {
        "time": {
          "type": "number",
          "name": "Time",
          "desc": "The time delay for the next message in seconds. Zero means no delay."
        }
      }
    },
    {
      "id": "set-midi-channel",
      "scriptName": "SetMIDIChannel",
      "category": "midi-output",
      "list-name": "Set MIDI channel",
      "display-text": "Set MIDI channel to [i]{0}[/i]",
      "description": "Set the MIDI channel to specify for all sent messages.",
      "params": {
        "channel": {
          "type": "number",
          "name": "Channel",
          "desc": "The MIDI channel, from 0-15."
        }
      }
    }
  ],
