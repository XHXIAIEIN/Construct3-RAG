      "list-name": "On devices state changed",
      "display-text": "On devices state changed",
      "description": "Triggered when the list of MIDI inputs or outputs changes.",
      "isTrigger": true
    },
    {
      "id": "on-device-opened",
      "scriptName": "OnDeviceOpened",
      "category": "midi-devices",
      "list-name": "On device opened",
      "display-text": "On {0} device [b]{1}[/b] opened",
      "description": "Triggered when a specific MIDI device is successfully opened.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The device type.",
          "items": {
            "input": "input",
            "output": "output"
          }
        },
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "The device ID."
        }
      },
      "isTrigger": true
