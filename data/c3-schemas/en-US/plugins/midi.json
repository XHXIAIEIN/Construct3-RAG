{
  "id": "midi",
  "name": "MIDI",
  "description": "Interact with connected MIDI devices.",
  "type": "plugin",
  "aceCategories": {
    "midi-access": "MIDI access",
    "midi-devices": "MIDI devices",
    "midi-input": "MIDI input",
    "midi-output": "MIDI output",
    "utilities": "Utilities"
