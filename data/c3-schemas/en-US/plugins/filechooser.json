{
  "id": "filechooser",
  "name": "File chooser",
  "description": "Allow a user to pick a file from their device, and access the chosen file.",
  "type": "plugin",
  "aceCategories": {
    "file-chooser": "File chooser"
  },
  "conditions": [
    {
      "id": "on-changed",
      "scriptName": "OnChanged",
      "category": "file-chooser",
      "list-name": "On changed",
      "display-text": "On changed",
      "description": "Triggered when a file selection is made.",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "release-file",
      "scriptName": "ReleaseFile",
      "category": "file-chooser",
      "list-name": "Release file",
      "display-text": "Release file [i]{0}[/i]",
      "description": "Release a file so it is no longer using memory.",
      "params": {
        "file-url": {
          "type": "string",
          "name": "File URL",
          "desc": "The URL of the file to release."
        }
      }
    },
    {
      "id": "click",
      "scriptName": "Click",
      "category": "file-chooser",
      "list-name": "Click",
      "display-text": "Click (activate file picker)",
      "description": "Activate the file picker as if the file chooser button was clicked. Note this may only work in a user input trigger."
    },
    {
      "id": "clear",
      "scriptName": "Clear",
      "category": "file-chooser",
      "list-name": "Clear",
      "display-text": "Clear",
      "description": "Clear any existing file selection from the file picker, restoring it to its initial state."
    }
  ],
  "expressions": [
    {
      "id": "filecount",
      "scriptName": "FileCount",
      "category": "file-chooser",
      "translated-name": "FileCount",
      "description": "The number of chosen files.",
      "returnType": "number"
    },
    {
      "id": "filenameat",
      "scriptName": "FileNameAt",
      "category": "file-chooser",
      "translated-name": "FileNameAt",
      "description": "Name of chosen file at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Index of file"
        }
      },
      "returnType": "string"
    },
    {
      "id": "filesizeat",
      "scriptName": "FileSizeAt",
      "category": "file-chooser",
      "translated-name": "FileSizeAt",
      "description": "Size of chosen file at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Index of file"
        }
      },
      "returnType": "number"
    },
    {
      "id": "filetypeat",
      "scriptName": "FileTypeAt",
      "category": "file-chooser",
      "translated-name": "FileTypeAt",
      "description": "MIME type of chosen file at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Index of file"
        }
      },
      "returnType": "string"
    },
    {
      "id": "fileurlat",
      "scriptName": "FileURLAt",
      "category": "file-chooser",
      "translated-name": "FileURLAt",
      "description": "A URL to access the data of the chosen file at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Index of file"
        }
      },
      "returnType": "string"
    }
  ],
  "properties": {
    "accept": {
      "name": "Accept",
      "desc": "File type filter, e.g. .png or image/*"
    },
    "select": {
      "name": "Select",
      "desc": "Whether to allow single or multiple file selection.",
      "items": {
        "single": "Single",
        "multiple": "Multiple"
      }
    },
    "initially-visible": {
      "name": "Initially visible",
      "desc": "Choose if the object is visible when the layout starts."
    },
    "id": {
      "name": "ID",
      "desc": "An optional ID for the element allowing it to be styled with CSS."
    },
    "class": {
      "name": "Class",
      "desc": "An optional class for the element allowing it to be styled with CSS."
    }
  },
  "commonAces": {
    "conditions": [
      "is-visible",
      "compare-instance-variable",
      "is-boolean-instance-variable-set",
      "pick-highestlowest",
      "pick-by-unique-id",
      "has-tags",
      "on-created",
      "on-destroyed",
      "on-instance-signal",
      "compare-x",
      "compare-y",
      "is-on-screen",
      "is-outside-layout",
      "pick-nearestfurthest",
      "compare-width",
      "compare-height",
      "is-on-layer",
      "pick-topbottom",
      "on-hierarchy-ready",
      "has-parent",
      "has-children",
      "pick-parent",
      "pick-children",
      "pick-nth-child",
      "compare-child-count",
      "is-focused",
      "is-enabled"
    ],
    "actions": [
      "set-visible",
      "set-instvar-value",
      "add-to-instvar",
      "subtract-from-instvar",
      "set-boolean-instvar",
      "toggle-boolean-instvar",
      "destroy",
      "change-tags",
      "set-from-json",
      "instance-signal",
      "instance-wait-for-signal",
      "set-x",
      "set-y",
      "set-position",
      "set-position-to-another-object",
      "move-at-angle",
      "set-width",
      "set-height",
      "set-size",
      "move-to-top",
      "move-to-bottom",
      "move-to-layer",
      "move-to-object",
      "add-child",
      "remove-child",
      "remove-from-parent",
      "set-css-style",
      "set-elem-attribute",
      "remove-elem-attribute",
      "set-focused",
      "set-unfocused",
      "set-enabled"
    ],
    "expressions": [
      "count",
      "pickedcount",
      "uid",
      "iid",
      "asjson",
      "objecttypename",
      "get-tags",
      "get-tags-count",
      "get-tag-at",
      "x",
      "y",
      "dt",
      "width",
      "height",
      "bboxleft",
      "bboxtop",
      "bboxback",
      "bboxright",
      "bboxbottom",
      "bboxfront",
      "bboxmidx",
      "bboxmidy",
      "bboxmidz",
      "layernumber",
      "layername",
      "zindex",
      "parent-uid",
      "child-count",
      "all-child-count",
      "template-name"
    ]
  }
}