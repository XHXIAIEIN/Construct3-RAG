      "display-text": "Move [b]{2}[/b] distance [i]{0}[/i] along [b]{1}[/b] axis",
      "description": "Move the camera and/or look position along axes relative to the direction the camera is pointing in.",
      "params": {
        "distance": {
          "type": "number",
          "name": "Distance",
          "desc": "Number of units to move along the given axis."
        },
        "axis": {
          "type": "combo",
          "name": "Axis",
          "desc": "Which axis, relative to the direction the camera is pointing in, to move along.",
          "items": {
            "forward": "Forward",
            "up": "Up",
            "right": "Right"
          }
        },
        "which": {
          "type": "combo",
          "name": "Which",
          "desc": "Whether to move the camera, the look position, or both.",
          "items": {
            "both": "Camera & look positions",
            "camera": "Camera position",
