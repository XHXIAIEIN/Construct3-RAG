{
  "id": "camera3d",
  "name": "3D camera",
  "description": "Move the camera in 3D to view the layout from a different perspective.",
  "type": "plugin",
  "aceCategories": {
    "3d-camera": "3D camera",
    "vectors": "Vectors",
    "layers": "Layers"
  },
  "conditions": [],
  "actions": [
    {
      "id": "look-at-position",
      "scriptName": "LookAtPosition",
      "category": "3d-camera",
      "list-name": "Look at position",
      "display-text": "Set camera position to ([i]{0}[/i], [i]{1}[/i], [i]{2}[/i]), look at ([i]{3}[/i], [i]{4}[/i], [i]{5}[/i]), up vector ([i]{6}[/i], [i]{7}[/i], [i]{8}[/i])",
      "description": "Orient the camera by setting the camera position and providing another position to point the camera towards.",
      "params": {
        "cam-x": {
          "type": "number",
          "name": "Camera X",
          "desc": "The X co-ordinate of the camera position."
        },
        "cam-y": {
          "type": "number",
          "name": "Camera Y",
          "desc": "The Y co-ordinate of the camera position."
        },
        "cam-z": {
          "type": "number",
          "name": "Camera Z",
          "desc": "The Z co-ordinate of the camera position."
        },
        "look-x": {
          "type": "number",
          "name": "Look at X",
          "desc": "The X co-ordinate of the position to point the camera at."
        },
        "look-y": {
          "type": "number",
          "name": "Look at Y",
          "desc": "The Y co-ordinate of the position to point the camera at."
        },
        "look-z": {
          "type": "number",
          "name": "Look at Z",
          "desc": "The Z co-ordinate of the position to point the camera at."
        },
        "up-x": {
          "type": "number",
          "name": "Up vector X",
          "desc": "The X component of a 3D vector indicating which way is up."
        },
        "up-y": {
          "type": "number",
          "name": "Up vector Y",
          "desc": "The Y component of a 3D vector indicating which way is up."
        },
        "up-z": {
          "type": "number",
          "name": "Up vector Z",
          "desc": "The Z component of a 3D vector indicating which way is up."
        }
      }
    },
    {
      "id": "look-parallel-to-layout",
      "scriptName": "LookParallelToLayout",
      "category": "3d-camera",
      "list-name": "Look parallel to layout",
      "display-text": "Set camera parallel to layout at ([i]{0}[/i], [i]{1}[/i], [i]{2}[/i]) angle [i]{3}[/i]",
      "description": "A shortcut to orient the camera looking parallel to the layout as opposed to down on to the layout.",
      "params": {
        "cam-x": {
          "type": "number",
          "name": "Camera X",
          "desc": "The X co-ordinate of the camera position."
        },
        "cam-y": {
          "type": "number",
          "name": "Camera Y",
          "desc": "The Y co-ordinate of the camera position."
        },
        "cam-z": {
          "type": "number",
          "name": "Camera Z",
          "desc": "The Z co-ordinate of the camera position."
        },
        "look-angle": {
          "type": "number",
          "name": "Look angle",
          "desc": "The angle in degrees to point the camera."
        }
      }
    },
    {
