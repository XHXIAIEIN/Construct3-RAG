        "rotate-x": {
          "type": "number",
          "name": "Rotate X",
          "desc": "Number of degrees to rotate horizontally."
        },
        "rotate-y": {
          "type": "number",
          "name": "Rotate Y",
          "desc": "Number of degrees to rotate vertically."
        },
        "min-polar-angle": {
          "type": "number",
          "name": "Min polar angle",
          "desc": "The minimum angle for Y rotation, limiting how far the camera can look upwards."
        },
        "max-polar-angle": {
          "type": "number",
          "name": "Max polar angle",
          "desc": "The maximum angle for Y rotation, limiting how far the camera can look downwards."
        }
      }
    },
