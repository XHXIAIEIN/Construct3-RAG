      "scriptName": "SetPosition",
      "category": "3d-camera",
      "list-name": "Set position",
      "display-text": "Set [b]{3}[/b] position to ([i]{0}[/i], [i]{1}[/i], [i]{2}[/i])",
      "description": "Set the camera or look position.",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "X position to set."
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "Y position to set."
        },
        "z": {
          "type": "number",
          "name": "Z",
          "desc": "Z position to set."
