{
  "id": "speechsynthesis",
  "name": "Speech synthesis",
  "description": "Use a text-to-speech engine to automatically read text aloud.",
  "type": "plugin",
  "aceCategories": {
    "speech-synthesis": "Speech synthesis"
  },
  "conditions": [
    {
      "id": "supports-speech-synthesis",
      "scriptName": "SupportsSpeechSynthesis",
      "category": "speech-synthesis",
      "list-name": "Supports speech synthesis",
      "display-text": "Supports speech synthesis",
      "description": "True if the current browser supports speech synthesis."
    },
    {
      "id": "is-speaking",
      "scriptName": "IsSpeaking",
      "category": "speech-synthesis",
      "list-name": "Is speaking",
      "display-text": "Is speaking",
      "description": "True if currently speaking some text."
    },
    {
      "id": "on-speech-ended",
      "scriptName": "OnSpeechEnded",
      "category": "speech-synthesis",
      "list-name": "On speech ended",
      "display-text": "On speech ended",
      "description": "Triggered when a phrase finishes being spoken.",
      "isTrigger": true
    },
    {
      "id": "on-speech-error",
      "scriptName": "OnSpeechError",
      "category": "speech-synthesis",
      "list-name": "On speech error",
      "display-text": "On speech error",
      "description": "Triggered if an error occurs when trying to speak text.",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "speak-text",
      "scriptName": "SpeakText",
      "category": "speech-synthesis",
      "list-name": "Speak text",
      "display-text": "Speak text [b]{0}[/b] (language [i]{1}[/i], voice URI [i]{2}[/i], volume [i]{3}[/i] dB, rate [i]{4}[/i], pitch [i]{5}[/i])",
      "description": "Read out some text with speech synthesis.",
      "params": {
        "text": {
          "type": "string",
          "name": "Text",
          "desc": "The text to be spoken."
        },
        "language": {
          "type": "string",
          "name": "Language",
          "desc": "The language of the text, e.g. \"en-US\" for US English. Leave empty to use the default language."
        },
        "voice-uri": {
          "type": "string",
          "name": "Voice URI",
          "desc": "The voice to use. Leave empty to use the default voice."
        },
        "volume": {
          "type": "number",
          "name": "Volume",
          "desc": "The volume to speak the text at, in dB attenuation."
        },
        "rate": {
          "type": "number",
          "name": "Rate",
          "desc": "The relative speed at which to speak, e.g. 1 for normal, 0.5 for half as fast."
        },
        "pitch": {
          "type": "number",
          "name": "Pitch",
          "desc": "The relative pitch at which to speak, between 0 and 2."
        }
      }
    },
    {
      "id": "stop-speaking",
      "scriptName": "StopSpeaking",
      "category": "speech-synthesis",
      "list-name": "Stop speaking",
      "display-text": "Stop speaking",
      "description": "Cancel any active speech synthesis."
    },
    {
      "id": "pause-speaking",
      "scriptName": "PauseSpeaking",
      "category": "speech-synthesis",
      "list-name": "Pause speaking",
      "display-text": "Pause speaking",
      "description": "Pause any active speech synthesis."
    },
    {
      "id": "resume-speaking",
      "scriptName": "ResumeSpeaking",
      "category": "speech-synthesis",
      "list-name": "Resume speaking",
      "display-text": "Resume speaking",
      "description": "Resume a previously paused speech synthesis."
    }
  ],
  "expressions": [
    {
      "id": "voicecount",
      "scriptName": "VoiceCount",
      "category": "speech-synthesis",
      "translated-name": "VoiceCount",
      "description": "Return the number of available voices.",
      "returnType": "number"
    },
    {
      "id": "voicenameat",
      "scriptName": "VoiceNameAt",
      "category": "speech-synthesis",
      "translated-name": "VoiceNameAt",
      "description": "Return the name of a voice at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Zero-based index of the voice."
        }
      },
      "returnType": "string"
    },
    {
      "id": "voicelangat",
      "scriptName": "VoiceLangAt",
      "category": "speech-synthesis",
      "translated-name": "VoiceLangAt",
      "description": "Return the language of a voice at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Zero-based index of the voice."
        }
      },
      "returnType": "string"
    },
    {
      "id": "voiceuriat",
      "scriptName": "VoiceURIAt",
      "category": "speech-synthesis",
      "translated-name": "VoiceURIAt",
      "description": "Return the URI of a voice at an index.",
      "params": {
        "index": {
          "type": "number",
          "name": "Index",
          "desc": "Zero-based index of the voice."
        }
      },
      "returnType": "string"
    }
  ],
  "properties": {}
}