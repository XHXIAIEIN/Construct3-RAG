{
  "id": "advancedrandom",
  "name": "Advanced Random",
  "description": "Utilities for advanced randomness",
  "type": "plugin",
  "aceCategories": {
    "advancedrandom": "Advanced Random",
    "gradients": "Gradients",
    "permutation-tables": "Permutation tables",
    "probability-tables": "Probability tables"
  },
  "conditions": [],
  "actions": [
    {
      "id": "createGradient",
      "scriptName": "CreateGradient",
      "category": "gradients",
      "list-name": "Create gradient",
      "display-text": "Create [b]{1}[/b] gradient called [b]{0}[/b]",
      "description": "Creates a new linear gradient",
      "params": {
        "name": {
          "type": "string",
          "name": "Name",
          "desc": "The name of the gradient"
        },
        "isColor": {
          "type": "combo",
          "name": "Mode",
          "desc": "Specify if the gradient is numerical or color",
          "items": {
            "number": "Number",
            "color": "Color"
          }
        }
      }
    },
    {
      "id": "addStop",
      "scriptName": "AddStop",
      "category": "gradients",
      "list-name": "Add gradient stop",
      "display-text": "Add stop at [b]{0}[/b] with value [b]{1}[/b]",
      "description": "Add a stop to the current gradient",
      "params": {
        "position": {
          "type": "number",
          "name": "Stop position",
          "desc": "The position of the new stop"
        },
        "value": {
          "type": "number",
          "name": "Stop value",
          "desc": "The value of the new stop. Use rgbEx/rgba expressions for color gradients."
        }
      }
    },
    {
      "id": "setGradient",
      "scriptName": "SetGradient",
      "category": "gradients",
      "list-name": "Set gradient",
      "display-text": "Set current gradient to [b]{0}[/b]",
      "description": "Sets current gradient",
      "params": {
        "name": {
          "type": "string",
          "name": "Name",
          "desc": "The name of the gradient"
        }
      }
    },
    {
      "id": "createPermutationTable",
      "scriptName": "CreatePermutationTable",
      "category": "permutation-tables",
      "list-name": "Create permutation table",
      "display-text": "Create permutation with {0} values starting at {1}",
      "description": "Creates a sequence of numbers that are randomly ordered.",
      "params": {
        "length": {
          "type": "number",
          "name": "Length",
          "desc": "The length of the new permutation table."
        },
        "offset": {
          "type": "number",
          "name": "Offset",
          "desc": "The lowest value in the table."
        }
      }
    },
    {
      "id": "shufflePermutationTable",
      "scriptName": "ShufflePermutationTable",
      "category": "permutation-tables",
      "list-name": "Shuffle permutation table",
      "display-text": "Shuffle permutation table",
      "description": "Reshuffles the current permutation table"
    },
    {
      "id": "createProbabilityTable",
      "scriptName": "CreateProbabilityTable",
      "category": "probability-tables",
      "list-name": "Create probability table",
      "display-text": "Create probability table called [b]{0}[/b]",
      "description": "Creates a new weighted probability table",
      "params": {
        "name": {
          "type": "string",
          "name": "Name",
          "desc": "The name of the probability table"
        }
      }
    },
    {
      "id": "createProbabilityTableFromJSON",
      "scriptName": "CreateProbabilityTableFromJSON",
      "category": "probability-tables",
      "list-name": "Create probability table from JSON",
      "display-text": "Create probability table called [b]{0}[/b] from [b]{1}[/b]",
      "description": "Creates a new weighted probability table from a JSON string",
      "params": {
        "name": {
          "type": "string",
          "name": "Name",
          "desc": "The name of the probability table"
        },
        "json": {
          "type": "string",
          "name": "JSON",
          "desc": "A JSON string of a serialized probability table"
        }
      }
    },
    {
      "id": "addProbabilityEntry",
      "scriptName": "AddProbabilityEntry",
      "category": "probability-tables",
      "list-name": "Add probability entry",
      "display-text": "Add entry [b]{0}[/b] with weight [b]{1}[/b]",
      "description": "Add an entry to the current probability table",
      "params": {
        "value": {
          "type": "any",
          "name": "Value",
          "desc": "The value of the entry"
        },
        "weight": {
          "type": "number",
          "name": "Entry weight",
          "desc": "The weight for the probability of the value"
        }
      }
    },
    {
      "id": "removeProbabilityEntry",
      "scriptName": "RemoveProbabilityEntry",
      "category": "probability-tables",
      "list-name": "Remove probability entry",
      "display-text": "Remove entry [b]{0}[/b] with weight [b]{1}[/b]",
      "description": "Remove an entry from the current probability table that matches a given weight and value",
      "params": {
        "value": {
          "type": "any",
          "name": "Value",
          "desc": "The value of the entry"
        },
        "weight": {
          "type": "number",
          "name": "Entry weight",
          "desc": "The weight for the probability of the value, specifying 0 matches any weight"
        }
      }
    },
    {
      "id": "setProbabilityTable",
      "scriptName": "SetProbabilityTable",
      "category": "probability-tables",
      "list-name": "Set probability table",
      "display-text": "Set current probability table to [b]{0}[/b]",
      "description": "Sets current probability table",
      "params": {
        "name": {
          "type": "string",
          "name": "Name",
          "desc": "The name of the probability table"
        }
      }
    },
    {
      "id": "seed",
      "scriptName": "SetSeed",
      "category": "advancedrandom",
      "list-name": "Update seed",
      "display-text": "Update seed to [b]{0}[/b]",
      "description": "Updates the random number generator seed",
      "params": {
        "seed": {
          "type": "string",
          "name": "Seed",
          "desc": "The new seed for the random number generator"
        }
      }
    },
    {
      "id": "octaves",
      "scriptName": "SetOctaves",
      "category": "advancedrandom",
      "list-name": "Set octaves",
      "display-text": "Set octaves to [b]{0}[/b]",
      "description": "Updates the number of octaves used by coherent noise",
      "params": {
        "count": {
          "type": "number",
          "name": "Count",
          "desc": "The number of octaves to use, from 1-16."
        }
      }
    }
