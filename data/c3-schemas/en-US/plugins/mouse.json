        "direction": {
          "type": "combo",
          "name": "Direction",
          "desc": "Select which direction to detect the mouse wheel scrolling.",
          "items": {
            "down": "down",
            "up": "up",
            "any": "any"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-pointer-locked",
      "scriptName": "OnPointerLocked",
      "category": "pointer-lock",
      "list-name": "On pointer locked",
      "display-text": "On pointer locked",
      "description": "Triggered after 'Request pointer lock' if the pointer was successfully locked.",
      "isTrigger": true
    },
    {
      "id": "on-pointer-unlocked",
      "scriptName": "OnPointerUnlocked",
      "category": "pointer-lock",
      "list-name": "On pointer unlocked",
      "display-text": "On pointer unlocked",
      "description": "Triggered after 'On pointer locked' when the pointer is unlocked.",
      "isTrigger": true
    },
    {
      "id": "on-pointer-lock-error",
      "scriptName": "OnPointerLockError",
      "category": "pointer-lock",
      "list-name": "On pointer lock error",
      "display-text": "On pointer lock error",
      "description": "Triggered if an error occurs with pointer lock.",
      "isTrigger": true
    },
    {
      "id": "has-pointer-lock",
      "scriptName": "HasPointerLock",
      "category": "pointer-lock",
      "list-name": "Has pointer lock",
      "display-text": "Has pointer lock",
      "description": "True if the pointer is currently locked."
    },
    {
      "id": "on-movement",
      "scriptName": "OnMovement",
      "category": "pointer-lock",
      "list-name": "On movement",
      "display-text": "On movement",
      "description": "Triggered every time the mouse moves. Note this also works without pointer lock.",
      "isTrigger": true
    }
