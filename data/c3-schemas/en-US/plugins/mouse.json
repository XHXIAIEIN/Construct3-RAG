        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check for mouse over."
        }
      }
    },
    {
      "id": "on-mouse-wheel",
      "scriptName": "OnWheel",
      "category": "mouse",
      "list-name": "On mouse wheel",
