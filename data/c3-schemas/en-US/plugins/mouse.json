        "mouse-button": {
          "type": "combo",
          "name": "Mouse button",
          "desc": "Select the mouse button to check.",
          "items": {
            "left": "Left",
            "middle": "Middle",
            "right": "Right",
            "button-4": "Button 4",
            "button-5": "Button 5"
          }
        },
        "click-type": {
          "type": "combo",
          "name": "Click type",
          "desc": "Select which kind of click to check for.",
          "items": {
            "clicked": "Clicked",
            "double-clicked": "Double-clicked"
          }
        },
        "object-clicked": {
          "type": "object",
          "name": "Object clicked",
          "desc": "Choose the object to check for a click on."
        }
      },
      "isTrigger": true
    },
    {
      "id": "cursor-is-over-object",
      "scriptName": "IsOverObject",
      "category": "mouse",
      "list-name": "Cursor is over object",
      "display-text": "Cursor is over {0}",
