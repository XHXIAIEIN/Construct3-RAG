  "aceCategories": {
    "cursor": "Cursor",
    "mouse": "Mouse",
    "pointer-lock": "Pointer lock",
    "wheel": "Wheel"
  },
  "conditions": [
    {
      "id": "on-click",
      "scriptName": "OnClick",
      "category": "mouse",
      "list-name": "On click",
      "display-text": "On [b]{0}[/b] button [b]{1}[/b]",
      "description": "Triggered when a mouse button clicked or double-clicked.",
      "params": {
        "mouse-button": {
          "type": "combo",
          "name": "Mouse button",
          "desc": "Select the mouse button to check.",
          "items": {
            "left": "Left",
            "middle": "Middle",
            "right": "Right",
            "button-4": "Button 4",
            "button-5": "Button 5"
          }
        },
        "click-type": {
          "type": "combo",
          "name": "Click type",
          "desc": "Select which kind of click to check for.",
          "items": {
            "clicked": "Clicked",
            "double-clicked": "Double-clicked"
          }
        }
      },
      "isTrigger": true
    },
    {
