  "actions": [
    {
      "id": "set-cursor-style2",
      "scriptName": "SetCursor2",
      "category": "mouse",
      "list-name": "Set cursor style",
      "display-text": "Set cursor to [b]{0}[/b]",
      "description": "Change the style of the mouse cursor.",
      "params": {
        "cursor-style": {
          "type": "combo-grouped",
          "name": "Cursor style",
          "desc": "Choose the cursor style to set."
        }
      }
    },
    {
      "id": "set-cursor-from-sprite",
      "scriptName": "SetCursorSprite",
      "category": "mouse",
      "list-name": "Set cursor from sprite",
      "display-text": "Set cursor from sprite {0}",
      "description": "Set the mouse cursor to the same image used by a Sprite.",
      "params": {
        "sprite": {
          "type": "object",
          "name": "Sprite",
          "desc": "Choose a Sprite object to use as the cursor image."
        }
      }
    },
    {
      "id": "request-pointer-lock",
      "scriptName": "RequestPointerLock",
      "category": "pointer-lock",
      "list-name": "Request pointer lock",
      "display-text": "Request pointer lock (unadjusted movement: [i]{0}[/i])",
      "description": "Request to lock the mouse pointer in order to use it for camera control. Usually this only works in a user input trigger.",
      "params": {
        "unadjusted-movement": {
          "type": "boolean",
          "name": "Unadjusted movement",
          "desc": "Check to disable the system-level adjustment for mouse acceleration, and access raw mouse input instead."
        }
      }
    },
    {
      "id": "release-pointer-lock",
      "scriptName": "ReleasePointerLock",
      "category": "pointer-lock",
      "list-name": "Release pointer lock",
      "display-text": "Release pointer lock",
      "description": "Release any active pointer lock, restoring normal mouse pointer behavior."
    }
