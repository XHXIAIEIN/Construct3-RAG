        "url": {
          "type": "string",
          "name": "URL",
          "desc": "URL to load CSS from. This can be a project file URL, e.g. \"mystyle.css\"."
        }
      }
    },
    {
      "id": "set-document-css-style",
      "scriptName": "SetDocumentCSSStyle",
      "category": "document",
      "list-name": "Set CSS style",
      "display-text": "Set CSS style [b]{0}[/b] to [i]{1}[/i] for [i]{2}[/i] ([i]{3}[/i])",
      "description": "Set a CSS style on elements in the document matching a CSS selector.",
      "params": {
        "property-name": {
          "type": "string",
          "name": "Property name",
          "desc": "A CSS property name to set on the HTML element."
        },
        "value": {
          "type": "string",
          "name": "Value",
          "desc": "A string to assign as the value for this CSS property."
        },
        "selector": {
          "type": "string",
          "name": "Selector",
          "desc": "A CSS selector which will be used to match elements."
        },
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "Whether to affect one element matching the selector, or all matching elements.",
          "items": {
            "one": "one",
            "all": "all"
          }
        }
      },
      "isAsync": true
    },
    {
      "id": "get-document-css-style",
      "scriptName": "GetDocumentCSSStyle",
      "category": "document",
      "list-name": "Get CSS style",
      "display-text": "Get CSS style [b]{0}[/b] from [i]{1}[/i] (tag [i]{2}[/i])",
      "description": "Get the computed value of a CSS property from an element in the document.",
      "params": {
        "property-name": {
          "type": "string",
          "name": "Property name",
          "desc": "The CSS property name to get."
        },
        "selector": {
          "type": "string",
          "name": "Selector",
          "desc": "A CSS selector which will be used to match the element."
        },
        "tag": {
          "type": "string",
          "name": "Tag",
          "desc": "A tag to later retrieve this value with."
        }
      },
      "isAsync": true
    },
    {
      "id": "go-back",
