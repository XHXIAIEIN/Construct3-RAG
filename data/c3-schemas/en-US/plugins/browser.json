        "mime-type": {
          "type": "string",
          "name": "MIME type",
          "desc": "The MIME type of the given data."
        },
        "filename": {
          "type": "string",
          "name": "Filename",
          "desc": "The filename to give the downloaded file."
        }
      }
    },
