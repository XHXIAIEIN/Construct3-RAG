{
  "id": "touch",
  "name": "Touch",
  "description": "Receive input from touchscreen devices, and access device orientation and motion.",
  "type": "plugin",
  "aceCategories": {
    "gestures": "Gestures",
    "orientation-motion": "Orientation & motion",
    "touch": "Touch"
  },
  "conditions": [
    {
      "id": "on-hold",
      "scriptName": "OnHoldGesture",
      "category": "gestures",
      "list-name": "On hold",
      "display-text": "On hold gesture",
      "description": "Triggered when a touch held in the same place for a time.",
      "isTrigger": true
    },
    {
      "id": "on-tap",
      "scriptName": "OnTapGesture",
      "category": "gestures",
      "list-name": "On tap",
      "display-text": "On tap gesture",
      "description": "Triggered when a touch is quickly released from its start location.",
      "isTrigger": true
    },
    {
      "id": "on-double-tap",
      "scriptName": "OnDoubleTapGesture",
      "category": "gestures",
      "list-name": "On double-tap",
      "display-text": "On double-tap gesture",
      "description": "Triggered when two taps occur in quick succession.",
      "isTrigger": true
    },
    {
      "id": "on-hold-over-object",
      "scriptName": "OnHoldGestureObject",
      "category": "gestures",
      "list-name": "On hold over object",
      "display-text": "On hold gesture over {0}",
      "description": "Triggered when a hold gesture is made over an object.",
      "params": {
        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-tap-object",
      "scriptName": "OnTapGestureObject",
      "category": "gestures",
      "list-name": "On tap object",
      "display-text": "On tap gesture on {0}",
      "description": "Triggered when a tap gesture is made on an object.",
      "params": {
        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-double-tap-object",
      "scriptName": "OnDoubleTapGestureObject",
      "category": "gestures",
      "list-name": "On double-tap object",
      "display-text": "On double-tap gesture on {0}",
      "description": "Triggered when a double-tap gesture is made on an object.",
      "params": {
        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check."
        }
      },
      "isTrigger": true
    },
    {
      "id": "compare-orientation",
      "scriptName": "CompareOrientation",
      "category": "orientation-motion",
      "list-name": "Compare orientation",
      "display-text": "[b]{0}[/b] orientation {1} [b]{2}[/b]",
      "description": "Compare the current orientation (or tilt) of the device.",
      "params": {
        "orientation": {
          "type": "combo",
          "name": "Orientation",
          "desc": "Choose the orientation to compare (alpha = compass direction, beta = front-to-back tilt, gamma = left-to-right tilt).",
          "items": {
            "alpha": "Alpha",
            "beta": "Beta",
            "gamma": "Gamma"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "How to compare the orientation."
        },
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "The orientation to compare to, in degrees."
        }
      }
    },
    {
      "id": "compare-acceleration",
      "scriptName": "CompareAcceleration",
      "category": "orientation-motion",
      "list-name": "Compare acceleration",
      "display-text": "{0} acceleration {1} [b]{2}[/b]",
      "description": "Compare the acceleration of the device along an axis.",
      "params": {
        "axis": {
          "type": "combo",
          "name": "Axis",
          "desc": "Choose the axis to compare acceleration for, and whether the measurement should include the force of gravity.",
          "items": {
            "x-with-gravity": "X (with gravity)",
            "y-with-gravity": "Y (with gravity)",
            "z-with-gravity": "Z (with gravity)",
            "x-without-gravity": "X (without gravity)",
            "y-without-gravity": "Y (without gravity)",
            "z-without-gravity": "Z (without gravity)"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "How to compare the acceleration."
        },
        "acceleration": {
          "type": "number",
          "name": "Acceleration",
          "desc": "The acceleration to compare to, in m/s^2."
        }
      }
    },
    {
      "id": "on-permission-granted",
      "scriptName": "OnPermissionGranted",
      "category": "orientation-motion",
      "list-name": "On permission granted",
      "display-text": "On [i]{0}[/i] permission granted",
      "description": "Triggered after the 'Request permission' action if the permission was granted.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The type of permission.",
          "items": {
            "orientation": "Orientation",
            "motion": "Motion"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-permission-denied",
      "scriptName": "OnPermissionDenied",
      "category": "orientation-motion",
      "list-name": "On permission denied",
      "display-text": "On [i]{0}[/i] permission denied",
      "description": "Triggered after the 'Request permission' action if the permission was denied.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The type of permission.",
          "items": {
            "orientation": "Orientation",
            "motion": "Motion"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-touch-start",
      "scriptName": "OnTouchStart",
      "category": "touch",
      "list-name": "On any touch start",
      "display-text": "On any touch start",
      "description": "Triggered when any touch input begins.",
      "isTrigger": true
    },
    {
      "id": "on-any-touch-end",
      "scriptName": "OnTouchEnd",
      "category": "touch",
      "list-name": "On any touch end",
      "display-text": "On any touch end",
      "description": "Triggered when any touch input ends.",
      "isTrigger": true
    },
    {
      "id": "is-in-touch",
      "scriptName": "IsInTouch",
      "category": "touch",
      "list-name": "Is in touch",
      "display-text": "Is in touch",
      "description": "True if any touch is currently in contact with the device."
    },
    {
      "id": "on-touched-object",
      "scriptName": "OnTouchObject",
      "category": "touch",
      "list-name": "On touched object",
      "display-text": "On touched {0} ([i]{1}[/i])",
      "description": "Triggered when an object is touched.",
      "params": {
        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check for touch."
        },
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "Whether to trigger when starting or ending a touch on the object.",
          "items": {
            "start": "start",
            "end": "end"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "is-touching-object",
      "scriptName": "IsTouchingObject",
      "category": "touch",
      "list-name": "Is touching object",
      "display-text": "Is touching {0}",
      "description": "Test if in a touch and the touch point is over an object.",
      "params": {
        "object": {
          "type": "object",
          "name": "Object",
          "desc": "Choose the object to check for being touched."
        }
      }
    },
    {
      "id": "compare-touch-speed",
      "scriptName": "CompareTouchSpeed",
      "category": "touch",
      "list-name": "Compare touch speed",
      "display-text": "Touch [b]{0}[/b] speed {1} [b]{2}[/b]",
      "description": "Compare the speed of a touch, e.g. to detect a swipe.",
      "params": {
        "touch-index": {
          "type": "number",
          "name": "Touch index",
          "desc": "The zero-based index of the touch to test the speed for.  0 is the first touch."
        },
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "How to compare the touch speed."
        },
        "speed": {
          "type": "number",
          "name": "Speed",
          "desc": "Speed to compare to, in absolute pixels per second."
        }
      }
    },
    {
      "id": "on-nth-touch-start",
      "scriptName": "OnNthTouchStart",
      "category": "touch",
      "list-name": "On Nth touch start",
      "display-text": "On touch {0} start",
      "description": "Triggered when a particular touch input begins.",
      "params": {
        "touch-number": {
          "type": "number",
          "name": "Touch number",
          "desc": "Enter a zero-based index of the touch to test, e.g. 0 for first touch, 1 for second, etc."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-nth-touch-end",
      "scriptName": "OnNthTouchEnd",
      "category": "touch",
      "list-name": "On Nth touch end",
      "display-text": "On touch {0} end",
      "description": "Triggered when a particular touch input ends.",
      "params": {
        "touch-number": {
          "type": "number",
          "name": "Touch number",
          "desc": "Enter a zero-based index of the touch to test, e.g. 0 for first touch, 1 for second, etc."
        }
      },
      "isTrigger": true
    },
    {
      "id": "has-nth-touch",
      "scriptName": "HasNthTouch",
      "category": "touch",
      "list-name": "Has Nth touch",
      "display-text": "Has touch {0}",
      "description": "True if a particular touch is currently in contact with the device.",
      "params": {
        "touch-number": {
          "type": "number",
          "name": "Touch number",
          "desc": "Enter a zero-based index of the touch to test, e.g. 0 for first touch, 1 for second, etc."
        }
      }
    }
  ],
  "actions": [
    {
      "id": "request-permission",
      "scriptName": "RequestPermission",
      "category": "orientation-motion",
      "list-name": "Request permission",
      "display-text": "Request [b]{0}[/b] permission",
      "description": "Request permission to use device orientation or motion.",
      "params": {
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "The type of permission.",
          "items": {
            "orientation": "Orientation",
            "motion": "Motion"
          }
        }
      }
    }
  ],
  "expressions": [
