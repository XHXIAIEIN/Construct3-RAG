  "actions": [
    {
      "id": "list-achievements",
      "scriptName": "RequestAchievements",
      "category": "achievements",
      "list-name": "List achievements",
      "display-text": "Request list of {0} achievements. Force reload: {1}",
      "description": "Request a list of achievements for the current player.",
      "params": {
        "which": {
          "type": "combo",
          "name": "Which",
          "desc": "Which achievements to request a list of.",
          "items": {
            "all": "all",
            "hidden": "hidden",
            "revealed": "revealed",
            "unlocked": "unlocked"
          }
        },
        "reload": {
          "type": "boolean",
          "name": "Force reload",
          "desc": "Ensure that the results are up to date, and not from the cache."
        }
      },
      "isAsync": true
    },
    {
      "id": "get-metadata",
      "scriptName": "RequestAchievementMetadata",
      "category": "achievements",
      "list-name": "Get metadata",
      "display-text": "Request achievements metadata. Force reload: {0}",
      "description": "Request achievements metadata (name, description etc.) allowing the corresponding expressions to return the correct values.",
      "params": {
        "reload": {
          "type": "boolean",
          "name": "Force reload",
          "desc": "Ensure that the results are up to date, and not from the cache."
        }
      },
      "isAsync": true
    },
    {
      "id": "reveal",
      "scriptName": "RevealAchievement",
      "category": "achievements",
      "list-name": "Reveal",
      "display-text": "Reveal achievement [b]{0}[/b]",
      "description": "Reveal a hidden achievement.",
      "params": {
        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "Achievement ID to reveal."
        }
      },
      "isAsync": true
    },
    {
      "id": "unlock",
      "scriptName": "UnlockAchievement",
      "category": "achievements",
      "list-name": "Unlock",
      "display-text": "Unlock achievement [b]{0}[/b]",
      "description": "Unlock an achievement.",
      "params": {
        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "Achievement ID to unlock."
        }
      },
      "isAsync": true
    },
    {
      "id": "increment",
      "scriptName": "IncrementAchievement",
      "category": "achievements",
      "list-name": "Increment",
      "display-text": "Increment achievement [b]{0}[/b] by [i]{1}[/i] steps",
      "description": "Add steps to an incremental achievement.",
      "params": {
        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "Achievement ID to increment."
        },
        "steps": {
          "type": "number",
          "name": "Steps",
          "desc": "Number of steps to increment the achievement by."
        }
      },
      "isAsync": true
    },
    {
      "id": "set-steps",
      "scriptName": "SetStepsAchievement",
      "category": "achievements",
      "list-name": "Set steps",
      "display-text": "Set achievement [b]{0}[/b] steps to [i]{1}[/i]",
      "description": "Set the steps progress of an incremental achievement.",
      "params": {
        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "Achievement ID to increment."
        },
        "steps": {
          "type": "number",
          "name": "Steps",
          "desc": "Number of steps to set the achievement progress to. The steps cannot be reduced."
        }
      },
      "isAsync": true
    },
    {
      "id": "show-achievements",
      "scriptName": "ShowAchievements",
      "category": "achievements",
      "list-name": "Show native achievements dialog",
      "display-text": "Display achievements",
      "description": "Display the native google play games dialog for all achievements (only works in Android app).",
      "isAsync": true
    },
    {
      "id": "request-player-details",
      "scriptName": "RequestPlayerDetails",
      "category": "google-play-game-services",
      "list-name": "Request player details",
      "display-text": "Request player details",
      "description": "If signed in, request the details of the signed in player.",
      "isAsync": true
    },
    {
      "id": "sign-in",
      "scriptName": "SignIn",
      "category": "google-play-game-services",
      "list-name": "Sign in",
      "display-text": "Sign in",
      "description": "Request the player to sign in."
    },
    {
      "id": "sign-out",
      "scriptName": "SignOut",
      "category": "google-play-game-services",
      "list-name": "Sign out",
      "display-text": "Sign out",
      "description": "Sign out if already signed in. NOTE: not supported in Android apps."
    },
    {
      "id": "submit-score",
      "scriptName": "SubmitScore",
      "category": "leaderboards",
      "list-name": "Submit score",
      "display-text": "Submit score [b]{1}[/b] (tag [i]{2}[/i]) to leaderboard [i]{0}[/i]",
      "description": "Submit a score to a leaderboard.",
      "params": {
        "leaderboard-id": {
          "type": "string",
          "name": "Leaderboard ID",
          "desc": "Leaderboard ID to submit the score to."
        },
        "score": {
          "type": "number",
          "name": "Score",
          "desc": "The score to submit to the leaderboard."
        },
        "tag": {
          "type": "string",
          "name": "Tag",
          "desc": "Up to 64 extra characters to submit along with this score."
        }
      },
      "isAsync": true
    },
    {
      "id": "request-hi-scores",
      "scriptName": "RequestHiScores",
      "category": "leaderboards",
      "list-name": "Request hi-scores",
      "display-text": "Request {1} {2} hi-scores from [b]{0}[/b] ([i]{3}[/i] results, [i]{4}[/i]). Force reload: {5}",
      "description": "Request a list of scores from a leaderboard.",
      "params": {
        "leaderboard-id": {
          "type": "string",
          "name": "Leaderboard ID",
          "desc": "Leaderboard ID to request scores from."
        },
        "collection": {
          "type": "combo",
          "name": "Collection",
          "desc": "Whether to return all scores, or scores relating to the current player.",
          "items": {
            "public": "public",
            "social": "social"
          }
        },
        "time-span": {
          "type": "combo",
          "name": "Time span",
          "desc": "Return the top scores in the given time span.",
          "items": {
            "all-time": "all-time",
            "weekly": "weekly",
            "daily": "daily"
          }
        },
        "results": {
          "type": "number",
          "name": "Results",
          "desc": "The number of score results to return, from 1 to 25."
        },
        "type": {
          "type": "combo",
          "name": "Type",
          "desc": "Return the top scores, or a window of the scores around the current player's best score.",
          "items": {
            "top": "top",
            "window": "window"
          }
        },
        "reload": {
          "type": "boolean",
          "name": "Force reload",
          "desc": "Ensure that the results are up to date, and not from the cache."
        }
      },
      "isAsync": true
    },
    {
      "id": "show-leaderboard",
      "scriptName": "ShowLeaderboard",
      "category": "leaderboards",
      "list-name": "Show native leaderboard dialog",
      "display-text": "Display leaderboard {0}",
      "description": "Display the native google play games dialog for a specific leaderboard (only works in Android app).",
      "params": {
        "leaderboard-id": {
          "type": "string",
          "name": "Leaderboard ID",
          "desc": "Leaderboard ID to display."
        }
      },
      "isAsync": true
    },
    {
      "id": "show-leaderboards",
      "scriptName": "ShowLeaderboards",
      "category": "leaderboards",
      "list-name": "Show native leaderboards dialog",
      "display-text": "Display leaderboards",
      "description": "Display the native google play games dialog for all leaderboards (only works in Android app).",
      "isAsync": true
    }
