        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "ID of the achievement that was revealed."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-achievement-unlocked",
      "scriptName": "OnAchievementUnlocked",
      "category": "achievements",
      "list-name": "On achievement unlocked",
      "display-text": "On achievement [b]{0}[/b] unlocked",
      "description": "Triggered after 'Unlock' or when an incremental achievement's steps have been fulfilled.",
      "params": {
        "achievement-id": {
          "type": "string",
          "name": "Achievement ID",
          "desc": "ID of the achievement that was unlocked."
        }
      },
      "isTrigger": true
    },
    {
      "id": "is-loaded",
      "scriptName": "IsLoaded",
