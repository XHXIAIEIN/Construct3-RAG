{
  "id": "internationalization",
  "name": "Internationalization",
  "description": "Manage strings to translate an application into different languages.",
  "type": "plugin",
  "aceCategories": {
    "internationalization": "Internationalization"
  },
  "conditions": [
    {
      "id": "compare-current-locale",
      "scriptName": "CompareCurrentLocale",
      "category": "internationalization",
      "list-name": "Compare to current locale",
      "display-text": "current locale {0} {1}",
      "description": "Compare a locale string against the locale string of the internationalization object.",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "Select the way to compare the locale strings."
        },
        "locale": {
          "type": "string",
          "name": "Locale",
          "desc": "The locale string to compare against the locale string of the internationalization object"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-locale",
      "scriptName": "SetLocale",
      "category": "internationalization",
      "list-name": "Set locale",
      "display-text": "Set locale [b]{0}[/b]",
      "description": "Sets the locale of the internationalization object.",
      "params": {
        "locale": {
          "type": "string",
          "name": "Locale",
          "desc": "The locale to use."
        }
      }
    },
    {
      "id": "set-context",
      "scriptName": "SetContext",
      "category": "internationalization",
      "list-name": "Set context",
      "display-text": "Set context [b]{0}[/b]",
      "description": "Sets the current context of the internationalization object.",
      "params": {
        "context": {
          "type": "string",
          "name": "Context",
          "desc": "The new current context, can be absolute or relative."
        }
      }
    },
    {
      "id": "push-context",
      "scriptName": "PushContext",
      "category": "internationalization",
      "list-name": "Push context",
      "display-text": "Push context [b]{0}[/b]",
      "description": "Pushes a new context into the internationalization object stack.",
      "params": {
        "context": {
          "type": "string",
          "name": "Context",
          "desc": "The new context to push, can be absolute or relative."
        }
      }
    },
    {
      "id": "pop-context",
      "scriptName": "PopContext",
      "category": "internationalization",
      "list-name": "Pop context",
      "display-text": "Pop context",
      "description": "Pops the last element of the internationalization's object stack"
    },
    {
      "id": "add-string",
      "scriptName": "AddString",
      "category": "internationalization",
      "list-name": "Add string",
      "display-text": "Add string [b]{1}[/b] to context [b]{0}[/b]",
      "description": "Adds a new string for the given context.",
      "params": {
        "context": {
          "type": "string",
          "name": "Context",
          "desc": "The context where the new string will be added, can be absolute or relative."
        },
        "string": {
          "type": "string",
          "name": "String",
          "desc": "The string that will be added to the internationalization object."
        }
      }
    },
    {
      "id": "load-from-json",
      "scriptName": "LoadFromJSON",
      "category": "internationalization",
      "list-name": "Load from JSON",
      "display-text": "Load from JSON [b]{0}[/b]",
      "description": "Loads translation data from a JSON string.",
      "params": {
        "json": {
          "type": "string",
          "name": "JSON string",
          "desc": "JSON string with translation data"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "look-up",
      "scriptName": "Lookup",
      "category": "internationalization",
      "translated-name": "Lookup",
      "description": "Get the internationalized string at the current context.",
      "params": {
        "context": {
          "type": "string",
          "name": "Context",
          "desc": "Location within the internationalization object"
        }
      },
      "returnType": "string"
    },
    {
      "id": "look-up-plural",
      "scriptName": "LookupPlural",
      "category": "internationalization",
      "translated-name": "LookupPlural",
      "description": "Get the internationalized string at the current context using the defined pluralization rules.",
      "params": {
        "context": {
          "type": "string",
          "name": "Context",
          "desc": "Location within the internationalization object"
        },
        "count": {
          "type": "number",
          "name": "Count",
          "desc": "The value used to get the plural form"
        }
      },
      "returnType": "string"
    },
    {
      "id": "current-context",
      "scriptName": "CurrentContext",
      "category": "internationalization",
      "translated-name": "CurrentContext",
      "description": "Get the current context of the internationalization object.",
      "returnType": "string"
    },
    {
      "id": "select-plural",
      "scriptName": "SelectPlural",
      "category": "internationalization",
      "translated-name": "SelectPlural",
      "description": "Get the plural category for the provided number.",
      "params": {
        "plural-number": {
          "type": "number",
          "name": "PluralNumber",
          "desc": "Number to get a plural category for"
        }
      },
      "returnType": "string"
    },
    {
      "id": "plural-categorie-count",
      "scriptName": "PluralCategoryCount",
      "category": "internationalization",
      "translated-name": "PluralCategoryCount",
      "description": "Get amount of plural categories for the current locale.",
      "returnType": "number"
    },
    {
      "id": "plural-category-at",
      "scriptName": "PluralCategoryAt",
      "category": "internationalization",
      "translated-name": "PluralCategoryAt",
      "description": "Get the plural category for the given index.",
      "params": {
        "category-index": {
          "type": "number",
          "name": "CategoryIndex",
          "desc": "Index of the plural category"
        }
      },
      "returnType": "string"
    },
    {
      "id": "save-to-json",
      "scriptName": "SaveToJSON",
      "category": "internationalization",
      "translated-name": "SaveToJSON",
      "description": "Get the translation strings for the current locale in JSON format.",
      "returnType": "string"
    },
    {
      "id": "locale",
      "scriptName": "Locale",
      "category": "internationalization",
      "translated-name": "Locale",
      "description": "Get the current locale of the internationalization object.",
      "returnType": "string"
    },
    {
      "id": "default-locale",
      "scriptName": "DefaultLocale",
      "category": "internationalization",
      "translated-name": "DefaultLocale",
      "description": "Get the default system locale.",
      "returnType": "string"
    },
    {
      "id": "format-number-as-decimal",
      "scriptName": "FormatNumberAsDecimal",
      "category": "internationalization",
      "translated-name": "FormatNumberAsDecimal",
      "description": "Format a number as a decimal using the current locale.",
      "params": {
        "number": {
          "type": "number",
          "name": "Number",
          "desc": "The number to format"
        }
      },
      "returnType": "string"
    },
    {
      "id": "format-number-as-percent",
      "scriptName": "FormatNumberAsPercent",
      "category": "internationalization",
      "translated-name": "FormatNumberAsPercent",
      "description": "Format a number as a percentage using the current locale.",
      "params": {
        "number": {
          "type": "number",
          "name": "Number",
          "desc": "The number to format"
        }
      },
      "returnType": "string"
    },
    {
      "id": "format-number-as-currency",
      "scriptName": "FormatNumberAsCurrency",
      "category": "internationalization",
      "translated-name": "FormatNumberAsCurrency",
      "description": "Format a number as a currency using the current locale.",
      "params": {
        "number": {
          "type": "number",
          "name": "Number",
          "desc": "The number to format"
        },
        "currency": {
          "type": "string",
          "name": "Currency",
          "desc": "The currency code"
        },
        "currency-display": {
          "type": "string",
          "name": "CurrencyDisplay",
          "desc": "The currency display format. Can be any of 'symbol', 'narrowSymbol', 'code' or 'name'. Defaults to 'symbol'"
        }
      },
      "returnType": "string"
    },
    {
      "id": "format-number-with-unit",
      "scriptName": "FormatNumberWithUnit",
      "category": "internationalization",
      "translated-name": "FormatNumberWithUnit",
      "description": "Format a number using a specific unit and the current locale.",
      "params": {
        "number": {
          "type": "number",
          "name": "Number",
          "desc": "The number to format"
        },
        "unit": {
          "type": "string",
          "name": "Unit",
          "desc": "The unit to use for formatting"
        },
        "unit-display": {
          "type": "string",
          "name": "UnitDisplay",
          "desc": "The unit display format. Can be any of 'long', 'short' or 'narrow'. Defaults to 'short'"
        }
      },
      "returnType": "string"
    },
    {
      "id": "region-name",
      "scriptName": "RegionName",
      "category": "internationalization",
      "translated-name": "RegionName",
      "description": "Get the localized name of the provided locale's region",
      "params": {
        "locale": {
          "type": "string",
          "name": "RegionLocale",
          "desc": "The region code to the get a localized name for"
        }
      },
      "returnType": "string"
    },
    {
      "id": "language-name",
      "scriptName": "LanguageName",
      "category": "internationalization",
      "translated-name": "LanguageName",
      "description": "Get the localized name of a language according to the current locale",
      "params": {
        "language": {
          "type": "string",
          "name": "LanguageLocale",
          "desc": "The locale to the get a localized language name for"
        }
      },
      "returnType": "string"
    },
    {
      "id": "currency-name",
      "scriptName": "CurrencyName",
      "category": "internationalization",
      "translated-name": "CurrencyName",
      "description": "Get the localized name of a currency according to the current locale",
      "params": {
        "currency": {
          "type": "string",
          "name": "CurrencyCode",
          "desc": "The currency code to the get a localized currency name for"
        }
      },
      "returnType": "string"
    }
  ],
  "properties": {}
}