    {
      "id": "sign-in-with-provider",
      "scriptName": "SignInWithProvider",
      "category": "authentication",
      "list-name": "Sign in with provider",
      "display-text": "Sign in with [b]{0}[/b] (allow persisting [i]{1}[/i], expiry [i]{2}[/i] minutes, popup window [i]{3}[/i] x [i]{4}[/i])",
      "description": "Sign in with a third-party identity service.",
      "params": {
        "provider": {
          "type": "combo",
          "name": "Provider",
          "desc": "The third-party service to sign in with.",
          "items": {
            "apple": "Apple",
            "battle-net": "Battle.net",
            "discord": "Discord",
            "facebook": "Facebook",
            "github": "GitHub",
            "google": "Google",
            "itch-io": "itch.io",
            "microsoft": "Microsoft",
            "patreon": "Patreon",
            "reddit": "Reddit",
            "steam": "Steam",
            "twitch": "Twitch",
            "x": "X",
            "yandex": "Yandex"
          }
        },
        "allow-persisting": {
          "type": "boolean",
          "name": "Allow persisting",
          "desc": "Allow re-using this sign in session later on."
        },
        "expiry": {
          "type": "number",
          "name": "Expiry",
          "desc": "The time in minutes for sessions to remain valid. The default is 24 hours (1440 minutes)."
        },
        "popup-window-width": {
          "type": "number",
          "name": "Popup window width",
          "desc": "The width of the authentication popup window."
        },
        "popup-window-height": {
          "type": "number",
          "name": "Popup window height",
          "desc": "The height of the authentication popup window."
        }
