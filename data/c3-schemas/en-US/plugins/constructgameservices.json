    {
      "id": "submit-score",
      "scriptName": "SubmitScore",
      "category": "leaderboards",
      "list-name": "Submit score",
      "display-text": "Submit score [b]{0}[/b] to leaderboard [i]{1}[/i]",
      "description": "Submit a score to a leaderboard.",
      "params": {
        "score": {
          "type": "number",
          "name": "Score",
          "desc": "The score to submit. Must be an integer."
        },
        "leaderboard-id": {
          "type": "string",
          "name": "Leaderboard ID",
          "desc": "The ID of the leaderboard to modify. Leave empty for the Construct Arcade."
        }
      },
      "isAsync": true
    },
    {
      "id": "get-leaderboard-scores",
      "scriptName": "GetLeaderboardScores",
      "category": "leaderboards",
      "list-name": "Get leaderboard scores",
      "display-text": "Get leaderboard [b]{0}[/b] scores (results per page [i]{1}[/i], page [i]{2}[/i], country [i]{3}[/i], range [i]{4}[/i], range offset [i]{5}[/i], culture [i]{6}[/i])",
      "description": "Retrieve a list of scores from a leaderboard.",
      "params": {
        "leaderboard-id": {
          "type": "string",
          "name": "Leaderboard ID",
          "desc": "The ID of the leaderboard to retrieve scores from."
        },
        "results-per-page": {
          "type": "number",
          "name": "Results per page",
          "desc": "The number of results to retrieve, from 1 to 500."
        },
        "page": {
          "type": "number",
          "name": "Page",
          "desc": "The zero-based index of the page number to retrieve."
        },
        "country": {
          "type": "string",
          "name": "Country",
          "desc": "The ISO 3166-1 alpha-2 country code to filter results by. Leave empty to show all counties."
        },
        "range": {
          "type": "combo",
          "name": "Range",
          "desc": "Filter results according to a time period.",
          "items": {
            "all": "All",
            "daily": "Daily",
            "weekly": "Weekly",
            "monthly": "Monthly",
            "yearly": "Yearly"
          }
        },
        "range-offset": {
          "type": "number",
          "name": "Range offset",
          "desc": "When filtering to a time period, the offset of the time period. For example a daily time period with an offset of 1 retrieves yesterday's scores."
        },
        "culture": {
          "type": "string",
          "name": "Culture",
          "desc": "The locale to use for returned values. Leave empty to use the leaderboard's default culture."
        }
      },
      "isAsync": true
    },
