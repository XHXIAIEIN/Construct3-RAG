  "actions": [
    {
      "id": "create-banner",
      "scriptName": "CreateBanner",
      "category": "banner",
      "list-name": "Create banner advert",
      "display-text": "Create banner advert [b]{0}[/b] size: [b]{1}[/b] position: [b]{3}[/b] show: [b]{2}[/b] reload: [b]{4}[/b] offset: [b]{5}[/b] overlap: [b]{6}[/b]",
      "description": "Create a banner advert with a given size and identifier",
      "params": {
        "advert-id": {
          "type": "string",
          "name": "Banner Advert Unit ID",
          "desc": "The AdMob Advert Unit ID for this advert"
        },
        "banner-size": {
          "type": "combo",
          "name": "Banner Size",
          "desc": "The display size of the advert",
          "items": {
            "portrait": "Smart portrait",
            "landscape": "Smart landscape",
            "standard": "Standard",
            "large": "Large",
            "medium": "Medium",
            "full": "Full",
            "leaderboard": "Leaderboard"
          }
        },
        "show": {
          "type": "combo",
          "name": "Show",
          "desc": "Automatically show the advert once it has loaded",
          "items": {
            "true": "true",
            "false": "false"
          }
        },
        "position": {
          "type": "combo",
          "name": "Position",
          "desc": "Position on the screen where the banner should be placed",
          "items": {
            "bottom": "bottom",
            "top": "top"
          }
        },
        "reload": {
          "type": "combo",
          "name": "Reload",
          "desc": "Reload the banner with new setting if one already exists",
          "items": {
            "true": "true",
            "false": "false"
          },
          "initialValue": "false"
        },
        "offset": {
          "type": "number",
          "name": "Offset",
          "desc": "Offset the banner by the specified amount. Ignored when 'Overlap' is 'false'"
        },
        "overlap": {
          "type": "combo",
          "name": "Overlap",
          "desc": "Should the banner overlap the main content or not",
          "items": {
            "true": "true",
            "false": "false"
          },
          "initialValue": "true"
        }
      },
      "isAsync": true
    },
