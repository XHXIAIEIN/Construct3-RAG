{
  "id": "keyboard",
  "name": "Keyboard",
  "description": "Retrieve input from the keyboard.",
  "type": "plugin",
  "aceCategories": {
    "key-codes": "Key codes",
    "keyboard": "Keyboard",
    "left-right-keys": "Left/right keys",
    "keyboard-lock": "Keyboard lock"
  },
  "conditions": [
    {
      "id": "on-key-code-pressed",
      "scriptName": "OnKeyCode",
      "category": "key-codes",
      "list-name": "On key code pressed",
      "display-text": "On key code [b]{0}[/b] pressed",
      "description": "Test for a key pressed by its numeric key code.",
      "params": {
        "keycode": {
          "type": "number",
          "name": "Keycode",
          "desc": "Choose a numeric key code to test."
        }
      },
      "isTrigger": true
    },
    {
      "id": "key-code-is-down",
      "scriptName": "IsKeyCodeDown",
      "category": "key-codes",
      "list-name": "Key code is down",
      "display-text": "Key code [b]{0}[/b] is down",
      "description": "Test if a keyboard key is currently held down by its numeric key code.",
      "params": {
        "keycode": {
          "type": "number",
          "name": "Keycode",
          "desc": "Choose a numeric key code to test."
        }
      }
    },
    {
      "id": "on-key-code-released",
      "scriptName": "OnKeyCodeReleased",
      "category": "key-codes",
      "list-name": "On key code released",
      "display-text": "On key code [b]{0}[/b] released",
      "description": "Test for a key released by its numeric key code.",
      "params": {
        "keycode": {
          "type": "number",
          "name": "Keycode",
          "desc": "Choose a numeric key code to test."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-key-pressed",
      "scriptName": "OnKey",
      "category": "keyboard",
      "list-name": "On key pressed",
      "display-text": "On [b]{0}[/b] pressed",
      "description": "Triggered when a keyboard key is pressed.",
      "params": {
        "key": {
          "type": "keyb",
          "name": "Key",
          "desc": "Choose a key.  Note that international users and users on different operating systems or devices may not have the same keys available."
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-key-pressed",
      "scriptName": "OnAnyKey",
