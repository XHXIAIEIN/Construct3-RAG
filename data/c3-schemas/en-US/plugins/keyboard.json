        "key": {
          "type": "combo",
          "name": "Key",
          "desc": "Choose a key.",
          "items": {
            "left-shift": "Left shift",
            "right-shift": "Right shift",
            "left-control": "Left control",
            "right-control": "Right control",
            "left-alt": "Left alt",
            "right-alt": "Right alt",
            "left-meta": "Left meta",
            "right-meta": "Right meta"
          }
        }
      }
