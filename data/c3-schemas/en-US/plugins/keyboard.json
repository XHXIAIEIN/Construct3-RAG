  ],
  "actions": [
    {
      "id": "lock-keyboard",
      "scriptName": "LockKeyboard",
      "category": "keyboard-lock",
      "list-name": "Lock keyboard",
      "display-text": "Lock keyboard (keys: [i]{0}[/i])",
      "description": "Request to lock the keyboard so keypresses are always received by the project rather than the browser/application. NOTE: this only takes effect in fullscreen mode.",
      "params": {
        "keys": {
          "type": "string",
          "name": "Keys",
          "desc": "A comma-separated array of keys to lock. Leave empty to request to lock all keys."
        }
      },
      "isAsync": true
    },
    {
      "id": "unlock-keyboard",
      "scriptName": "UnlockKeyboard",
      "category": "keyboard-lock",
      "list-name": "Unlock keyboard",
      "display-text": "Unlock keyboard",
      "description": "Unlock a previous keyboard lock, restoring the default handling of key presses."
    }
  ],
  "expressions": [
    {
      "id": "lastkeycode",
      "scriptName": "LastKeyCode",
      "category": "key-codes",
      "translated-name": "LastKeyCode",
      "description": "Get the key code for the last pressed key.",
      "returnType": "number"
    },
    {
      "id": "stringfromkeycode",
      "scriptName": "StringFromKeyCode",
      "category": "key-codes",
      "translated-name": "StringFromKeyCode",
      "description": "Get a character string representing a key code.",
      "params": {
        "key-code": {
          "type": "number",
          "name": "Key code",
          "desc": "The key code to get a string from"
        }
      },
      "returnType": "string"
    },
    {
      "id": "typed-key",
      "scriptName": "TypedKey",
      "category": "key-codes",
      "translated-name": "TypedKey",
      "description": "Get the typed key string for the last pressed key.",
      "returnType": "string"
    }
  ],
  "properties": {}
}