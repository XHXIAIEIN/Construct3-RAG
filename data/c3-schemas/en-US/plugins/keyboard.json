        }
      },
      "isTrigger": true
    },
    {
      "id": "is-keyboard-lock-supported",
      "scriptName": "IsKeyboardLockSupported",
      "category": "keyboard-lock",
      "list-name": "Is keyboard lock supported",
      "display-text": "Is keyboard lock supported",
      "description": "True if the current browser/platform supports using keyboard lock."
