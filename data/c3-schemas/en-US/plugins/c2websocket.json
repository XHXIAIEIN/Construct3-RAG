{
  "id": "c2websocket",
  "name": "WebSocket",
  "description": "Send and receive text messages to a WebSocket server.",
  "type": "plugin",
  "aceCategories": {
    "connection": "Connection",
    "data": "Data"
  },
  "conditions": [
    {
      "id": "on-opened",
      "scriptName": "OnOpened",
      "category": "connection",
      "list-name": "On opened",
      "display-text": "On connection opened",
      "description": "Triggered when the connection to the WebSocket server is successfully established.",
      "isTrigger": true
    },
    {
      "id": "on-closed",
      "scriptName": "OnClosed",
      "category": "connection",
      "list-name": "On closed",
      "display-text": "On connection closed",
      "description": "Triggered when an active connection is closed.",
      "isTrigger": true
    },
    {
      "id": "on-error",
      "scriptName": "OnError",
      "category": "connection",
      "list-name": "On error",
      "display-text": "On connection error",
      "description": "Triggered when there is a connection error.",
      "isTrigger": true
    },
    {
      "id": "is-open",
      "scriptName": "IsOpen",
      "category": "connection",
      "list-name": "Is open",
      "display-text": "Is connection open",
      "description": "True if the connection is currently open."
    },
    {
      "id": "is-connecting",
      "scriptName": "IsConnecting",
      "category": "connection",
      "list-name": "Is connecting",
      "display-text": "Is connecting",
      "description": "True if the connection is currently being established."
    },
    {
      "id": "is-supported",
      "scriptName": "IsSupported",
      "category": "connection",
      "list-name": "Is supported",
      "display-text": "Is WebSocket supported",
      "description": "True if the user's client supports WebSocket connections."
    },
    {
      "id": "on-message",
      "scriptName": "OnMessage",
      "category": "data",
      "list-name": "On text message",
      "display-text": "On text message",
      "description": "Triggered when a message is received from the server in text format.",
      "isTrigger": true
    },
    {
      "id": "on-binary-message",
      "scriptName": "OnBinaryMessage",
      "category": "data",
      "list-name": "On binary message",
      "display-text": "On binary message (in {0})",
      "description": "Triggered when a message is received from the server in binary format.",
      "params": {
        "receive-to": {
          "type": "object",
          "name": "Receive to",
          "desc": "Choose a Binary Data object to write the received binary message to."
        }
      },
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "connect",
      "scriptName": "Connect",
      "category": "connection",
      "list-name": "Connect",
      "display-text": "Connect to [i]{0}[/i] (require protocol {1})",
      "description": "Connect to a WebSocket server.",
      "params": {
        "url": {
          "type": "string",
          "name": "URL",
          "desc": "Enter the WebSocket server to connect to."
        },
        "protocol-optional": {
          "type": "string",
          "name": "Protocol (optional)",
          "desc": "Enter a required sub-protocol the server must support in order to establish a connection.  Leave empty for no protocol requirement."
        }
      },
      "isAsync": true
    },
    {
      "id": "close",
      "scriptName": "Close",
      "category": "connection",
      "list-name": "Close",
      "display-text": "Close connection",
      "description": "Close any active WebSocket connection."
    },
    {
      "id": "send-text",
      "scriptName": "Send",
      "category": "data",
      "list-name": "Send text",
      "display-text": "Send text [i]{0}[/i]",
      "description": "Send a text string to the server.",
      "params": {
        "data": {
          "type": "string",
          "name": "Data",
          "desc": "A text string to send to the server."
        }
      }
    },
    {
      "id": "send-binary",
      "scriptName": "SendBinary",
      "category": "data",
      "list-name": "Send binary",
      "display-text": "Send [i]{0}[/i]",
      "description": "Send the contents of a Binary Data object to the server.",
      "params": {
        "data": {
          "type": "object",
          "name": "Binary data",
          "desc": "A Binary Data object to send as a message."
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "errormsg",
      "scriptName": "ErrorMsg",
      "category": "connection",
      "translated-name": "ErrorMsg",
      "description": "The error message in 'On error'.",
      "returnType": "string"
    },
    {
      "id": "closecode",
      "scriptName": "CloseCode",
      "category": "connection",
      "translated-name": "CloseCode",
      "description": "The close code in 'On closed'.",
      "returnType": "string"
    },
    {
      "id": "closereason",
      "scriptName": "CloseReason",
      "category": "connection",
      "translated-name": "CloseReason",
      "description": "The reason for closing in 'On closed'.",
      "returnType": "string"
    },
    {
      "id": "messagetext",
      "scriptName": "MessageText",
      "category": "data",
      "translated-name": "MessageText",
      "description": "The text content of the message in 'On message'.",
      "returnType": "string"
    }
  ],
  "properties": {}
}