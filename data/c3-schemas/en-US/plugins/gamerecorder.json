{
  "id": "gamerecorder",
  "name": "Video recorder",
  "description": "Record videos of the project or the whole screen in real-time.",
  "type": "plugin",
  "aceCategories": {
    "recording": "Recording"
  },
  "conditions": [
    {
      "id": "on-recording-ready",
      "scriptName": "OnRecordingReady",
      "category": "recording",
      "list-name": "On recording ready",
      "display-text": "On recording ready",
      "description": "Triggered after 'Stop recording' when the recording is available in the RecordingURL expression.",
      "isTrigger": true
    },
    {
      "id": "on-recording-error",
      "scriptName": "OnRecordingError",
      "category": "recording",
      "list-name": "On recording error",
      "display-text": "On recording error",
      "description": "Triggered if an error occurs during recording.",
      "isTrigger": true
    },
    {
      "id": "is-recording-supported",
      "scriptName": "SupportsRecording",
      "category": "recording",
      "list-name": "Is recording supported",
      "display-text": "Is recording supported",
      "description": "True if the current browser supports video recording."
    },
    {
      "id": "is-screen-recording-supported",
      "scriptName": "SupportsScreenRecording",
      "category": "recording",
      "list-name": "Is screen recording supported",
      "display-text": "Is screen recording supported",
      "description": "True if the current browser supports screen recording."
    },
    {
      "id": "is-video-format-supported-2",
      "scriptName": "IsVideoFormatSupported2",
      "category": "recording",
      "list-name": "Is video format supported",
      "display-text": "Is video format [b]{0} {1}[/b] supported",
      "description": "Check if a particular video format is supported for recording.",
      "params": {
        "container": {
          "type": "combo",
          "name": "Container",
          "desc": "The container format to test if supported for recording.",
          "items": {
            "webm": "WebM",
            "mp4": "MP4"
          }
        },
        "codec": {
          "type": "combo",
          "name": "Video codec",
          "desc": "The video codec to test if supported for recording.",
          "items": {
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          }
        }
      }
    },
    {
      "id": "is-audio-format-supported-2",
      "scriptName": "IsAudioFormatSupported2",
      "category": "recording",
      "list-name": "Is audio format supported",
      "display-text": "Is audio format [b]{0} {1}[/b] supported",
      "description": "Check if a particular audio format is supported for recording.",
      "params": {
        "container": {
          "type": "combo",
          "name": "Container",
          "desc": "The container format to test if supported for recording.",
          "items": {
            "webm": "WebM",
            "mp4": "MP4"
          }
        },
        "codec": {
          "type": "combo",
          "name": "Audio codec",
          "desc": "The audio codec  to test if supported for recording.",
          "items": {
            "opus": "Opus",
            "aac": "AAC"
          }
        }
      }
    },
    {
      "id": "is-recording",
      "scriptName": "IsRecording",
      "category": "recording",
      "list-name": "Is recording",
      "display-text": "Is recording",
      "description": "True while actively recording a video."
    }
  ],
  "actions": [
    {
      "id": "start-recording-2",
      "scriptName": "StartRecording2",
      "category": "recording",
      "list-name": "Start recording",
      "display-text": "Start recording ([i]{0} {1}[/i] @ [i]{2}[/i] fps, [i]{3}[/i], [i]{4}[/i] kbps)",
      "description": "Record a real-time video of the project.",
      "params": {
        "container": {
          "type": "combo",
          "name": "Container",
          "desc": "The container format to record.",
          "items": {
            "auto": "Auto",
            "webm": "WebM",
            "mp4": "MP4"
          },
          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "Video codec",
          "desc": "The video codec to encode the recording with.",
          "items": {
            "none": "None (no video)",
            "auto": "Auto",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "framerate": {
          "type": "number",
          "name": "Framerate",
          "desc": "The frames per second to capture in the video (if used). Use 0 for the display rate."
        },
        "audio-codec": {
          "type": "combo",
          "name": "Audio codec",
          "desc": "The audio codec to encode the recording with.",
          "items": {
            "none": "None (no audio)",
            "auto": "Auto",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "quality-kbps": {
          "type": "number",
          "name": "Quality (kbps)",
          "desc": "The data rate to encode in kilobits per second (kbps)."
        }
      }
    },
    {
      "id": "start-screen-recording-2",
      "scriptName": "StartScreenRecording2",
      "category": "recording",
      "list-name": "Start screen recording",
      "display-text": "Start screen recording ([i]{0} {1}[/i], [i]{2}[/i], system audio [i]{3}[/i], [i]{4}[/i] kbps)",
      "description": "Record a real-time video of the user's screen.",
      "params": {
        "container": {
          "type": "combo",
          "name": "Container",
          "desc": "The container format to record.",
          "items": {
            "auto": "Auto",
            "webm": "WebM",
            "mp4": "MP4"
          },
          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "Video codec",
          "desc": "The video codec to encode the recording with.",
          "items": {
            "none": "None (no video)",
            "auto": "Auto",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "audio-codec": {
          "type": "combo",
          "name": "Audio codec",
          "desc": "The audio codec to encode the recording with.",
          "items": {
            "none": "None (no audio)",
            "auto": "Auto",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "system-audio": {
          "type": "boolean",
          "name": "System audio",
          "desc": "Check to request recording the entire system's audio output. Otherwise audio may be limited to the tab or Audio object output."
        },
        "quality-kbps": {
          "type": "number",
          "name": "Quality (kbps)",
          "desc": "The data rate to encode in kilobits per second (kbps)."
        }
      }
    },
    {
      "id": "start-user-media-recording-2",
      "scriptName": "StartUserMediaRecording2",
      "category": "recording",
      "list-name": "Start User Media recording",
      "display-text": "Start User Media recording ([i]{0} {1}[/i], [i]{2}[/i], [i]{3}[/i] kbps)",
      "description": "Record the audio or video from an active User Media object.",
      "params": {
        "container": {
          "type": "combo",
          "name": "Container",
          "desc": "The container format to record.",
          "items": {
            "auto": "Auto",
            "webm": "WebM",
            "mp4": "MP4"
          },
          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "Video codec",
          "desc": "The video codec to encode the recording with.",
          "items": {
            "none": "None (no video)",
            "auto": "Auto",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "audio-codec": {
          "type": "combo",
          "name": "Audio codec",
          "desc": "The audio codec to encode the recording with.",
          "items": {
            "none": "None (no audio)",
            "auto": "Auto",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "quality-kbps": {
          "type": "number",
          "name": "Quality (kbps)",
          "desc": "The data rate to encode in kilobits per second (kbps)."
        }
      }
    },
    {
      "id": "stop-recording",
      "scriptName": "StopRecording",
      "category": "recording",
      "list-name": "Stop recording",
      "display-text": "Stop recording",
      "description": "Finish recording a video. Triggers 'On recording ready' when available."
    }
  ],
  "expressions": [
    {
      "id": "recordingurl",
      "scriptName": "RecordingURL",
      "category": "recording",
      "translated-name": "RecordingURL",
      "description": "Return a URL of the recording that can be downloaded with the Browser object.",
      "returnType": "string"
    },
    {
      "id": "recording-type",
      "scriptName": "RecordingType",
      "category": "recording",
      "translated-name": "RecordingType",
      "description": "Return the MIME type of the recording, e.g. \"video/webm\".",
      "returnType": "string"
    },
    {
      "id": "recording-file-extension",
      "scriptName": "RecordingFileExtension",
      "category": "recording",
      "translated-name": "RecordingFileExtension",
      "description": "Return the file extension for the recording, e.g. \".webm\".",
      "returnType": "string"
    }
  ],
  "properties": {}
}