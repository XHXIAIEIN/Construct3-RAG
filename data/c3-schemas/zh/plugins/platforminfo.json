      "description": "检测当前的运行平台是否为 Chrome OS 设备。"
    },
    {
      "id": "is-on-android",
      "scriptName": "IsOnAndroid",
      "category": "platform",
      "list-name": "在 Android 运行",
      "display-text": "在 Android 运行",
      "description": "检测当前的运行平台是否为 Android 设备。"
    },
    {
      "id": "is-on-ios",
      "scriptName": "IsOniOS",
