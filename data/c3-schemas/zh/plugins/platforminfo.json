{
  "id": "platforminfo",
  "name": "设备信息",
  "description": "获取正在运行应用程序的平台设备信息。",
  "type": "plugin",
  "aceCategories": {
    "platform": "平台",
    "display": "显示",
    "network": "网络",
    "device": "设备",
    "export": "导出类型",
    "wake-lock": "屏幕常亮",
    "performance": "性能测试"
  },
  "conditions": [
    {
      "id": "is-on-mobile",
      "scriptName": "IsOnMobile",
      "category": "platform",
      "list-name": "在移动端运行",
      "display-text": "在移动端运行",
      "description": "检测当前运行设备是否为移动设备，如手机、平板电脑。注意：这种检测方式并非总是准确的，也不意味着此时必须要使用某种操作方式，如触屏。"
    },
    {
      "id": "is-on-windows",
      "scriptName": "IsOnWindows",
      "category": "platform",
      "list-name": "在 Windows 运行",
      "display-text": "在 Windows 运行",
      "description": "检测当前的运行平台是否为 Windows 设备。"
    },
    {
      "id": "is-on-macos",
      "scriptName": "IsOnMacOS",
      "category": "platform",
      "list-name": "在 macOS 运行",
