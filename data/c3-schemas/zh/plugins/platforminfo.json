    {
      "id": "on-network-change",
      "scriptName": "OnNetworkChange",
      "category": "network",
      "list-name": "网络连接已变化",
      "display-text": "网络连接已变化",
      "description": "当网络环境发生变化时触发，例如从WiFi切换为流量。",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-acquired",
      "scriptName": "OnWakeLockAcquired",
      "category": "wake-lock",
      "list-name": "请求 '屏幕常亮' 成功",
      "display-text": "请求 '屏幕常亮' 成功",
      "description": "成功开启屏幕常亮功能时触发。",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-error",
      "scriptName": "OnWakeLockError",
      "category": "wake-lock",
      "list-name": "请求 '屏幕常亮' 失败",
      "display-text": "请求 '屏幕常亮' 失败",
      "description": "执行 '请求屏幕常亮' 动作后，权限请求失败时触发。",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-released",
      "scriptName": "OnWakeLockReleased",
      "category": "wake-lock",
      "list-name": "屏幕常亮解除",
      "display-text": "屏幕常亮解除",
      "description": "开启 '屏幕常亮' 功能后，再次解除时触发，这意味着屏幕此时已关闭。注意：某些情况下，设备会被自动解除。例如进入了省电模式。",
      "isTrigger": true
    },
    {
      "id": "is-wake-lock-active",
      "scriptName": "IsWakeLockActive",
      "category": "wake-lock",
      "list-name": "已开启屏幕常亮",
      "display-text": "已开启屏幕常亮",
      "description": "检测当前是否已完成请求 '请求屏幕常亮' 动作，并且屏幕已保持常亮的状态。"
    },
    {
      "id": "is-wake-lock-supported",
      "scriptName": "IsWakeLockSupported",
      "category": "wake-lock",
      "list-name": "设备支持功能",
      "display-text": "设备支持屏幕常亮",
      "description": "检测当前设备是否支持屏幕常亮的功能。"
    }
  ],
  "actions": [
    {
      "id": "request-wake-lock",
      "scriptName": "RequestWakeLock",
      "category": "wake-lock",
      "list-name": "请求屏幕常亮",
      "display-text": "请求屏幕常亮",
      "description": "请求设备唤醒锁，让设备保持常亮的状态。注意：这可能会导致电量消耗更快。"
    },
    {
      "id": "release-wake-lock",
      "scriptName": "ReleaseWakeLock",
      "category": "wake-lock",
      "list-name": "关闭屏幕常亮",
      "display-text": "关闭屏幕常亮",
      "description": "如果已进入屏幕常亮状态，可以将其关闭。屏幕可能会由于长期不活跃而变暗或者关闭。"
    }
  ],
