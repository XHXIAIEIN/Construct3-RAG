{
  "id": "water",
  "name": "水面",
  "description": "像水面扭曲一样的动画。",
  "category": "distortion",
  "blends-background": false,
  "cross-sampling": false,
  "animated": true,
  "parameters": [
    {
      "id": "speed",
      "type": "percent",
      "name": "速度",
      "desc": "此效果的整体播放速度。"
    },
    {
      "id": "x-speed",
      "type": "percent",
      "name": "X速度",
      "desc": "波浪在水平方向的速度。"
    },
    {
      "id": "y-speed",
      "type": "percent",
      "name": "Y速度",
      "desc": "波浪在垂直方向的速度。"
    },
    {
      "id": "intensity",
      "type": "float",
      "name": "强度",
      "desc": "波纹的强度。值越高，波纹越多。"
    },
    {
      "id": "frequency",
      "type": "float",
      "name": "频率",
      "desc": "波纹的频率。"
    },
    {
      "id": "angle",
      "type": "float",
      "name": "角度",
      "desc": "波纹的角度，质数的效果最佳。"
    },
    {
      "id": "delta",
      "type": "float",
      "name": "增量",
      "desc": "波浪引起的扭曲量。 值越低，扭曲越大。"
    },
    {
      "id": "reflectivity",
      "type": "float",
      "name": "反射率",
      "desc": "波凸出的强度。"
    },
    {
      "id": "emboss",
      "type": "percent",
      "name": "纹理",
      "desc": "波浪的深度。"
    }
  ]
}