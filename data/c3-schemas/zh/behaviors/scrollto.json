{
  "id": "scrollto",
  "name": "镜头跟随",
  "description": "始终将画面对焦到此对象的位置。若有多个对象添加此行为，则对准它们的中心点。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "检测当前行为是否已启用。"
    }
  ],
  "actions": [
    {
      "id": "shake",
      "scriptName": "Shake",
      "category": "",
      "list-name": "振动",
      "display-text": "{my} 振动[i]{1}[/i]秒, 强度[i]{0}[/i]  ({2})",
      "description": "在一段时间内，持续振动屏幕。注意，如果可视区域和场景大小相同，需要允许镜头滚动超出场景。",
      "params": {
        "magnitude": {
          "type": "number",
          "name": "振动强度",
          "desc": "振动强度，即允许滚动随机偏移的最大像素。"
        },
        "duration": {
          "type": "number",
          "name": "持续时间",
          "desc": "振动的持续时间，以秒为单位。"
        },
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "在持续时间内，振动强度是逐渐减弱至零，还是保持不变。",
          "items": {
            "reducing-magnitude": "逐渐减弱",
            "constant-magnitude": "保持不变"
          }
        }
      }
    },
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "{0} {my}",
      "description": "启用或禁用此行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "启用或禁用此行为。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    }
  ],
  "expressions": [],
  "properties": {
    "enabled": {
      "name": "启用",
      "desc": "游戏初始化时，是否默认启用该行为。"
    }
  }
}