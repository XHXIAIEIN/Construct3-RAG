{
  "id": "fade",
  "name": "淡入淡出",
  "description": "在一段时间内逐渐改变对象的不透明度，适用于让对象逐渐出现/消失。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "on-fade-out-finished",
      "scriptName": "OnFadeOutEnd",
      "category": "",
      "list-name": "淡出完成",
      "display-text": "{my} 淡出完成",
      "description": "淡出结束时触发。",
      "isTrigger": true
    },
    {
      "id": "on-fade-in-finished",
      "scriptName": "OnFadeInEnd",
      "category": "",
      "list-name": "淡入完成",
      "display-text": "{my} 淡入完成",
      "description": "淡入完成时触发。",
      "isTrigger": true
    },
    {
      "id": "on-wait-finished",
      "scriptName": "OnWaitEnd",
      "category": "",
      "list-name": "等待结束",
      "display-text": "{my} 等待结束",
      "description": "等待结束后触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "restart-fade",
      "scriptName": "RestartFade",
      "category": "",
      "list-name": "重新播放",
      "display-text": "{my} 重新播放",
      "description": "再次运行一次淡入淡出。"
    },
    {
      "id": "start-fade",
      "scriptName": "StartFade",
      "category": "",
      "list-name": "开始播放",
      "display-text": "{my} 开始播放",
      "description": "在对象属性中，如果未勾选在创建时自动淡入，则使用此动作开始淡入。"
    },
    {
      "id": "set-fade-in-time",
      "scriptName": "SetFadeInTime",
      "category": "",
      "list-name": "设置淡入时间",
      "display-text": "设置 {my}淡入时间为[i]{0}[/i]秒",
      "description": "设置从不可见状态，逐渐淡入，直至可见的时间。",
      "params": {
        "fade-in-time": {
          "type": "number",
          "name": "淡入时间",
          "desc": "淡入阶段的时间，以秒为单位。如果为0，则跳过淡入。"
        }
      }
    },
    {
      "id": "set-wait-time",
      "scriptName": "SetWaitTime",
      "category": "",
      "list-name": "设置等待时间",
      "display-text": "设置 {my}等待时间为[i]{0}[/i]秒",
      "description": "在淡入完成后，等待淡出的时间。",
      "params": {
        "wait-time": {
          "type": "number",
          "name": "等待时间",
          "desc": "等待的时间，以秒为单位。如果为0，则跳过等待，立即执行淡出。"
        }
      }
    },
    {
      "id": "set-fade-out-time",
      "scriptName": "SetFadeOutTime",
      "category": "",
      "list-name": "设置淡出时间",
      "display-text": "设置 {my}淡出时间为[i]{0}[/i]",
      "description": "设置从可见状态，逐渐淡出，直至不可见的时间。",
      "params": {
        "fade-out-time": {
          "type": "number",
          "name": "淡出时间",
          "desc": "淡出持续时间，以秒为单位。如果为 0，则跳过淡出。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "fadeintime",
      "scriptName": "FadeInTime",
      "category": "",
      "translated-name": "淡入时间",
      "description": "淡入持续时间，以秒为单位。如果为 0，则跳过淡入。",
      "returnType": "number"
    },
    {
      "id": "waittime",
      "scriptName": "WaitTime",
      "category": "",
      "translated-name": "等待时间",
      "description": "等待持续时间，以秒为单位。如果为 0，则跳过等待。",
      "returnType": "number"
    },
    {
      "id": "fadeouttime",
      "scriptName": "FadeOutTime",
      "category": "",
      "translated-name": "淡出时间",
      "description": "淡出持续时间，以秒为单位。如果为 0，则跳过淡出。",
      "returnType": "number"
    }
  ],
  "properties": {
    "fade-in-time": {
      "name": "淡入时间",
      "desc": "淡入的持续时间，以秒为单位。如果为 0，则跳过淡入。"
    },
    "wait-time": {
      "name": "等待时间",
      "desc": "淡入结束后，等待淡出开始的阶段。如果为 0，则跳过等待。"
    },
    "fade-out-time": {
      "name": "淡出时间",
      "desc": "逐渐淡出直到不可见的状态。如果为 0，则跳过淡出。"
    },
    "destroy": {
      "name": "淡出完成后销毁",
      "desc": "在淡出结束后，自动销毁对象。"
    },
    "enabled": {
      "name": "启用",
      "desc": "对象创建时立即执行淡入淡出。禁用时，需使用 '开始播放' 动作运行。"
    },
    "live-preview": {
      "name": "预览",
      "desc": "在编辑器中进行实时预览。"
    }
  }
}