{
  "id": "custom",
  "name": "Custom",
  "description": "Make your own movement using low-level movement functions.",
  "type": "behavior",
  "aceCategories": {
    "angle-of-motion": "Angle of motion",
    "velocity": "Velocity"
  },
  "conditions": [
    {
      "id": "is-moving",
      "scriptName": "IsMoving",
      "category": "",
      "list-name": "Is moving",
      "display-text": "{my} is moving",
      "description": "True when the object is moving."
    },
    {
      "id": "compare-speed",
      "scriptName": "CompareSpeed",
      "category": "",
      "list-name": "Compare speed",
      "display-text": "{my} {0} speed {1} {2}",
      "description": "Compare the current speed of the object.",
      "params": {
        "which": {
          "type": "combo",
          "name": "Which",
          "desc": "Choose the speed to compare.",
          "items": {
            "overall": "Overall",
            "horizontal": "Horizontal",
            "vertical": "Vertical"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "Choose the way to compare the speed."
        },
        "speed": {
          "type": "number",
          "name": "Speed",
          "desc": "The speed, in pixels per second, to compare to."
        }
      }
    },
    {
      "id": "on-step",
      "scriptName": "OnCMStep",
      "category": "",
      "list-name": "On step",
      "display-text": "On {my} step",
      "description": "Triggered when stepping the object for motion.",
      "isTrigger": true
    },
    {
      "id": "on-horizontal-step",
      "scriptName": "OnCMHorizStep",
      "category": "",
      "list-name": "On horizontal step",
      "display-text": "On {my} horizontal step",
      "description": "Triggered when stepping the object horizontally for motion.",
      "isTrigger": true
    },
    {
      "id": "on-vertical-step",
      "scriptName": "OnCMVertStep",
      "category": "",
      "list-name": "On vertical step",
      "display-text": "On {my} vertical step",
      "description": "Triggered when stepping the object vertically for motion.",
      "isTrigger": true
    },
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "Is enabled",
      "display-text": "{my} is enabled",
      "description": "Test if the behavior is enabled."
    }
  ],
  "actions": [
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "Set enabled",
      "display-text": "Set {my} [b]{0}[/b]",
      "description": "Set whether this behavior is enabled.",
      "params": {
        "state": {
          "type": "combo",
          "name": "State",
          "desc": "Set whether to enable or disable the behavior.",
          "items": {
            "disabled": "Disabled",
            "enabled": "Enabled"
          }
        }
      }
    },
    {
      "id": "set-angle-of-motion",
      "scriptName": "SetAngleOfMotion",
      "category": "angle-of-motion",
      "list-name": "Set angle of motion",
      "display-text": "Set {my} angle of motion to [i]{0}[/i]",
      "description": "Set the angle the object is currently moving at.",
      "params": {
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "The new angle of motion, in degrees."
        }
      }
    },
    {
      "id": "rotate-clockwise",
      "scriptName": "RotateAngleOfMotionClockwise",
      "category": "angle-of-motion",
      "list-name": "Rotate clockwise",
      "display-text": "Rotate {my} angle of motion clockwise [i]{0}[/i] degrees",
      "description": "Rotate the angle of motion in a clockwise direction.",
      "params": {
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "Amount to rotate clockwise, in degrees."
        }
      }
    },
    {
      "id": "rotate-counter-clockwise",
      "scriptName": "RotateAngleOfMotionCounterClockwise",
      "category": "angle-of-motion",
      "list-name": "Rotate counter-clockwise",
      "display-text": "Rotate {my} angle of motion counter-clockwise [i]{0}[/i] degrees",
      "description": "Rotate the angle of motion in a counter-clockwise direction.",
      "params": {
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "Amount to rotate counter-clockwise, in degrees."
        }
      }
    },
    {
      "id": "stop",
      "scriptName": "Stop",
      "category": "velocity",
      "list-name": "Stop",
      "display-text": "Stop {my}",
      "description": "Set the speed to zero."
    },
    {
      "id": "reverse",
      "scriptName": "Reverse",
      "category": "velocity",
      "list-name": "Reverse",
      "display-text": "Reverse {my} ({0})",
      "description": "Invert the direction of motion.",
      "params": {
        "axes": {
          "type": "combo",
          "name": "Axes",
          "desc": "Choose which axes to reverse on.",
          "items": {
            "both": "Both",
            "horizontally": "Horizontally",
            "vertically": "Vertically"
          }
        }
      }
    },
    {
      "id": "set-speed",
      "scriptName": "SetSpeed",
      "category": "velocity",
      "list-name": "Set speed",
      "display-text": "Set {my} {0} speed to [i]{1}[/i]",
      "description": "Set the object's current speed.",
      "params": {
        "which": {
          "type": "combo",
          "name": "Which",
          "desc": "Choose the speed to set.",
          "items": {
            "overall": "Overall",
            "horizontal": "Horizontal",
            "vertical": "Vertical"
          }
        },
        "speed": {
          "type": "number",
          "name": "Speed",
          "desc": "The new speed of the object to set, in pixels per second."
        }
      }
    },
    {
      "id": "accelerate",
      "scriptName": "Accelerate",
      "category": "velocity",
      "list-name": "Accelerate",
      "display-text": "Accelerate {my} {0} [i]{1}[/i]",
      "description": "Accelerate the object forwards or on an axis.",
      "params": {
        "which": {
          "type": "combo",
          "name": "Which",
          "desc": "Choose which way to accelerate.",
          "items": {
            "forwards": "Forwards",
            "horizontally": "Horizontally",
            "vertically": "Vertically"
          }
        },
        "acceleration": {
          "type": "number",
          "name": "Acceleration",
          "desc": "The acceleration, in pixels per second per second."
        }
      }
    },
    {
      "id": "accelerate-toward-angle",
      "scriptName": "AccelerateAngle",
      "category": "velocity",
      "list-name": "Accelerate toward angle",
      "display-text": "Accelerate {my} [i]{0}[/i] at angle [i]{1}[/i]",
      "description": "Accelerate the object at an angle.",
      "params": {
        "acceleration": {
          "type": "number",
          "name": "Acceleration",
          "desc": "The acceleration, in pixels per second per second."
        },
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "The angle, in degrees, to accelerate toward."
        }
      }
    },
    {
      "id": "accelerate-toward-position",
      "scriptName": "AcceleratePos",
      "category": "velocity",
      "list-name": "Accelerate toward position",
      "display-text": "Accelerate {my} [i]{0}[/i] toward ([i]{1}[/i], [i]{2}[/i])",
      "description": "Accelerate the object toward a position.",
      "params": {
        "acceleration": {
          "type": "number",
          "name": "Acceleration",
          "desc": "The acceleration, in pixels per second per second."
        },
        "x": {
          "type": "number",
          "name": "X",
          "desc": "The X co-ordinate in the layout to accelerate toward."
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "The Y co-ordinate in the layout to accelerate toward."
        }
      }
    },
    {
      "id": "stop-stepping",
      "scriptName": "StopStepping",
      "category": "velocity",
      "list-name": "Stop stepping",
      "display-text": "Stop {my} stepping ({0})",
      "description": "Stop the current stepping, preventing any more step triggers firing this tick.",
      "params": {
        "position": {
          "type": "combo",
          "name": "Position",
          "desc": "Choose the resulting object position.",
          "items": {
            "go-back-a-step": "Go back a step",
            "stay-at-current-position": "Stay at current position"
          }
        }
      }
    },
    {
      "id": "push-out-solid",
      "scriptName": "PushOutSolid",
      "category": "velocity",
      "list-name": "Push out solid",
      "display-text": "Push {my} out of solid ({0})",
      "description": "Push the object to a space if it is overlapping a solid.",
      "params": {
        "direction": {
          "type": "combo",
          "name": "Direction",
          "desc": "Choose the method of push out.",
          "items": {
            "opposite-angle": "Opposite angle",
            "nearest": "Nearest",
            "up": "Up",
            "down": "Down",
            "left": "Left",
            "right": "Right"
          }
        }
      }
    },
    {
      "id": "push-out-solid-at-angle",
      "scriptName": "PushOutSolidAngle",
      "category": "velocity",
      "list-name": "Push out solid at angle",
      "display-text": "Push {my} out of solid at angle {0}",
      "description": "Push the object to a space at an angle if it is overlapping a solid.",
      "params": {
        "angle": {
          "type": "number",
          "name": "Angle",
          "desc": "Angle, in degrees, to push the object out at."
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "speed",
      "scriptName": "Speed",
      "category": "",
      "translated-name": "Speed",
      "description": "The current object speed, in pixels per second.",
      "returnType": "number"
    },
    {
      "id": "movingangle",
      "scriptName": "MovingAngle",
      "category": "",
      "translated-name": "MovingAngle",
      "description": "The current angle of motion, in degrees.",
      "returnType": "number"
    },
    {
      "id": "dx",
      "scriptName": "dx",
      "category": "",
      "translated-name": "dx",
      "description": "The current X component of motion, in pixels per second.",
      "returnType": "number"
    },
    {
      "id": "dy",
      "scriptName": "dy",
      "category": "",
      "translated-name": "dy",
      "description": "The current Y component of motion, in pixels per second.",
      "returnType": "number"
    }
  ],
  "properties": {
    "stepping-mode": {
      "name": "Stepping mode",
      "desc": "Move in increments while firing the step triggers.",
      "items": {
        "none": "None",
        "linear": "Linear",
        "horizontal-then-vertical": "Horizontal then vertical",
        "vertical-then-horizontal": "Vertical then horizontal"
      }
    },
    "pixels-per-step": {
      "name": "Pixels per step",
      "desc": "When stepping enabled, the number of pixels to move each step."
    },
    "enabled": {
      "name": "Enabled",
      "desc": "Whether the behavior is initially enabled or disabled."
    }
  }
}