      "params": {
        "tag": {
          "type": "string",
          "name": "Tag",
          "desc": "Timer name"
        }
      },
      "returnType": "number"
    },
    {
      "id": "duration",
      "scriptName": "Duration",
      "category": "",
      "translated-name": "Duration",
      "description": "Duration in seconds of a timer that is running.",
      "params": {
        "tag": {
          "type": "string",
          "name": "Tag",
          "desc": "Timer name"
        }
      },
      "returnType": "number"
    }
  ],
  "properties": {}
