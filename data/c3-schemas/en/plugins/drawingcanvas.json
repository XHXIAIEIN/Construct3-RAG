      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "Set blend mode",
      "display-text": "Set blend mode to [i]{0}[/i]",
      "description": "Set the background blend mode for this object.",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "Blend mode",
          "desc": "Choose the new blend mode for this object.",
          "items": {
            "normal": "Normal",
            "additive": "Additive",
            "xor": "XOR",
            "copy": "Copy",
            "destination-over": "Destination over",
            "source-in": "Source in",
            "destination-in": "Destination in",
            "source-out": "Source out",
            "destination-out": "Destination out",
            "source-atop": "Source atop",
            "destination-atop": "Destination atop",
            "lighten": "Lighten",
            "darken": "Darken",
            "multiply": "Multiply",
            "screen": "Screen"
          }
        }
      }
    },
    {
      "id": "save-image",
      "scriptName": "SaveImage",
      "category": "canvas",
      "list-name": "Save image",
      "display-text": "Save image ({0}, quality [i]{1}[/i], offset [i]{2}[/i], [i]{3}[/i] size [i]{4}[/i] x [i]{5}[/i])",
      "description": "Save the current canvas image. Use the 'On saved image' trigger and 'SavedImageURL' expression to get the result.",
      "params": {
        "format": {
          "type": "combo",
          "name": "Format",
          "desc": "Choose the file format to save the image with. PNG is lossless but JPEG files are smaller.",
          "items": {
            "png": "PNG",
            "jpeg": "JPEG"
          }
        },
        "jpeg-quality": {
          "type": "number",
          "name": "JPEG quality",
          "desc": "If 'Format' is 'JPEG', the JPEG quality from 0 (worst) to 100 (best). Ignored for PNG."
        },
        "x": {
          "type": "number",
          "name": "X",
          "desc": "The X offset of the area to snapshot, in canvas device pixels."
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "The Y offset of the area to snapshot, in canvas device pixels."
        },
        "width": {
          "type": "number",
          "name": "Width",
          "desc": "The width of the area to snapshot, in canvas device pixels. Leave 0 to use the full width."
        },
        "height": {
          "type": "number",
          "name": "Height",
          "desc": "The height of the area to snapshot, in canvas device pixels. Leave 0 to use the full height."
        }
      },
      "isAsync": true
    },
    {
      "id": "save-snapshot",
      "scriptName": "SaveSnapshot",
      "category": "canvas",
      "list-name": "Save snapshot",
      "display-text": "Save snapshot",
      "description": "Save a copy of the current canvas image for reading pixel colors.",
      "isAsync": true
    },
    {
      "id": "clear-snapshot",
      "scriptName": "ClearSnapshot",
      "category": "canvas",
      "list-name": "Clear snapshot",
      "display-text": "Clear snapshot",
