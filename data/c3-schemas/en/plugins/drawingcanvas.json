      "list-name": "Set snapshot pixel",
      "display-text": "Set pixel in snapshot at ([i]{0}[/i], [i]{1}[/i]) to [i]{2}[/i]",
      "description": "Set a pixel to a color in the snapshot.",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "The X co-ordinate of the pixel in the snapshot."
