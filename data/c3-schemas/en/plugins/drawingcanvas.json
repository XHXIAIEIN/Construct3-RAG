{
  "id": "drawingcanvas",
  "name": "Drawing canvas",
  "description": "A custom drawing surface.",
  "type": "plugin",
  "aceCategories": {
    "appearance": "Appearance",
    "canvas": "Canvas",
    "drawing-general": "Drawing: general",
    "drawing-polygons": "Drawing: polygons"
  },
  "conditions": [
    {
      "id": "on-saved-image",
      "scriptName": "OnSavedImage",
      "category": "canvas",
      "list-name": "On saved image",
      "display-text": "On saved image",
      "description": "Triggered after the 'Save image' action when the saved image is ready.",
      "isTrigger": true
    },
    {
      "id": "on-snapshot",
      "scriptName": "OnSnapshot",
      "category": "canvas",
      "list-name": "On snapshot",
      "display-text": "On snapshot",
      "description": "Triggered after the 'Save snapshot' action when the pixel data is ready.",
      "isTrigger": true
    },
    {
      "id": "on-resolution-changed",
      "scriptName": "OnResolutionChanged",
      "category": "canvas",
      "list-name": "On resolution changed",
      "display-text": "On resolution changed",
      "description": "Triggered when the drawing surface changes resolution. Redraw content to show it at the new resolution.",
      "isTrigger": true
    }
