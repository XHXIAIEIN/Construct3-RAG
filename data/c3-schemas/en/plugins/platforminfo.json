{
  "id": "platforminfo",
  "name": "Platform info",
  "description": "Retrieve information about the device and platform the app is running on.",
  "type": "plugin",
  "aceCategories": {
    "platform": "Platform",
    "export": "Export types",
    "display": "Display",
    "network": "Network",
    "device": "Device",
    "performance": "Performance",
    "wake-lock": "Wake lock"
  },
  "conditions": [
    {
      "id": "is-on-mobile",
      "scriptName": "IsOnMobile",
      "category": "platform",
      "list-name": "Is on mobile",
      "display-text": "Is on mobile",
      "description": "True if the current device is a mobile device like a phone or tablet. This detection may not always be accurate and does not always imply certain input methods will be used."
    },
    {
      "id": "is-on-windows",
      "scriptName": "IsOnWindows",
      "category": "platform",
      "list-name": "Is on Windows",
      "display-text": "Is on Windows",
      "description": "True when on a device running Windows."
    },
    {
      "id": "is-on-macos",
      "scriptName": "IsOnMacOS",
      "category": "platform",
      "list-name": "Is on macOS",
      "display-text": "Is on macOS",
      "description": "True when on a device running macOS / OS X."
    },
    {
      "id": "is-on-linux",
      "scriptName": "IsOnLinux",
      "category": "platform",
      "list-name": "Is on Linux",
      "display-text": "Is on Linux",
      "description": "True when on a device running Linux."
    },
    {
      "id": "is-on-chromeos",
      "scriptName": "IsOnChromeOS",
      "category": "platform",
      "list-name": "Is on Chrome OS",
      "display-text": "Is on Chrome OS",
      "description": "True when on a device running Chrome OS."
    },
    {
      "id": "is-on-android",
      "scriptName": "IsOnAndroid",
      "category": "platform",
      "list-name": "Is on Android",
      "display-text": "Is on Android",
      "description": "True when on a device running Android."
    },
    {
      "id": "is-on-ios",
      "scriptName": "IsOniOS",
      "category": "platform",
      "list-name": "Is on iOS",
      "display-text": "Is on iOS",
      "description": "True when on a device running iOS."
    },
    {
      "id": "is-web-export",
      "scriptName": "IsWebExport",
      "category": "export",
      "list-name": "Is web export",
      "display-text": "Is web export",
      "description": "True when running after a web-based export. Also true in preview mode."
    },
    {
      "id": "is-cordova-export",
      "scriptName": "IsCordovaExport",
      "category": "export",
      "list-name": "Is Cordova export",
      "display-text": "Is Cordova export",
      "description": "True when running after a Cordova-based export (Android/iOS)."
    },
    {
      "id": "is-windows-webview2-export",
      "scriptName": "IsWindowsWebView2Export",
      "category": "export",
      "list-name": "Is Windows wrapper export",
      "display-text": "Is Windows wrapper (WebView2) export",
      "description": "True when running after a Windows wrapper (WebView2) export."
    },
    {
      "id": "is-macos-wkwebview-export",
      "scriptName": "IsMacOSWKWebView2Export",
      "category": "export",
      "list-name": "Is macOS wrapper export",
      "display-text": "Is macOS wrapper (WKWebView) export",
      "description": "True when running after a macOS wrapper (WKWebView) export."
    },
    {
      "id": "is-linux-cef-export",
      "scriptName": "IsLinuxCEFExport",
      "category": "export",
      "list-name": "Is Linux wrapper export",
      "display-text": "Is Linux wrapper (CEF) export",
      "description": "True when running after a Linux wrapper (CEF) export."
    },
    {
      "id": "on-network-change",
      "scriptName": "OnNetworkChange",
      "category": "network",
      "list-name": "On network change",
      "display-text": "On network change",
      "description": "Triggered when the network connection changes, e.g. when moving from Wifi to cellular data.",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-acquired",
      "scriptName": "OnWakeLockAcquired",
      "category": "wake-lock",
      "list-name": "On wake lock acquired",
      "display-text": "On wake lock acquired",
      "description": "Triggered after 'Request wake lock' if the lock was successfully acquired.",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-error",
      "scriptName": "OnWakeLockError",
      "category": "wake-lock",
      "list-name": "On wake lock error",
      "display-text": "On wake lock error",
      "description": "Triggered after 'Request wake lock' if a lock failed to be acquired.",
      "isTrigger": true
    },
    {
      "id": "on-wake-lock-released",
      "scriptName": "OnWakeLockReleased",
      "category": "wake-lock",
      "list-name": "On wake lock released",
      "display-text": "On wake lock released",
      "description": "Triggered when an active wake lock is released. Note in some cases this may be done automatically.",
      "isTrigger": true
    },
    {
      "id": "is-wake-lock-active",
      "scriptName": "IsWakeLockActive",
      "category": "wake-lock",
      "list-name": "Is wake lock active",
      "display-text": "Is wake lock active",
      "description": "True if a wake lock has been successfully acquired and has not yet been released."
    },
    {
      "id": "is-wake-lock-supported",
      "scriptName": "IsWakeLockSupported",
      "category": "wake-lock",
      "list-name": "Is wake lock supported",
      "display-text": "Is wake lock supported",
      "description": "True if the 'Request wake lock' action is supported and can be used."
    }
  ],
  "actions": [
    {
      "id": "request-wake-lock",
      "scriptName": "RequestWakeLock",
      "category": "wake-lock",
      "list-name": "Request wake lock",
      "display-text": "Request wake lock",
      "description": "Request a wake lock to keep the screen on permanently. Note this increases power usage so will drain battery faster."
    },
    {
      "id": "release-wake-lock",
      "scriptName": "ReleaseWakeLock",
      "category": "wake-lock",
      "list-name": "Release wake lock",
      "display-text": "Release wake lock",
      "description": "Release any active wake lock so the screen can turn off to save power again."
    }
  ],
  "expressions": [
