  "actions": [
    {
      "id": "speak-text",
      "name_zh": "说话",
      "name_en": "Speak text",
      "description_zh": "用语音合成读出一些文本。",
      "description_en": "Read out some text with speech synthesis.",
      "display_zh": "朗读文本 [b]{0}[/b] (语言: [i]{1}[/i], 声音来源: [i]{2}[/i], 音量: [i]{3}[/i]dB, 速度: [i]{4}[/i], 音高 [i]{5}[/i])",
      "display_en": "Speak text [b]{0}[/b] (language [i]{1}[/i], voice URI [i]{2}[/i], volume [i]{3}[/i] dB, rate [i]{4}[/i], pitch [i]{5}[/i])",
      "scriptName": "SpeakText",
      "category": "speech-synthesis",
      "params": [
        {
          "id": "text",
          "type": "string",
          "name_en": "Text",
          "name_zh": "文本",
          "desc_en": "The text to be spoken.",
          "desc_zh": "要说的文字。"
        },
        {
          "id": "language",
          "type": "string",
          "name_en": "Language",
          "name_zh": "语言",
          "desc_en": "The language of the text, e.g. \"en-US\" for US English. Leave empty to use the default language.",
          "desc_zh": "文字的语言代码，如 \"en-US\" 为美式英语，\"zh-CN\"为简体中文。留空则使用设备默认语言。"
        },
        {
          "id": "voice-uri",
          "type": "string",
          "name_en": "Voice URI",
          "name_zh": "声音文件地址",
          "desc_en": "The voice to use. Leave empty to use the default voice.",
          "desc_zh": "要使用的声音。 留空以使用默认语音。"
        },
        {
          "id": "volume",
          "type": "number",
          "name_en": "Volume",
          "name_zh": "音量",
          "desc_en": "The volume to speak the text at, in dB attenuation.",
          "desc_zh": "朗读文本的音量，以分贝为单位。"
        },
        {
          "id": "rate",
          "type": "number",
          "name_en": "Rate",
          "name_zh": "速率",
          "desc_en": "The relative speed at which to speak, e.g. 1 for normal, 0.5 for half as fast.",
          "desc_zh": "说话的相对速度，例如 1为正常，0.5为一半快。"
        },
        {
          "id": "pitch",
          "type": "number",
          "name_en": "Pitch",
          "name_zh": "音高",
          "desc_en": "The relative pitch at which to speak, between 0 and 2.",
          "desc_zh": "说话的相对音高，介于0和2之间。"
        }
      ]
    },
