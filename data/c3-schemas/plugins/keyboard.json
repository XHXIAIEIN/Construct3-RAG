  "actions": [
    {
      "id": "lock-keyboard",
      "name_zh": "锁定键盘",
      "name_en": "Lock keyboard",
      "description_zh": "请求锁定键盘，允许游戏在全屏模式下访问特殊按键或组合键，而不被浏览器/应用程序捕获。注意：仅在全屏模式下生效。",
      "description_en": "Request to lock the keyboard so keypresses are always received by the project rather than the browser/application. NOTE: this only takes effect in fullscreen mode.",
      "display_zh": "锁定键盘(按键: [i]{0}[/i]))",
      "display_en": "Lock keyboard (keys: [i]{0}[/i])",
      "scriptName": "LockKeyboard",
      "category": "keyboard-lock",
      "params": [
        {
          "id": "keys",
          "type": "string",
          "name_en": "Keys",
          "name_zh": "按键",
          "desc_en": "A comma-separated array of keys to lock. Leave empty to request to lock all keys.",
          "desc_zh": "要锁定的按键名，以逗号区分多个按键名。留空默认所有按键。注：按键名使用 keyCode 标准。"
        }
      ],
      "isAsync": true
    },
    {
      "id": "unlock-keyboard",
      "name_zh": "解锁键盘",
      "name_en": "Unlock keyboard",
      "description_zh": "解锁的键盘锁，恢复按键的默认处理。",
      "description_en": "Unlock a previous keyboard lock, restoring the default handling of key presses.",
      "display_zh": "解锁键盘",
      "display_en": "Unlock keyboard",
      "scriptName": "UnlockKeyboard",
      "category": "keyboard-lock",
      "params": []
    }
