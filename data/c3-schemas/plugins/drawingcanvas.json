    {
      "id": "save-image",
      "name_zh": "保存图像",
      "name_en": "Save image",
      "description_zh": "保存当前画布的图像。完成后触发 '图像保存完成' 条件，并使用 '图像保存地址' 表达式获取图像的地址。",
      "description_en": "Save the current canvas image. Use the 'On saved image' trigger and 'SavedImageURL' expression to get the result.",
      "display_zh": "保存图像 ({0}, 品质: [i]{1}[/i] 偏移: [i]{2}[/i], [i]{3}[/i] 大小: [i]{4}[/i] x [i]{5}[/i])",
      "display_en": "Save image ({0}, quality [i]{1}[/i], offset [i]{2}[/i], [i]{3}[/i] size [i]{4}[/i] x [i]{5}[/i])",
      "scriptName": "SaveImage",
      "category": "canvas",
      "params": [
        {
          "id": "format",
          "type": "combo",
          "name_en": "Format",
          "name_zh": "图像格式",
          "desc_en": "Choose the file format to save the image with. PNG is lossless but JPEG files are smaller.",
          "desc_zh": "选择要保存图像的文件格式。PNG是无损的，但JPEG文件更小。",
          "items": [
            "png",
            "jpeg"
          ],
          "items_i18n": {
            "png": {
              "en": "PNG",
              "zh": "PNG"
            },
            "jpeg": {
              "en": "JPEG",
              "zh": "JPEG"
            }
          }
        },
        {
          "id": "jpeg-quality",
          "type": "number",
          "name_en": "JPEG quality",
          "name_zh": "JPEG品质",
          "desc_en": "If 'Format' is 'JPEG', the JPEG quality from 0 (worst) to 100 (best). Ignored for PNG.",
          "desc_zh": "仅适用于 'JPEG' 图像格式，控制输出品质从 0 (最差) 到 100 (最好)，但品质越小图像则越模糊，设为 100 则无损输出。"
        },
        {
          "id": "x",
          "type": "number",
          "name_en": "X",
          "name_zh": "X",
          "desc_en": "The X offset of the area to snapshot, in canvas device pixels.",
          "desc_zh": "截取快照区域的X偏移量，基于设备画布像素。"
        },
        {
          "id": "y",
          "type": "number",
          "name_en": "Y",
          "name_zh": "Y",
          "desc_en": "The Y offset of the area to snapshot, in canvas device pixels.",
          "desc_zh": "截取快照区域的Y偏移量，基于设备画布像素。"
        },
        {
          "id": "width",
          "type": "number",
          "name_en": "Width",
          "name_zh": "宽度",
          "desc_en": "The width of the area to snapshot, in canvas device pixels. Leave 0 to use the full width.",
          "desc_zh": "截屏区域的宽度，以画布设备像素为单位，使用 0 则使用完整宽度。"
        },
        {
          "id": "height",
          "type": "number",
          "name_en": "Height",
          "name_zh": "高度",
          "desc_en": "The height of the area to snapshot, in canvas device pixels. Leave 0 to use the full height.",
          "desc_zh": "截屏区域的高度，以画布设备像素为单位，使用 0 则使用完整高度。"
        }
      ],
      "isAsync": true
    },
