{
  "id": "ninepatch",
  "originalId": "NinePatch",
  "name_zh": "九宫图",
  "name_en": "9-patch",
  "description_zh": "将图像分割为9个部分，使边缘和中间填充部分可以单独拉伸或平铺。对制作气泡型对话框很有帮助。",
  "description_en": "Create resizable boxes with an image border by splitting an image in to nine tiles.",
  "plugin_type": "plugin",
  "aceCategories": [
    "appearance",
    "web"
  ],
  "conditions": [
    {
      "id": "on-image-url-loaded",
      "name_zh": "远程图像加载完成",
      "name_en": "On image URL loaded",
      "description_zh": "使用 '加载远程图像' 动作后，当图像从远程服务器加载完成时触发。",
      "description_en": "Triggered after 'Load image from URL' when the image has finished loading.",
      "display_zh": "远程图像加载完成",
      "display_en": "On image URL loaded",
      "scriptName": "OnURLLoaded",
      "category": "web",
      "params": [],
      "isTrigger": true
    },
    {
      "id": "on-image-url-failed",
      "name_zh": "图像加载失败",
      "name_en": "On image URL failed",
      "description_zh": "执行 '加载网络图像' 动作后，图像加载失败时触发。",
      "description_en": "Triggered after 'Load image from URL' if the image fails to load.",
      "display_zh": "网络图像加载失败",
      "display_en": "On image URL failed to load",
      "scriptName": "OnURLFailed",
      "category": "web",
      "params": [],
      "isTrigger": true
    }
  ],
