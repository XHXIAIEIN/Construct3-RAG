{
  "id": "pin",
  "name": "固定",
  "description": "与另一个对象保持相对的距离和角度。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-pinned",
      "scriptName": "IsPinned",
      "category": "",
      "list-name": "已固定",
      "display-text": "{my} 已固定",
      "description": "检查对象当前是否已被固定到另一个对象。"
    },
    {
      "id": "will-destroy",
      "scriptName": "WillDestroy",
      "category": "",
      "list-name": "与被固定的对象一起被销毁",
      "display-text": "{my} 与被固定对象一起销毁",
      "description": "如果被固定的对象被销毁时，该对象也将被销毁。"
    }
  ],
  "actions": [
    {
      "id": "pin-to-object",
      "scriptName": "Pin",
      "category": "",
      "list-name": "固定在对象",
      "display-text": "固定 {my} 到 {0} ({1})",
      "description": "把对象固定另一个对象上",
      "params": {
        "pin-to": {
          "type": "object",
          "name": "钉在",
          "desc": "选择固定的对象"
        },
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "选择要更改的对象属性。",
          "items": {
            "position-angle": "位置与角度",
            "position-only": "仅位置",
            "angle-only": "仅角度",
            "rope-style": "绳索方式",
            "bar-style": "小节方式"
          }
        }
      }
    },
    {
      "id": "pin-to-object-distance",
      "scriptName": "PinByDistance",
      "category": "",
      "list-name": "固定到距离",
      "display-text": "{my} 固定到 {0} (模式: {1})",
      "description": "通过限制对象到另一个对象的距离来将该对象固定到另一个对象上。",
      "params": {
        "pin-to": {
          "type": "object",
          "name": "固定到",
          "desc": "选择要固定到哪个对象"
        },
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "选择一种限制距离的方式",
          "items": {
            "rope-style": "锁链(最大距离)",
            "bar-style": "条形(固定距离)"
          }
        }
      }
    },
    {
      "id": "pin-to-object-properties",
      "scriptName": "PinByProperties",
      "category": "",
      "list-name": "固定到对象",
      "display-text": "{my} 固定到 {0} (X: [i]{1}[/i], Y: [i]{2}[/i], 角度: [i]{3}[/i], 宽度: [i]{4}[/i], 高度: [i]{5}[/i], Z: [i]{6}[/i])",
      "description": "将对象固定到另一个对象上。",
      "params": {
        "pin-to": {
          "type": "object",
          "name": "固定到",
          "desc": "选择要固定到哪个对象"
        },
        "x": {
          "type": "boolean",
          "name": "X",
          "desc": "固定对象的X坐标。"
        },
        "y": {
          "type": "boolean",
          "name": "Y",
          "desc": "固定对象的Y坐标。"
        },
        "angle": {
          "type": "boolean",
          "name": "角度",
          "desc": "固定对象的角度。"
        },
        "width-type": {
          "type": "combo",
          "name": "宽度",
          "desc": "固定的对象宽度改变时，如何设置对象的宽度。相同的变化值，或相对比例。",
          "items": {
            "no": "关闭",
            "absolute": "相同",
            "scale": "比例"
          }
        },
        "height-type": {
          "type": "combo",
          "name": "高度",
          "desc": "固定的对象高度改变时，如何设置对象的高度。相同的变化值，或相对比例。",
          "items": {
            "no": "关闭",
            "absolute": "相同",
            "scale": "比例"
          }
        },
        "z": {
          "type": "boolean",
          "name": "视距高度",
          "desc": "固定到对象的Z轴视距位置。"
        }
      }
    },
    {
      "id": "pin-to-object-imagepoint",
      "scriptName": "PinByImagePoint",
      "category": "",
      "list-name": "固定到图像点",
      "display-text": "{my} 固定到 {0} (图像点 [i]{1}[/i], 角度:[i]{2}[/i], 宽度:[i]{3}[/i], 高度: [i]{4}[/i], Z: [i]{5}[/i])",
      "description": "将对象固定到另一个对象的图像点上。",
      "params": {
        "pin-to": {
          "type": "object",
          "name": "固定到",
          "desc": "选择要固定到哪个对象"
        },
        "image-point": {
          "type": "any",
          "name": "图像点",
          "desc": "要定位到的对象的图像点名称或编号。"
        },
        "angle": {
          "type": "boolean",
          "name": "角度",
          "desc": "固定对象的角度。"
        },
        "width-type": {
          "type": "combo",
          "name": "宽度",
          "desc": "固定的对象宽度改变时，如何设置对象的宽度。相同的变化值，或相对比例。",
          "items": {
            "no": "关闭",
            "absolute": "相同",
            "scale": "比例"
          }
        },
        "height-type": {
          "type": "combo",
          "name": "高度",
          "desc": "固定的对象高度改变时，如何设置对象的高度。相同的变化值，或相对比例。",
          "items": {
            "no": "关闭",
            "absolute": "相同",
            "scale": "比例"
          }
        },
        "z": {
          "type": "boolean",
          "name": "视距高度",
          "desc": "固定到对象的视距高度。"
        }
      }
    },
    {
      "id": "set-pin-distance",
      "scriptName": "SetPinDistance",
      "category": "",
      "list-name": "设置固定距离",
      "display-text": "设置 {my} 固定距离 [i]{0}[/i]",
      "description": "使用'固定到距离'时，设置距离限制。",
      "params": {
        "distance": {
          "type": "number",
          "name": "距离",
          "desc": "设置的距离限制，以像素为单位。"
        }
      }
    },
    {
      "id": "set-destroy",
      "scriptName": "SetDestroy",
      "category": "",
      "list-name": "设置与固定的对象一起被销毁",
      "display-text": "设置 {my}与被固定对象一起销毁 [i]{0}[/i]",
      "description": "设置固定的对象被销毁时，是否也将该对象销毁。",
      "params": {
        "destroy": {
          "type": "boolean",
          "name": "与被固定的对象一起被销毁",
          "desc": "固定的对象被销毁时，是否也将该对象销毁。"
        }
      }
    },
    {
      "id": "unpin",
      "scriptName": "Unpin",
      "category": "",
      "list-name": "解除固定",
      "display-text": "{my} 取消固定",
      "description": "解除固定到其他对象。"
    }
  ],
  "expressions": [
    {
      "id": "pinneduid",
      "scriptName": "PinnedUID",
      "category": "",
      "translated-name": "固定对象UID",
      "description": "获得当前被固定对象的UID，如果没有，则返回 -1",
      "returnType": "number"
    }
  ],
  "properties": {
    "destroy": {
      "name": "与被固定的对象一起被销毁",
      "desc": "如果被固定的对象被销毁时，该对象也将被销毁。"
    }
  }
}