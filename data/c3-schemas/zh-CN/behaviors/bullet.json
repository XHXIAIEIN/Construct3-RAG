        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "速度值，以像素/秒为单位，并与当前的速度值进行比较。"
        }
      }
    },
    {
      "id": "compare-distance-travelled",
      "scriptName": "CompareTravelled",
