      "display-text": "{my} 移动距离 {0} {1}",
      "description": "比较子弹对象的移动距离。比较子弹累计经过的移动距离。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
