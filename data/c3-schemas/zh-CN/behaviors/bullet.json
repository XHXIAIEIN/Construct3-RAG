        "distance": {
          "type": "number",
          "name": "距离",
          "desc": "要比较的移动距离，以像素为单位。"
        }
      }
    },
    {
      "id": "on-step",
      "scriptName": "OnStep",
      "category": "",
      "list-name": "触发步进",
      "display-text": "{my} 步进",
