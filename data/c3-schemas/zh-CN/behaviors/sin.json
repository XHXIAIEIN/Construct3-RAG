{
  "id": "sin",
  "name": "正弦运动",
  "description": "根据正弦曲线的波形变化，调整对象的相关属性，用来创造一些有趣的视觉效果。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-active",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my}已启用",
      "description": "当前已启用移动方式时触发。"
    },
    {
      "id": "compare-movement",
      "scriptName": "CompareMovement",
      "category": "",
      "list-name": "比较运动类型",
      "display-text": "{my} 运动类型是{0}",
      "description": "比较当前的正弦运动属性",
      "params": {
        "movement": {
          "type": "combo",
          "name": "运动类型",
          "desc": "选择要比较的运动属性",
          "items": {
            "horizontal": "左右",
            "vertical": "上下",
            "size": "大小",
            "width": "宽度",
            "height": "高度",
            "angle": "角度",
            "opacity": "不透明度",
            "value-only": "数值",
            "forwardsbackwards": "前后",
            "z-elevation": "视距高度"
          }
        }
      }
    },
    {
      "id": "compare-period",
      "scriptName": "ComparePeriod",
      "category": "",
      "list-name": "比较周期",
      "display-text": "{my} 周期 {0} {1}",
      "description": "比较当前的振荡周期，以秒为单位。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "用于比较周期的值，以秒为单位。"
        }
      }
    },
    {
      "id": "compare-magnitude",
      "scriptName": "CompareMagnitude",
      "category": "",
      "list-name": "比较振幅",
      "display-text": "{my} 振幅 {0} {1}",
      "description": "比较振幅的强度大小。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "比较振幅的值"
        }
      }
    },
    {
      "id": "compare-wave",
      "scriptName": "CompareWave",
      "category": "",
      "list-name": "比较波形",
      "display-text": "设置 {my}波形类型为[b]{0}[/b]",
      "description": "比较当前的波形函数类型。",
      "params": {
        "wave": {
          "type": "combo",
          "name": "波形",
          "desc": "选择要比较的波形类型",
