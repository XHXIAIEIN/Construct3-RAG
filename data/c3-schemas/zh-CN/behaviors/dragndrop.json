{
  "id": "dragndrop",
  "name": "拖放",
  "description": "通过鼠标或触摸拖放对象",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-dragging",
      "scriptName": "IsDragging",
      "category": "",
      "list-name": "正在拖动",
      "display-text": "{my} 正在拖动",
      "description": "检测对象是否正处于被拖动状态中。"
    },
    {
      "id": "on-drag-start",
      "scriptName": "OnDragStart",
      "category": "",
      "list-name": "开始拖动",
      "display-text": "{my} 开始拖动",
      "description": "当对象处于拖动中触发",
      "isTrigger": true
    },
    {
      "id": "on-drop",
      "scriptName": "OnDrop",
      "category": "",
      "list-name": "结束拖动",
      "display-text": "{my} 结束拖动",
      "description": "当对象被放下时触发，即拖动效果结束，手势或鼠标松开。",
      "isTrigger": true
    },
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "检测此行为是否已启用。"
    }
  ],
  "actions": [
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "{0} {my}",
      "description": "启用或禁用拖放行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "启用或禁用此行为。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "set-axes",
      "scriptName": "SetAxes",
      "category": "",
      "list-name": "设置拖动方向",
      "display-text": "设置{my}的拖动方向为 [b]{0}[/b]",
      "description": "设置可被拖动的方向。",
      "params": {
        "axes": {
          "type": "combo",
          "name": "拖动方向",
          "desc": "选择可被拖动的方向。",
          "items": {
            "both": "无限制",
            "horizontal-only": "仅水平方向",
            "vertical-only": "仅垂直方向"
          }
        }
      }
    },
    {
      "id": "drop",
      "scriptName": "Drop",
      "category": "",
      "list-name": "放下",
      "display-text": "放下 {my}",
      "description": "如果当前正在拖动，强制放下此对象。"
    }
  ],
  "expressions": [],
  "properties": {
    "axes": {
      "name": "拖动方向",
      "desc": "选择可拖动的方向，例如仅允许水平或垂直方向拖动对象。",
      "items": {
        "both": "无限制",
        "horizontal-only": "仅水平方向",
        "vertical-only": "仅垂直方向"
      }
    },
    "enabled": {
      "name": "启用",
      "desc": "游戏初始化时，是否默认启用该行为。"
    }
  }
}