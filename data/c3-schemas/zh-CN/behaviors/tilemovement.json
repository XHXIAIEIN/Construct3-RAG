{
  "id": "tilemovement",
  "name": "网格移动",
  "description": "在2D网格中移动对象。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-moving",
      "scriptName": "IsMoving",
      "category": "",
      "list-name": "正在移动",
      "display-text": "{my} 正在移动",
      "description": "检测对象是否正在移动。"
    },
    {
      "id": "is-moving-direction",
      "scriptName": "IsMovingDirection",
      "category": "",
      "list-name": "正在朝方向移动",
      "display-text": "{my} [b]{0}[/b]移动",
      "description": "检测对象当前是否沿着指定方向移动。",
      "params": {
        "direction": {
          "type": "combo",
          "name": "方向",
          "desc": "移动的方向。",
          "items": {
            "right": "向右",
            "left": "向左",
            "down": "向下",
            "up": "向上"
          }
        }
      }
    },
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "测试行为是否已经启用。"
    },
    {
      "id": "can-move-to",
      "scriptName": "CanMoveTo",
      "category": "",
      "list-name": "可以移动到位置",
      "display-text": "{my}可以移动到[b]({0},{1})[/b]",
      "description": "检测对象是否可以移动到网格位置。",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要进行检测的网格列。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要进行检测的网格行。"
        }
      }
    },
    {
      "id": "can-move-direction",
      "scriptName": "CanMoveDirection",
      "category": "",
      "list-name": "可移动的方向",
      "display-text": "{my} 可以[b]{0}[/b]移动 [b]{1}[/b]格",
      "description": "测试物体是否能沿着指定方向移动一段距离，并检查沿途是否存在障碍物。",
      "params": {
        "direction": {
          "type": "combo",
          "name": "方向",
          "desc": "移动的方向。",
          "items": {
            "right": "向右",
            "left": "向左",
            "down": "向下",
            "up": "向上"
          }
        },
        "distance": {
          "type": "number",
          "name": "距离",
          "desc": "移动的距离"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-speed",
      "scriptName": "SetSpeed",
      "category": "",
      "list-name": "设置速度",
      "display-text": "设置 {my}移动速度为[i]({0},{1})[/i]",
      "description": "设置移动速度",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "设置水平方向移动速度，以每秒像素为单位。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "设置垂直方向移动速度，以每秒像素为单位。"
        }
      }
    },
    {
      "id": "set-ignoring-input",
      "scriptName": "SetIgnoreInput",
      "category": "",
      "list-name": "屏蔽玩家控制",
      "display-text": "{0}控制 {my}",
      "description": "是否屏蔽玩家对该对象移动的控制行为。",
      "params": {
        "input": {
          "type": "combo",
          "name": "输入",
          "desc": "是否屏蔽玩家对该对象移动的控制行为。",
          "items": {
            "stop-ignoring": "结束屏蔽",
            "start-ignoring": "开始忽略"
          }
        }
      }
    },
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "[b]{0}[/b] {my}",
      "description": "启用或禁用此行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "设置是否启用或禁用该行为。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "simulate-control",
      "scriptName": "SimulateControl",
      "category": "",
      "list-name": "模拟控制",
      "display-text": "控制 {my} {0}",
      "description": "通过事件模拟玩家按下按键来控制角色的行动。",
      "params": {
        "control": {
          "type": "combo",
          "name": "控制",
          "desc": "模拟玩家按下按键来控制角色行动。",
          "items": {
            "left": "向左移动",
            "right": "向右移动",
            "up": "向上移动",
            "down": "向下移动"
          }
        }
      }
    },
    {
      "id": "set-grid-position",
      "scriptName": "SetGridPosition",
      "category": "",
      "list-name": "设置网格位置",
      "display-text": "设置 {my}网格位置 {2} [i]({0},{1})[/i]",
      "description": "设置对象的网格位置",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要移动到的列。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要移动到的行。"
        },
        "instant": {
          "type": "combo",
          "name": "方式",
          "desc": "选择立即将对象移动到该位置，还是正常移动。",
          "items": {
            "animate": "持续移动",
            "instant": "瞬间到达"
          }
        }
      }
    },
    {
      "id": "set-grid-dimensions",
      "scriptName": "SetGridDimensions",
      "category": "",
      "list-name": "设置网格尺寸",
      "display-text": "设置 {my}网格尺寸为[b]({0},{1})[/b], 偏移[i]({2},{3})[/i]",
      "description": "设置对象的网格大小和偏移量。",
      "params": {
        "width": {
          "type": "number",
          "name": "宽度",
          "desc": "设置每列的宽度。"
        },
        "height": {
          "type": "number",
          "name": "高度",
          "desc": "设置每行的高度。"
        },
        "x-offset": {
          "type": "number",
          "name": "X 偏移",
          "desc": "要设置的 X 轴偏移。"
        },
        "y-offset": {
          "type": "number",
          "name": "Y 偏移",
          "desc": "要设置的 Y 轴偏移。"
        }
      }
    },
    {
      "id": "set-default-controls",
      "scriptName": "SetDefaultControls",
      "category": "",
      "list-name": "启用默认控制方式",
      "display-text": "[b]{0}[/b] {my} 默认控制方式",
      "description": "开启后，默认允许通过键盘方向键进行控制。",
      "params": {
        "default-controls": {
          "type": "boolean",
          "name": "默认的控制方式",
          "desc": "启用后，默认允许使用方向键控制移动。否则，只能通过 '模拟控制' 来操控。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "grid-x",
      "scriptName": "GridX",
      "category": "",
      "translated-name": "网格X",
      "description": "对象当前所在的网格列。",
      "returnType": "number"
    },
    {
      "id": "grid-y",
      "scriptName": "GridY",
      "category": "",
      "translated-name": "网格Y",
      "description": "对象当前所在的网格行。",
      "returnType": "number"
    },
    {
      "id": "speed-x",
      "scriptName": "SpeedX",
      "category": "",
      "translated-name": "速度X",
      "description": "当前水平方向的移动速度，以像素/秒为单位。",
      "returnType": "number"
    },
    {
      "id": "speed-y",
      "scriptName": "SpeedY",
      "category": "",
      "translated-name": "速度Y",
      "description": "当前垂直方向的移动速度，以像素/秒为单位。",
      "returnType": "number"
    },
    {
      "id": "target-x",
      "scriptName": "TargetX",
      "category": "",
      "translated-name": "目标X",
      "description": "对象当前朝向的网格列的场景坐标。",
      "returnType": "number"
    },
    {
      "id": "target-y",
      "scriptName": "TargetY",
      "category": "",
      "translated-name": "目标Y",
      "description": "对象当前朝向的网格行的场景坐标。",
      "returnType": "number"
    },
    {
      "id": "target-grid-x",
      "scriptName": "GridTargetX",
      "category": "",
      "translated-name": "网格目标X",
      "description": "对象当前朝向的网格列。",
      "returnType": "number"
    },
    {
      "id": "target-grid-y",
      "scriptName": "GridTargetY",
      "category": "",
      "translated-name": "网格目标Y",
      "description": "对象当前朝向的网格行。",
      "returnType": "number"
    }
  ],
  "properties": {
    "grid-width": {
      "desc": "移动网格的宽度。",
      "name": "网格宽度"
    },
    "grid-height": {
      "desc": "移动网格的高度。",
      "name": "网格高度"
    },
    "speed-x": {
      "name": "移动速度 X",
      "desc": "在X轴的移动速度，以像素/秒为单位。"
    },
    "speed-y": {
      "name": "移动速度 Y",
      "desc": "在Y轴的移动速度，以像素/秒为单位。"
    },
    "enabled": {
      "name": "启用",
      "desc": "游戏初始化时，是否默认启用该行为。"
    },
    "default-controls": {
      "desc": "启用后，默认允许使用方向键控制移动。否则，只能通过 '模拟控制 '来操控。",
      "name": "默认的控制方式"
    },
    "isometric": {
      "name": "等距移动",
      "desc": "使用等距网格或是笛卡尔网格。"
    },
    "grid-offset-x": {
      "name": "网格偏移 X",
      "desc": "在X轴网格移动的偏移量。"
    },
    "grid-offset-y": {
      "name": "网格偏移 Y",
      "desc": "在Y轴网格移动的偏移量。"
    }
  }
}