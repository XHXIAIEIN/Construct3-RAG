{
  "id": "los",
  "name": "视线",
  "description": "让对象可以看见某个位置或其他对象。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "has-los-to-object",
      "scriptName": "HasLOSToObject",
      "category": "",
      "list-name": "发现对象",
      "display-text": "{my} 可发现 {0} 图像点[i]{1}[/i]",
      "description": "测试在视线范围内，可否看到某个对象。",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查能否被视线看到的对象。"
        },
        "image-point": {
          "type": "any",
          "name": "图像点 (可选)",
          "desc": "检查视线对象是否能发现另一个对象的图像点，可指定图像点的名称或编号。保留 0 为对象的图像原点。"
        }
      }
    },
    {
      "id": "has-los-to-position",
      "scriptName": "HasLOSToPosition",
      "category": "",
      "list-name": "发现位置",
      "display-text": "{my} 可发现位置 (目标: [i]{0}[/i], [i]{1}[/i])",
      "description": "检测对象是否拥有场景的某个位置的视线。",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要检查是否拥有视线的X坐标，以像素为单位。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要检查是否拥有视线的Y坐标，以像素为单位。"
        }
      }
    },
    {
      "id": "has-los-between-positions",
      "scriptName": "HasLOSBetweenPositions",
      "category": "",
      "list-name": "发现位置 (范围)",
      "display-text": "{my} 可发现位置 (起始: ([i]{0}[/i], [i]{1}[/i]),  方向: [i]{2}[/i], 终点: [i]{3}[/i], [i]{4}[/i])",
      "description": "检测在场景任意 2 个位置之间，是否存在视线。",
      "params": {
        "from-x": {
          "type": "number",
          "name": "起始 X",
          "desc": "用于检测视线的第1个X坐标。"
        },
        "from-y": {
          "type": "number",
          "name": "起始 Y",
          "desc": "用于检测视线的第1个Y坐标。"
        },
        "from-angle": {
          "type": "number",
          "name": "角度",
          "desc": "用来确定视线方向的角度。"
        },
        "to-x": {
          "type": "number",
          "name": "终点 X",
          "desc": "用于检测视线的第2个X坐标。"
        },
        "to-y": {
          "type": "number",
          "name": "终点 Y",
          "desc": "用于检测视线的第2个Y坐标。"
        }
      }
    },
    {
      "id": "ray-intersected",
      "scriptName": "RayIntersected",
      "category": "",
      "list-name": "发现障碍物",
      "display-text": "{my}发现障碍",
      "description": "检查上次发出的射线是否命中障碍物。"
    }
  ],
  "actions": [
    {
      "id": "set-range",
      "scriptName": "SetRange",
      "category": "",
      "list-name": "设置视线范围",
      "display-text": "设置 {my}视线范围为[i]{0}[/i]",
      "description": "设置视线能覆盖的最远距离，以像素为单位。",
      "params": {
        "range": {
          "type": "number",
          "name": "范围",
          "desc": "视线能覆盖的最远距离，以像素为单位。"
        }
      }
    },
    {
      "id": "set-cone-of-view",
      "scriptName": "SetCone",
      "category": "",
      "list-name": "设置视线角度",
      "display-text": "设置 {my}视线角度为[i]{0}[/i]°",
      "description": "设置视线在当前朝向能够覆盖的角度范围，以角度为单位。",
      "params": {
        "cone-of-view": {
          "type": "number",
          "name": "角度",
          "desc": "视线在朝向能够覆盖的角度范围，以角度为单位。"
        }
      }
    },
    {
      "id": "add-obstacle",
      "scriptName": "AddObstacle",
      "category": "",
      "list-name": "添加遮挡物",
      "display-text": "{my}添加 {0} 视为遮挡物",
      "description": "添加自定义对象作为视线遮挡物。",
      "params": {
        "obstacle": {
          "type": "object",
          "name": "遮挡物",
          "desc": "选择一个对象视为遮挡物，阻挡视线。"
        }
      }
    },
    {
      "id": "clear-obstacles",
      "scriptName": "ClearObstacles",
      "category": "",
      "list-name": "清空障碍",
      "display-text": "{my} 清空全部障碍",
      "description": "删除所有已添加的障碍。"
    },
    {
      "id": "cast-ray",
      "scriptName": "CastRay",
      "category": "",
      "list-name": "发出射线",
      "display-text": "{my} 发出射线 (起始位置: ({0}, {1}), 目标位置: ({2}, {3}), 使用碰撞单元: [i]{4}[/i])",
      "description": "在任意两个坐标位置之间投出射线，检查是否有障碍物。",
      "params": {
        "from-x": {
          "type": "number",
          "name": "起始 X",
          "desc": "用于检测视线的第1个X坐标。"
        },
        "from-y": {
          "type": "number",
          "name": "起始 Y",
          "desc": "用于检测视线的第1个Y坐标。"
        },
        "to-x": {
          "type": "number",
          "name": "目标 X",
          "desc": "用于检测视线的第2个X坐标。"
        },
        "to-y": {
          "type": "number",
          "name": "目标 Y",
          "desc": "用于检测视线的第2个Y坐标。"
        },
        "use-collision-cells": {
          "type": "boolean",
          "name": "使用碰撞单元",
          "desc": "启用此选项通常可以提升性能，但在检查较远的距离时，反而导致性能变慢。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "range",
      "scriptName": "Range",
      "category": "",
      "translated-name": "视线范围",
      "description": "返回视线当前的范围，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "coneofview",
      "scriptName": "ConeOfView",
      "category": "",
      "translated-name": "视线角度",
      "description": "返回视线当前的覆盖角度，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "hitx",
      "scriptName": "HitX",
      "category": "",
      "translated-name": "相交点X",
      "description": "视线击中目标时，返回相交位置的X坐标。",
      "returnType": "number"
    },
    {
      "id": "hity",
      "scriptName": "HitY",
      "category": "",
      "translated-name": "相交点Y",
      "description": "视线击中目标时，返回相交位置的Y坐标。",
      "returnType": "number"
    },
    {
      "id": "hituid",
      "scriptName": "HitUID",
      "category": "",
      "translated-name": "相交实例UID",
      "description": "视线击中目标时，返回相交的实例对象UID。",
      "returnType": "number"
    },
    {
      "id": "hitdistance",
      "scriptName": "HitDistance",
      "category": "",
      "translated-name": "相交距离",
      "description": "视线击中目标时，返回视线原点和相交位置的距离。",
      "returnType": "number"
    },
    {
      "id": "normalx",
      "scriptName": "NormalX",
      "category": "",
      "translated-name": "法线X",
      "description": "视线击中目标后，返回命中沿法线延长指定距离位置的X坐标。",
      "params": {
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要沿法线延长的距离。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "normaly",
      "scriptName": "NormalY",
      "category": "",
      "translated-name": "法线Y",
      "description": "视线击中目标后，返回命中沿法线延长指定距离位置的Y坐标。",
      "params": {
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要沿法线延长的距离。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "normalangle",
      "scriptName": "NormalAngle",
      "category": "",
      "translated-name": "法线角度",
      "description": "视线击中目标后，返回命中位置表面法线的角度。",
      "returnType": "number"
    },
    {
      "id": "reflectionx",
      "scriptName": "ReflectionX",
      "category": "",
      "translated-name": "反射线X",
      "description": "视线击中目标后，返回沿法线反射角度指定距离位置的X坐标。",
      "params": {
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要沿反射法线延长的距离。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "reflectiony",
      "scriptName": "ReflectionY",
      "category": "",
      "translated-name": "反射线Y",
      "description": "视线击中目标后，返回沿法线反射角度指定距离位置的Y坐标。",
      "params": {
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要沿反射法线延长的距离。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "reflectionangle",
      "scriptName": "ReflectionAngle",
      "category": "",
      "translated-name": "反射角度",
      "description": "视线击中目标后，返回命中位置反射的绝对角度。",
      "returnType": "number"
    }
  ],
  "properties": {
    "obstacles": {
      "name": "遮挡物",
      "desc": "选择哪些对象可以被视线对象识别为遮挡物，阻挡视线。选择 '自定义' 将由事件添加。",
      "items": {
        "solids": "实体",
        "custom": "自定义"
      }
    },
    "range": {
      "name": "范围",
      "desc": "视线能覆盖的最远距离，以像素为单位。"
    },
    "cone-of-view": {
      "name": "角度",
      "desc": "视线在朝向能覆盖的角度范围，以角度为单位。"
    },
    "use-collision-cells": {
      "name": "使用碰撞单元",
      "desc": "启用此选项通常可以提升性能，若目标在距离很远的地方，性能反而会变慢。"
    }
  }
}