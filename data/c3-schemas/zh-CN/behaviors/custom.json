{
  "id": "custom",
  "name": "自定义移动",
  "description": "使用最底层的移动方式，执行自定义移动功能。",
  "type": "behavior",
  "aceCategories": {
    "angle-of-motion": "运动角度",
    "velocity": "速度"
  },
  "conditions": [
    {
      "id": "is-moving",
      "scriptName": "IsMoving",
      "category": "",
      "list-name": "正在移动",
      "display-text": "{my} 正在移动",
      "description": "检测对象是否正在移动。"
    },
    {
      "id": "compare-speed",
      "scriptName": "CompareSpeed",
      "category": "",
      "list-name": "比较移动速度",
      "display-text": "{my} {0}速度 {1} {2}",
      "description": "比较对象的当前速度。",
      "params": {
        "which": {
          "type": "combo",
          "name": "比较",
          "desc": "选择要进行比较的速度",
          "items": {
            "overall": "总体",
            "horizontal": "水平方向",
            "vertical": "垂直方向"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "要进行比较的速度，以像素/秒为单位。"
        }
      }
    },
    {
      "id": "on-step",
      "scriptName": "OnCMStep",
      "category": "",
      "list-name": "触发步进",
      "display-text": "{my} 触发步进",
      "description": "对象进行步进运动时触发。",
      "isTrigger": true
    },
    {
      "id": "on-horizontal-step",
      "scriptName": "OnCMHorizStep",
      "category": "",
      "list-name": "向水平方向步进",
      "display-text": "{my} 向水平方向步进",
      "description": "对象在水平方向进行步进移动时触发。",
      "isTrigger": true
    },
    {
      "id": "on-vertical-step",
      "scriptName": "OnCMVertStep",
      "category": "",
      "list-name": "向垂直方向步进",
      "display-text": "{my} 向垂直方向步进",
      "description": "对象在垂直方向进行步进移动时触发。",
      "isTrigger": true
    },
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "检测当前行为是否已启用。"
    }
  ],
  "actions": [
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "[b]{0}[/b] {my}",
      "description": "启用或禁用此行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "启用或禁用此行为。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "set-angle-of-motion",
      "scriptName": "SetAngleOfMotion",
      "category": "angle-of-motion",
      "list-name": "设置移动角度",
      "display-text": "设置 {my}移动角度为[i]{0}[/i]°",
      "description": "设置对象当前正在移动的角度的角度。",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "设置移动角度，以角度为单位。"
        }
      }
    },
    {
      "id": "rotate-clockwise",
      "scriptName": "RotateAngleOfMotionClockwise",
      "category": "angle-of-motion",
      "list-name": "顺时针旋转",
      "display-text": "{my} 顺时针旋转[i]{0}[/i]°",
      "description": "将运动角度进行顺时针旋转",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "顺时针旋转角度，以度数为单位。"
        }
      }
    },
    {
      "id": "rotate-counter-clockwise",
      "scriptName": "RotateAngleOfMotionCounterClockwise",
      "category": "angle-of-motion",
      "list-name": "逆时针旋转",
      "display-text": "{my} 逆时针旋转[i]{0}[/i]°",
      "description": "将运动角度进行逆时针旋转",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "逆时针旋转的角度，以度数为单位。"
        }
      }
    },
    {
      "id": "stop",
      "scriptName": "Stop",
      "category": "velocity",
      "list-name": "停止",
      "display-text": "停止 {my}",
      "description": "设置速度为0"
    },
    {
      "id": "reverse",
      "scriptName": "Reverse",
      "category": "velocity",
      "list-name": "反转",
      "display-text": "反转{my} ({0})",
      "description": "进行反向移动",
      "params": {
        "axes": {
          "type": "combo",
          "name": "坐标轴",
          "desc": "选择要翻转的坐标轴",
          "items": {
            "both": "全部",
            "horizontally": "水平",
            "vertically": "垂直"
          }
        }
      }
    },
    {
      "id": "set-speed",
      "scriptName": "SetSpeed",
      "category": "velocity",
      "list-name": "设置速度",
      "display-text": "设置 {my}{0}速度为[i]{1}[/i]",
      "description": "设置对象当前运动速度",
      "params": {
        "which": {
          "type": "combo",
          "name": "选择",
          "desc": "选择要设置的速度",
          "items": {
            "overall": "整体",
            "horizontal": "水平方向",
            "vertical": "垂直方向"
          }
        },
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "设置对象的新速度，以像素/秒为单位。"
        }
      }
    },
    {
      "id": "accelerate",
      "scriptName": "Accelerate",
      "category": "velocity",
      "list-name": "加速",
      "display-text": "{my}{0}加速 (加速度: [i]{1}[/i])",
      "description": "让对象向前或沿轴方向加速。",
      "params": {
        "which": {
          "type": "combo",
          "name": "选择",
          "desc": "选择加速的方式",
          "items": {
            "forwards": "向前",
            "horizontally": "水平方向",
            "vertically": "垂直方向"
          }
        },
        "acceleration": {
          "type": "number",
          "name": "加速",
          "desc": "从静止状态到正常移动速度的加速度，以像素/秒为单位。"
        }
      }
    },
    {
      "id": "accelerate-toward-angle",
      "scriptName": "AccelerateAngle",
      "category": "velocity",
      "list-name": "朝角度加速",
      "display-text": "{my} 朝角度加速 (加速度: [i]{0}[/i], 角度: [i]{1}[/i]°)",
      "description": "使对象向指定角度的方向加速移动。",
      "params": {
        "acceleration": {
          "type": "number",
          "name": "加速度",
          "desc": "从静止状态到正常移动速度的加速度，以像素/秒为单位。"
        },
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "向前加速移动的角度，以度数为单位。"
        }
      }
    },
    {
      "id": "accelerate-toward-position",
      "scriptName": "AcceleratePos",
      "category": "velocity",
      "list-name": "朝位置加速",
      "display-text": "{my} 朝位置加速 (加速度: [i]{0}[/i], 目标: [i]{1}[/i], [i]{2}[/i])",
      "description": "使对象向指定位置加速移动。",
      "params": {
        "acceleration": {
          "type": "number",
          "name": "加速度",
          "desc": "从静止状态到正常移动速度的加速度，以像素/秒为单位。"
        },
        "x": {
          "type": "number",
          "name": "X",
          "desc": "朝向场景X轴方向加速。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "朝向场景Y轴方向加速。"
        }
      }
    },
    {
      "id": "stop-stepping",
      "scriptName": "StopStepping",
      "category": "velocity",
      "list-name": "停止步进",
      "display-text": "{my} 停止步进 ({0})",
      "description": "停止当前的步进模式，防止在这一帧触发更多的步进。",
      "params": {
        "position": {
          "type": "combo",
          "name": "位置",
          "desc": "选择生成的对象位置",
          "items": {
            "go-back-a-step": "上一次步进位置",
            "stay-at-current-position": "停留在当前位置"
          }
        }
      }
    },
    {
      "id": "push-out-solid",
      "scriptName": "PushOutSolid",
      "category": "velocity",
      "list-name": "推开实体",
      "display-text": "撞击到 {0} 后推开 {my}",
      "description": "此对象与具有 '实体' 的对象发生重叠时，将此对象朝向指定的方向推开。",
      "params": {
        "direction": {
          "type": "combo",
          "name": "方向",
          "desc": "选择推开的方式",
          "items": {
            "opposite-angle": "相反的角度",
            "nearest": "最近的方向",
            "up": "向上",
            "down": "向下",
            "left": "向左",
            "right": "向右"
          }
        }
      }
    },
    {
      "id": "push-out-solid-at-angle",
      "scriptName": "PushOutSolidAngle",
      "category": "velocity",
      "list-name": "推开实体 (角度)",
      "display-text": "撞击到实体时朝 {0}° 推开{my}",
      "description": "此对象与具有 '实体' 的对象发生重叠时，将此对象朝向指定的角度方向推开。",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "将对象反弹的角度。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "speed",
      "scriptName": "Speed",
      "category": "",
      "translated-name": "移动速度",
      "description": "当前对象的移动速度，以像素/秒为单位。",
      "returnType": "number"
    },
    {
      "id": "movingangle",
      "scriptName": "MovingAngle",
      "category": "",
      "translated-name": "移动角度",
      "description": "当前的移动方向，以度数为单位。",
      "returnType": "number"
    },
    {
      "id": "dx",
      "scriptName": "dx",
      "category": "",
      "translated-name": "移动速度X",
      "description": "当前在水平方向移动速度，以像素/秒为单位。",
      "returnType": "number"
    },
    {
      "id": "dy",
      "scriptName": "dy",
      "category": "",
      "translated-name": "移动速度Y",
      "description": "当前在垂直方向的移动速度，以像素/秒为单位。",
      "returnType": "number"
    }
  ],
  "properties": {
    "stepping-mode": {
      "name": "步进模式",
      "desc": "触发 '步进' 条件后，以增量移动。",
      "items": {
        "none": "无",
        "linear": "线性",
        "horizontal-then-vertical": "水平方向优先",
        "vertical-then-horizontal": "垂直方向优先"
      }
    },
    "pixels-per-step": {
      "name": "像素/步进",
      "desc": "启用步进时，每一步移动的像素数量。"
    },
    "enabled": {
      "name": "启用",
      "desc": "游戏初始化时，是否默认启用该行为。"
    }
  }
}