{
  "id": "orbit",
  "name": "环绕",
  "description": "使对象环绕一个位置沿椭圆轨迹运动。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "测试行为是否已经启用。"
    }
  ],
  "actions": [
    {
      "id": "set-speed",
      "scriptName": "SetSpeed",
      "category": "",
      "list-name": "设置环绕速度",
      "display-text": "设置 {my}环绕速度为{0}",
      "description": "设置环绕的旋转速度。",
      "params": {
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "要设置的速度，以每秒旋转度数为单位。"
        }
      }
    },
    {
      "id": "set-target",
      "scriptName": "SetTarget",
      "category": "",
      "list-name": "设置环绕位置",
      "display-text": "设置 {my}环绕中心为 ({0}, {1})",
      "description": "设置环绕的中心点，沿其周围进行环绕运动。",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要环绕的X坐标。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要环绕的Y坐标。"
        }
      }
    },
    {
      "id": "set-rotation",
      "scriptName": "SetRotation",
      "category": "",
      "list-name": "设置旋转角度",
      "display-text": "设置 {my}旋转角度{0}",
      "description": "根据旋转角度，设置当前轨道的位置。",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "设置当前轨道的旋转角度。"
        }
      }
    },
    {
      "id": "set-offset-angle",
      "scriptName": "SetOffsetAngle",
      "category": "",
      "list-name": "设置偏移角度",
      "display-text": "设置 {my}偏移角度为{0}",
      "description": "设置椭圆轨道的旋转偏移角度，对于圆形轨道，则影响初始的角度。",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "设置轨道和轴的偏移角度，以度数为单位。"
        }
      }
    },
    {
      "id": "set-radius",
      "scriptName": "SetRadius",
      "category": "",
      "list-name": "设置半径",
      "display-text": "设置 {my}环绕主半径为{0}, 副半径为{1}",
      "description": "设置轨道的半径。",
      "params": {
        "primary": {
          "type": "number",
          "name": "主半径",
          "desc": "主半径的长度，以像素为单位。"
        },
        "secondary": {
          "type": "number",
          "name": "副半径",
          "desc": "副半径的长度，以像素为单位。圆形轨道应设置和主半径相同。"
        }
      }
    },
    {
      "id": "set-match-rotation",
      "scriptName": "SetMatchRotation",
      "category": "",
      "list-name": "启用旋转对齐",
      "display-text": "[i]{0}[/i] {my} 旋转对齐",
      "description": "对象的角度是否跟随轨道的角度而旋转。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "是否将对象的角度跟随轨道的角度旋转。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "pin",
      "scriptName": "Pin",
      "category": "",
      "list-name": "固定",
      "display-text": "固定 {my} 到 {0}",
      "description": "将轨道固定到指定对象，与对象的位置同步运行，沿其周围进行环绕运动。",
      "params": {
        "target": {
          "type": "object",
          "name": "目标",
          "desc": "要固定到的对象"
        }
      }
    },
    {
      "id": "unpin",
      "scriptName": "Unpin",
      "category": "",
      "list-name": "解除固定",
      "display-text": "解除 {my} 固定",
      "description": "解除对象的固定，不再跟随对象的位置运动。"
    },
    {
      "id": "set-acceleration",
      "scriptName": "SetAcceleration",
      "category": "",
      "list-name": "设置加速度",
      "display-text": "设置 {my}加速度为{0}",
      "description": "设置轨道旋转的速率变化。",
      "params": {
        "acceleration": {
          "type": "number",
          "name": "加速度",
          "desc": "沿轨道环绕的加速度，以每秒度数为单位。"
        }
      }
    },
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "[b]{0}[/b] {my}",
      "description": "启用或禁用此行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "启用或禁用此行为。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "reset-total-rotation",
      "scriptName": "ResetTotalRotation",
      "category": "",
      "list-name": "重置旋转角度",
      "display-text": "重置 {my} 总旋转角度",
      "description": "重置总旋转角度和总绝对旋转角度的计数，全部归零。"
    }
  ],
  "expressions": [
    {
      "id": "speed",
      "scriptName": "Speed",
      "category": "",
      "translated-name": "速度",
      "description": "沿轨道环绕的速度，以每秒度数为单位。",
      "returnType": "number"
    },
    {
      "id": "acceleration",
      "scriptName": "Acceleration",
      "category": "",
      "translated-name": "加速度",
      "description": "轨道加速度，以度数/秒为单位。",
      "returnType": "number"
    },
    {
      "id": "primary-radius",
      "scriptName": "PrimaryRadius",
      "category": "",
      "translated-name": "主轨半径",
      "description": "在主轴轨道上每秒的运动距离，单位是像素每秒。",
      "returnType": "number"
    },
    {
      "id": "secondary-radius",
      "scriptName": "SecondaryRadius",
      "category": "",
      "translated-name": "副轨半径",
      "description": "次级半径的长度，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "offset-angle",
      "scriptName": "OffsetAngle",
      "category": "",
      "translated-name": "偏移角度",
      "description": "椭圆的偏移角度",
      "returnType": "number"
    },
    {
      "id": "rotation",
      "scriptName": "Rotation",
      "category": "",
      "translated-name": "旋转角度",
      "description": "当前轨道的旋转角度。",
      "returnType": "number"
    },
    {
      "id": "target-x",
      "scriptName": "TargetX",
      "category": "",
      "translated-name": "目标X",
      "description": "当前X坐标",
      "returnType": "number"
    },
    {
      "id": "target-y",
      "scriptName": "TargetY",
      "category": "",
      "translated-name": "目标Y",
      "description": "当前目标Y的位置。",
      "returnType": "number"
    },
    {
      "id": "distance-to-target",
      "scriptName": "DistanceToTarget",
      "category": "",
      "translated-name": "到达目标距离",
      "description": "当前到目标的距离",
      "returnType": "number"
    },
    {
      "id": "total-rotation",
      "scriptName": "TotalRotation",
      "category": "",
      "translated-name": "总旋转角度",
      "description": "当前未被约束的总旋转角度，该值会随着 CCW 旋转而降低。",
      "returnType": "number"
    },
    {
      "id": "total-absolute-rotation",
      "scriptName": "TotalAbsoluteRotation",
      "category": "",
      "translated-name": "总绝对旋转角度",
      "description": "当前未被约束的总旋转角度。",
      "returnType": "number"
    }
  ],
  "properties": {
    "speed": {
      "name": "速度",
      "desc": "环绕的速度。正数为顺时针方向运动，负数则为逆时针运动。"
    },
    "acceleration": {
      "name": "加速度",
      "desc": "每秒提升旋转的加速度，负值则减慢。"
    },
    "primary-axis": {
      "name": "主半径",
      "desc": "圆心点与轨道的距离。对于圆形轨道，主半径为圆形的半径。对于椭圆轨道，则为偏移角度的轨道半径。"
    },
    "secondary-axis": {
      "name": "次半径",
      "desc": "圆心点与轨道的垂直距离。对于圆形轨道，请确保与主半径是相同值。对于椭圆轨道，则为垂直于偏移角度的半径。"
    },
    "offset-angle": {
      "name": "偏移角度",
      "desc": "主轴的旋转角度。对于圆形轨道，则改变初始角度。"
    },
    "match-rotation": {
      "name": "旋转对齐",
      "desc": "对象的角度是否跟随轨道的角度而旋转。"
    },
    "enabled": {
      "name": "启用",
      "desc": "进入场景时，是否默认启用该行为。"
    },
    "live-preview": {
      "name": "预览",
      "desc": "在编辑器中进行实时预览。"
    }
  }
}