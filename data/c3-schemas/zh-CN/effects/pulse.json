{
  "id": "pulse",
  "name": "脉冲",
  "description": "扭曲脉冲动画效果。",
  "category": "distortion",
  "blends-background": false,
  "cross-sampling": false,
  "animated": true,
  "parameters": [
    {
      "id": "intensity",
      "type": "percent",
      "name": "强度",
      "desc": "要应用多少效果。(0-100)"
    },
    {
      "id": "lighting",
      "type": "percent",
      "name": "灯光",
      "desc": "应用多少照明。(0-100)"
    },
    {
      "id": "speed",
      "type": "float",
      "name": "速度",
      "desc": "脉冲波的速度。"
    },
    {
      "id": "frequency",
      "type": "float",
      "name": "频率",
      "desc": "脉冲波的频率。"
    },
    {
      "id": "center-x",
      "type": "percent",
      "name": "中心X",
      "desc": "效果中心的X位置，从0（左边缘）到100（右边缘）。"
    },
    {
      "id": "center-y",
      "type": "percent",
      "name": "中心Y",
      "desc": "效果中心的Y位置，从0（下边缘）到100（上边缘）。"
    }
  ]
}