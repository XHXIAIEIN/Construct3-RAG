      "params": {
        "character": {
          "type": "string",
          "name": "字符",
          "desc": "要获取其宽度的字符。默认为空，如果字符串包含多个字符，仅获取第 1 个字符。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "characterheight",
      "scriptName": "CharacterHeight",
      "category": "appearance",
      "translated-name": "字符高度",
      "description": "获取字符的高度。",
      "returnType": "number"
    },
    {
      "id": "characterscale",
      "scriptName": "CharacterScale",
      "category": "appearance",
      "translated-name": "字符缩放倍数",
      "description": "获取字符的缩放比例。",
      "returnType": "number"
