      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "设备类型。",
          "items": {
            "input": "输入",
            "output": "输出"
          }
        },
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备 ID。留空则关闭上次打开的设备。"
        }
      },
      "isAsync": true
    },
    {
      "id": "send-binary-message",
      "scriptName": "SendBinaryMessage",
      "category": "midi-output",
      "list-name": "发送二进制消息",
      "display-text": "发送 [i]{0}[/i] 二进制消息 {1}",
      "description": "将二进制原始数据作为 MIDI 消息发送到设备。",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备 ID。留空则使用上次打开的输出设备。"
        },
        "binary-data": {
          "type": "object",
          "name": "二进制数据",
          "desc": "选择要作为 MIDI 信息发送的二进制数据对象。"
        }
      }
    },
    {
      "id": "send-note-message",
      "scriptName": "SendNoteMessage",
      "category": "midi-output",
      "list-name": "发送音符信息",
      "display-text": "发送[i]{0}[/i] {1}消息 ([i]{2}[/i], 速度: [i]{3}[/i])",
      "description": "发送音符打开/关闭的触后消息。",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备ID。留空则使用上次打开的输出设备。"
        },
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "要发送的消息类型。",
          "items": {
            "note-off": "音符关闭",
            "note-on": "音符打开",
            "aftertouch": "压力控制"
          }
        },
        "note": {
          "type": "any",
          "name": "音符",
          "desc": "MIDI 音符编号，或音符名称的字符串，例如 'C4'。"
        },
        "velocity": {
          "type": "number",
          "name": "速度",
          "desc": "触后控制的速度或压力，范围在 0 到 127。用于模拟乐器的颤音或滤波器截止频率等参数。"
        }
      }
    },
    {
      "id": "send-control-change-message",
      "scriptName": "SendControlChangeMessage",
      "category": "midi-output",
      "list-name": "发送控制改变消息",
      "display-text": "发送控制改变消息(设备ID: [i]{0}[/i], 控制器编号: [i]{1}[/i], 控制器值: [i]{2}[/i])",
      "description": "发送音符打开/关闭的触后消息。",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备 ID。留空则使用上次打开的输出设备。"
        },
        "controller-number": {
          "type": "number",
          "name": "控制器编号",
          "desc": "MIDI 控制器编号，例如 1 表示颤音轮（粗调）。"
        },
        "controller-value": {
          "type": "number",
          "name": "控制器值",
          "desc": "要操作的控制器值，范围在 0 到 127。"
        }
      }
    },
    {
      "id": "send-message",
      "scriptName": "SendMessage",
      "category": "midi-output",
      "list-name": "发送消息",
      "display-text": "发送{1}信息(设备ID: [i]{0}[/i],  值: [i]{2}[/i])",
      "description": "向 MIDI 设备发送特定的消息类型，如音色改变、通道压力、音高弯曲等。",
      "params": {
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备 ID。留空则使用上次打开的输出设备。"
        },
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "要发送的消息类型。",
          "items": {
            "program-change": "音色改变",
            "channel-pressure": "通道压力",
            "pitch-wheel": "音高变化"
          }
        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "要发送的值。对于音色变化或通道压力的消息，范围在 0 到 127。对于音高弯曲的消息，范围在 0 到 16383。"
        }
      }
    },
    {
      "id": "schedule-next-message",
      "scriptName": "ScheduleNextMessage",
      "category": "midi-output",
      "list-name": "安排下一条消息",
      "display-text": "在 [i]{0}[/i] 秒后发送下一条消息",
      "description": "将下一条 MIDI 消息安排在延迟后发送。",
      "params": {
        "time": {
          "type": "number",
          "name": "时间",
          "desc": "下一条消息发送的延迟时间，以秒为单位。0 表示没有延迟。"
        }
      }
    },
    {
      "id": "set-midi-channel",
      "scriptName": "SetMIDIChannel",
      "category": "midi-output",
      "list-name": "设置 MIDI 通道",
      "display-text": "设置 MIDI 通道为 [i]{0}[/i]",
      "description": "设置要为所有发送的信息指定的 MIDI 通道。",
      "params": {
        "channel": {
          "type": "number",
          "name": "通道",
          "desc": "MIDI 通道，范围从 0 至 15。"
        }
      }
    }
  ],
