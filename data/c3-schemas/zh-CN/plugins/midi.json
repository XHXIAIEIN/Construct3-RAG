  "actions": [
    {
      "id": "request-midi-access",
      "scriptName": "RequestMIDIAccess",
      "category": "midi-access",
      "list-name": "请求访问 MIDI 设备",
      "display-text": "请求访问 MIDI 设备 (系统独占: {0}, 合成器: {1})",
      "description": "请求访问连接的 MIDI 设备的权限。",
      "params": {
        "sysex": {
          "type": "boolean",
          "name": "系统独占",
          "desc": "启用发送和接收系统独占消息。"
        },
        "software": {
          "type": "boolean",
          "name": "合成器",
          "desc": "允许系统使用任何已安装的软件合成器。"
        }
      },
      "isAsync": true
    },
    {
      "id": "open-device",
      "scriptName": "OpenDevice",
      "category": "midi-devices",
      "list-name": "打开设备",
      "display-text": "打开 {0} 设备 [i]{1}[/i]",
      "description": "打开 MIDI 设备的输入或输出，用于发送或接收信息。",
      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "设备类型",
          "items": {
            "input": "输入",
            "output": "输出"
          }
        },
        "id": {
          "type": "string",
          "name": "ID",
          "desc": "设备 ID。留空则使用第一个可用设备。"
        }
      },
      "isAsync": true
    },
    {
      "id": "close-device",
      "scriptName": "CloseDevice",
      "category": "midi-devices",
      "list-name": "关闭设备",
      "display-text": "关闭{0}设备 [i]{1}[/i]",
