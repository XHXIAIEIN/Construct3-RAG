  "actions": [
    {
      "id": "gamepad-vibrate",
      "scriptName": "VibrateDualRumble",
      "category": "gamepad",
      "list-name": "振动 (双马达)",
      "display-text": "振动 {0} 手柄 (持续时间: [b]{1}[/b]ms, 弱振幅: [i]{2}[/i], 强振幅: [i]{3}[/i]）",
      "description": "激活游戏手柄内的双振动马达，向用户提供物理触觉反馈。",
      "params": {
        "gamepad": {
          "type": "number",
          "name": "手柄序列",
          "desc": "已连接的游戏手柄的索引值，从0开始计数。"
        },
        "duration": {
          "type": "number",
          "name": "持续时间",
          "desc": "振动的时间，以毫秒为单位。"
        },
        "weak-magnitude": {
          "type": "number",
          "name": "弱振幅",
          "desc": "弱马达的振动强度，范围在 0-100。位于右电机，可提供高频率、低强度的细微振动。"
        },
        "strong-magnitude": {
          "type": "number",
          "name": "强振幅",
          "desc": "强马达的振动强度，范围在 0-100。位于左电机，可提供低频率、高强度的强烈振动。"
        }
      }
    },
    {
      "id": "gamepad-vibrate-trigger-rumble",
      "scriptName": "VibrateTriggerRumble",
      "category": "gamepad",
      "list-name": "振动 (扳机)",
      "display-text": "振动 {0} 手柄 (持续时间: [b]{1}[/b]ms, 弱振幅: [i]{2}[/i], 强振幅: [i]{3}[/i], 左扳机: [i]{4}[/i], 右扳机: [i]{5}[/i])",
      "description": "激活游戏手柄内的振动马达，向用户提供物理触觉反馈。",
      "params": {
        "gamepad": {
          "type": "number",
          "name": "手柄",
          "desc": "已连接的游戏手柄的索引，从 0 开始计数。"
        },
        "duration": {
          "type": "number",
          "name": "持续时间",
          "desc": "振动马达的持续时间，以毫秒为单位。"
        },
        "weak-magnitude": {
          "type": "number",
          "name": "弱振幅",
          "desc": "弱马达的振动强度，范围在 0-100。位于右电机，可提供高频率、低强度的细微振动。"
        },
        "strong-magnitude": {
          "type": "number",
          "name": "强振幅",
          "desc": "强马达的振动强度，范围在 0-100。位于左电机，可提供低频率、高强度的强烈振动。"
        },
        "left-trigger": {
          "type": "number",
          "name": "左扳机键",
          "desc": "左扳机键的脉冲强度，位于左手指位置，提供剧烈突发振动，范围在 0-100。"
        },
        "right-trigger": {
          "type": "number",
          "name": "右扳机键",
          "desc": "右扳机键的脉冲强度，位于右手指位置，提供剧烈突发振动，范围在 0-100。"
        }
      }
    },
