{
  "id": "cordovaiap",
  "name": "应用内购",
  "description": "在 iOS 和 Android 上通过 Cordova 处理应用内购功能 (IAP)。",
  "type": "plugin",
  "aceCategories": {
    "cordovaiap": "Cordova IAP"
  },
  "conditions": [
    {
      "id": "on-purchase-success",
      "scriptName": "OnPurchaseSuccess",
      "category": "cordovaiap",
      "list-name": "购买成功",
      "display-text": "产品 [i]{0}[/i] 购买成功",
      "description": "成功购买特定产品ID时触发。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "已成功购买的产品ID。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-purchase-success",
      "scriptName": "OnAnyPurchaseSuccess",
      "category": "cordovaiap",
      "list-name": "任意产品购买成功",
      "display-text": "任意产品购买成功",
      "description": "成功购买任何产品时触发。",
      "isTrigger": true
    },
    {
      "id": "on-purchase-failed",
      "scriptName": "OnPurchaseFail",
      "category": "cordovaiap",
      "list-name": "购买失败",
      "display-text": "购买产品 [i]{0}[/i] 失败",
      "description": "无法购买特定产品ID时触发。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "无法购买的产品ID。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-purchase-failed",
      "scriptName": "OnAnyPurchaseFail",
      "category": "cordovaiap",
      "list-name": "任意购买失败",
      "display-text": "任意购买失败",
      "description": "任何产品未能购买时触发。",
      "isTrigger": true
    },
    {
      "id": "on-registration-success",
      "scriptName": "OnRegistrationSuccess",
      "category": "cordovaiap",
      "list-name": "商店注册成功",
      "display-text": "商店注册成功",
      "description": "商店注册成功时触发。",
      "isTrigger": true
    },
    {
      "id": "on-registration-failure",
      "scriptName": "OnRegistrationFail",
      "category": "cordovaiap",
      "list-name": "商店注册失败",
      "display-text": "商店注册失败",
      "description": "存储注册失败时触发。",
      "isTrigger": true
    },
    {
      "id": "product-owned",
      "scriptName": "ProductOwned",
      "category": "cordovaiap",
      "list-name": "产品存在",
      "display-text": "存在产品 [i]{0}[/i]",
      "description": "检测当前用户是否已经购买了指定的产品ID。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "要检查是否拥有的产品ID。"
        }
      }
    },
    {
      "id": "product-available",
      "scriptName": "ProductAvailable",
      "category": "cordovaiap",
      "list-name": "产品可购买",
      "display-text": "产品 [i]{0}[/i] 可供购买",
      "description": "检测是否可以购买指定的产品。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "要检查的产品ID是否可用。"
        }
      }
    },
    {
      "id": "store-registered",
      "scriptName": "StoreRegistered",
      "category": "cordovaiap",
      "list-name": "商店注册完成",
      "display-text": "商店注册完成",
      "description": "检测商店是否已注册，并准备好发起购买请求。"
    },
    {
      "id": "on-product-available",
      "scriptName": "OnProductAvailable",
      "category": "cordovaiap",
      "list-name": "产品可购买",
      "display-text": "产品 [i]{0}[/i] 可供购买",
      "description": "检查产品是否可供购买。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "要检查的产品ID。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-product-available",
      "scriptName": "OnAnyProductAvailable",
      "category": "cordovaiap",
      "list-name": "任意产品可购买",
      "display-text": "任意产品可购买",
      "description": "产品可供购买时触发。",
      "isTrigger": true
    },
    {
      "id": "on-product-owned",
      "scriptName": "OnProductOwned",
      "category": "cordovaiap",
      "list-name": "已拥有产品",
      "display-text": "已拥有产品 [i]{0}[/i]",
      "description": "当指定的非消耗品被拥有时触发",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "要检查的产品ID。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-product-owned",
      "scriptName": "OnAnyProductOwned",
      "category": "cordovaiap",
      "list-name": "拥有任意产品",
      "display-text": "拥有任意产品",
      "description": "拥有任意非消耗品的产品时触发。",
      "isTrigger": true
    },
    {
      "id": "on-transaction-finished",
      "scriptName": "OnTransactionFinished",
      "category": "cordovaiap",
      "list-name": "交易完成",
      "display-text": "交易完成",
      "description": "执行 '购买产品' 动作后，交易成功时触发，并返回 '订单ID' 表达式。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "register-product",
      "scriptName": "RegisterProduct",
      "category": "cordovaiap",
      "list-name": "添加产品",
      "display-text": "添加产品 (类型: [b]{0}[/b], 产品ID: [b]{1}[/b])",
      "description": "添加要提供给应用内购买的产品。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "您正在注册的产品ID。"
        },
        "product-type": {
          "type": "combo",
          "name": "产品类型",
          "desc": "输入您注册的产品类型。",
          "items": {
            "consumable": "消耗品",
            "non-consumable": "非消耗品"
          }
        }
      }
    },
    {
      "id": "complete-registration",
      "scriptName": "CompleteRegistration",
      "category": "cordovaiap",
      "list-name": "完成产品注册",
      "display-text": "完成产品注册",
      "description": "结束产品注册阶段，必须先调用此函数才能购买产品。"
    },
    {
      "id": "purchase-product",
      "scriptName": "PurchaseProduct",
      "category": "cordovaiap",
      "list-name": "购买产品",
      "display-text": "购买产品 [b]{0}[/b]",
      "description": "提示用户购买产品。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "要购买的产品ID。"
        }
      }
    },
    {
      "id": "restore-purchases",
      "scriptName": "RestorePurchases",
      "category": "cordovaiap",
      "list-name": "恢复购买",
      "display-text": "恢复购买",
      "description": "从商店恢复购买状态。"
    }
  ],
  "expressions": [
    {
      "id": "product-name",
      "scriptName": "ProductName",
      "category": "cordovaiap",
      "translated-name": "产品名称",
      "description": "根据产品 ID 获取产品名称。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "用于获取名称的产品ID。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "product-price",
      "scriptName": "ProductPrice",
      "category": "cordovaiap",
      "translated-name": "产品价格",
      "description": "根据产品ID获取产品的格式化价格。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "用于获取价格的产品ID。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "product-description",
      "scriptName": "ProductDescription",
      "category": "cordovaiap",
      "translated-name": "产品描述",
      "description": "在触发器中，相关的产品描述。",
      "params": {
        "product-id": {
          "type": "string",
          "name": "产品ID",
          "desc": "用于获取描述的产品ID。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "product-id",
      "scriptName": "ProductID",
      "category": "cordovaiap",
      "translated-name": "产品ID",
      "description": "在触发器中，相关的产品ID。",
      "returnType": "string"
    },
    {
      "id": "error-message",
      "scriptName": "ErrorMessage",
      "category": "cordovaiap",
      "translated-name": "错误信息",
      "description": "在触发器中，返回相关的错误消息。",
      "returnType": "string"
    },
    {
      "id": "transaction-id",
      "scriptName": "TransactionID",
      "category": "cordovaiap",
      "translated-name": "订单ID",
      "description": "在 '交易完成' 条件中，完成的订单ID。",
      "returnType": "string"
    }
  ],
  "properties": {
    "validator-url": {
      "name": "验证服务器地址(可选)",
      "desc": "订单验证的服务器地址，用于验证是否完成购买。"
    }
  }
}