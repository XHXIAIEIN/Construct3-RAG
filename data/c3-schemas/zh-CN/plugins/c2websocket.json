{
  "id": "c2websocket",
  "name": "WebSocket",
  "description": "发送和接收文本消息到 WebSocket 服务器。",
  "type": "plugin",
  "aceCategories": {
    "connection": "连接",
    "data": "数据"
  },
  "conditions": [
    {
      "id": "on-opened",
      "scriptName": "OnOpened",
      "category": "connection",
      "list-name": "连接打开",
      "display-text": "连接打开",
      "description": "与 WebSocket 服务器成功建立连接时触发。",
      "isTrigger": true
    },
    {
      "id": "on-closed",
      "scriptName": "OnClosed",
      "category": "connection",
      "list-name": "连接关闭",
      "display-text": "连接关闭",
      "description": "关闭活动连接时触发。",
      "isTrigger": true
    },
    {
      "id": "on-error",
      "scriptName": "OnError",
      "category": "connection",
      "list-name": "连接错误",
      "display-text": "连接错误",
      "description": "出现连接错误时触发。",
      "isTrigger": true
    },
    {
      "id": "is-open",
      "scriptName": "IsOpen",
      "category": "connection",
      "list-name": "已开启",
      "display-text": "已开启",
      "description": "检测连接当前是否已打开。"
    },
    {
      "id": "is-connecting",
      "scriptName": "IsConnecting",
      "category": "connection",
      "list-name": "正在连接",
      "display-text": "正在连接",
      "description": "检测当前是否正在建立连接。"
    },
    {
      "id": "is-supported",
      "scriptName": "IsSupported",
      "category": "connection",
      "list-name": "设备受支持",
      "display-text": "设备受支持",
      "description": "检测当前运行设备是否支持 WebSocket 连接。"
    },
    {
      "id": "on-message",
      "scriptName": "OnMessage",
      "category": "data",
      "list-name": "收到文字消息",
      "display-text": "收到文字消息",
      "description": "从服务器收到消息时触发。",
      "isTrigger": true
    },
    {
      "id": "on-binary-message",
      "scriptName": "OnBinaryMessage",
      "category": "data",
      "list-name": "接收到二进制消息",
      "display-text": "接受到二进制消息(储存到 {0})",
      "description": "当服务器收到二进制数据消息时触发。",
      "params": {
        "receive-to": {
          "type": "object",
          "name": "接收到",
          "desc": "选择二进制数据对象，将接收到的二进制消息写入其中。"
        }
      },
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "connect",
      "scriptName": "Connect",
      "category": "connection",
      "list-name": "连接",
      "display-text": "连接到 [i]{0}[/i] (请求协议: {1})",
      "description": "连接到 WebSocket 服务器。",
      "params": {
        "url": {
          "type": "string",
          "name": "URL",
          "desc": "输入要连接的WebSocket服务器。"
        },
        "protocol-optional": {
          "type": "string",
          "name": "子协议(可选)",
          "desc": "部分服务器必须要求填写子协议才能建立连接。留空表示无需协议要求。"
        }
      },
      "isAsync": true
    },
    {
      "id": "close",
      "scriptName": "Close",
      "category": "connection",
      "list-name": "关闭连接",
      "display-text": "关闭连接",
      "description": "关闭所有活跃的 WebSocket 连接。"
    },
    {
      "id": "send-text",
      "scriptName": "Send",
      "category": "data",
      "list-name": "发送文本",
      "display-text": "发送文本 [i]{0}[/i]",
      "description": "将文本字符串发送到服务器。",
      "params": {
        "data": {
          "type": "string",
          "name": "数据",
          "desc": "要发送到服务器的文本字符串。"
        }
      }
    },
    {
      "id": "send-binary",
      "scriptName": "SendBinary",
      "category": "data",
      "list-name": "发送二进制",
      "display-text": "发送 [i]{0}[/i]",
      "description": "将二进制数据对象的内容发送到服务器。",
      "params": {
        "data": {
          "type": "object",
          "name": "二进制数据",
          "desc": "要作为消息发送的二进制数据对象。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "errormsg",
      "scriptName": "ErrorMsg",
      "category": "connection",
      "translated-name": "错误信息",
      "description": "在触发事件 '连接出错' 中的错误消息。",
      "returnType": "string"
    },
    {
      "id": "closecode",
      "scriptName": "CloseCode",
      "category": "connection",
      "translated-name": "错误代码",
      "description": "触发事件 '已关闭' 的关闭代码。",
      "returnType": "string"
    },
    {
      "id": "closereason",
      "scriptName": "CloseReason",
      "category": "connection",
      "translated-name": "错误理由",
      "description": "触发事件 '连接被关闭' 的关闭原因。",
      "returnType": "string"
    },
    {
      "id": "messagetext",
      "scriptName": "MessageText",
      "category": "data",
      "translated-name": "信息文本",
      "description": "在 '收到文字消息' 条件中，收到的文本内容。",
      "returnType": "string"
    }
  ],
  "properties": {}
}