{
  "id": "gamerecorder",
  "name": "屏幕录制",
  "description": "录制游戏画面或整个屏幕的视频。",
  "type": "plugin",
  "aceCategories": {
    "recording": "录制阶段"
  },
  "conditions": [
    {
      "id": "on-recording-ready",
      "scriptName": "OnRecordingReady",
      "category": "recording",
      "list-name": "录制完成",
      "display-text": "录制完成",
      "description": "执行 '停止录制' 动作后，返回的 '录屏文件地址' 表达式可用时触发。",
      "isTrigger": true
    },
    {
      "id": "on-recording-error",
      "scriptName": "OnRecordingError",
      "category": "recording",
      "list-name": "录制失败",
      "display-text": "录制失败",
      "description": "如果在录制期间发生了错误，则触发此条件。",
      "isTrigger": true
    },
    {
      "id": "is-recording-supported",
      "scriptName": "SupportsRecording",
      "category": "recording",
      "list-name": "支持屏幕录制",
      "display-text": "设备支持屏幕录制",
      "description": "检测运行设备是否支持屏幕录制。"
    },
    {
      "id": "is-screen-recording-supported",
      "scriptName": "SupportsScreenRecording",
      "category": "recording",
      "list-name": "设备支持录制",
      "display-text": "设备支持屏幕录制",
      "description": "检测浏览器是否支持使用屏幕录制功能。"
    },
    {
      "id": "is-video-format-supported-2",
      "scriptName": "IsVideoFormatSupported2",
      "category": "recording",
      "list-name": "支持视频格式",
      "display-text": "支持视频格式 [b]{0} {1}[/b]",
      "description": "测试指定的视频格式是否受支持。",
      "params": {
        "container": {
          "type": "combo",
          "name": "格式",
          "desc": "要使用的视频格式。",
          "items": {
            "webm": "WebM",
            "mp4": "MP4"
          }
        },
        "codec": {
          "type": "combo",
          "name": "视频编解码器",
          "desc": "要使用的视频编解码器。",
          "items": {
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          }
        }
      }
    },
    {
      "id": "is-audio-format-supported-2",
      "scriptName": "IsAudioFormatSupported2",
      "category": "recording",
      "list-name": "支持音频格式",
      "display-text": "支持音频格式 [b]{0} {1}[/b]",
      "description": "检查音频格式录制是否受支持。",
      "params": {
        "container": {
          "type": "combo",
          "name": "视频格式",
          "desc": "要保存的视频格式。",
          "items": {
            "webm": "WebM",
            "mp4": "MP4"
          }
        },
        "codec": {
          "type": "combo",
          "name": "音频编解码器",
          "desc": "录制使用的音频编解码器。",
          "items": {
            "opus": "Opus",
            "aac": "AAC"
          }
        }
      }
    },
    {
      "id": "is-recording",
      "scriptName": "IsRecording",
      "category": "recording",
      "list-name": "正在录制",
      "display-text": "正在录制",
      "description": "检测目前是否正处于录制状态。"
    }
  ],
  "actions": [
    {
      "id": "start-recording-2",
      "scriptName": "StartRecording2",
      "category": "recording",
      "list-name": "开始实时录制",
      "display-text": "开始录制 ([i]{0} {1}[/i] @ [i]{2}[/i] fps, [i]{3}[/i], [i]{4}[/i] kbps)",
      "description": "实时录制项目，保存为视频。",
      "params": {
        "container": {
          "type": "combo",
          "name": "格式",
          "desc": "要保存的视频格式",
          "items": {
            "auto": "自动",
            "webm": "WebM",
            "mp4": "MP4"
          },
          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "视频编解码器",
          "desc": "要使用的视频编解码器。",
          "items": {
            "none": "无(没有画面)",
            "auto": "自动",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "framerate": {
          "type": "number",
          "name": "帧率",
          "desc": "录制每秒捕获的帧数(如果可用)，使用 0 默认使用显示器的帧率。"
        },
        "audio-codec": {
          "type": "combo",
          "name": "音频编解码器",
          "desc": "要使用的音频编解码器",
          "items": {
            "none": "无(没有音频)",
            "auto": "自动",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "quality-kbps": {
          "type": "number",
          "name": "质量(kbps)",
          "desc": "音频录制的编码速率，以千比特每秒 (kbps) 为单位。"
        }
      }
    },
    {
      "id": "start-screen-recording-2",
      "scriptName": "StartScreenRecording2",
      "category": "recording",
      "list-name": "开始屏幕录制",
      "display-text": "开始录制 ([i]{0} {1}[/i], [i]{2}[/i], [i]{4}[/i] kbps, 使用电脑音频: [i]{3}[/i])",
      "description": "实时录制用户画面，保存为视频。",
      "params": {
        "container": {
          "type": "combo",
          "name": "格式",
          "desc": "要保存的视频格式。",
          "items": {
            "auto": "自动",
            "webm": "WebM",
            "mp4": "MP4"
          },
          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "视频编解码器",
          "desc": "要使用的视频编解码器。",
          "items": {
            "none": "无(没有画面)",
            "auto": "自动",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "audio-codec": {
          "type": "combo",
          "name": "音频编解码器",
          "desc": "要使用的音频编解码器。",
          "items": {
            "none": "无(没有音频)",
            "auto": "自动",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "system-audio": {
          "type": "boolean",
          "name": "系统音频",
          "desc": "勾选后，请求录制系统音频。否则，仅录制浏览器标签页或音频对象的声音。"
        },
        "quality-kbps": {
          "type": "number",
          "name": "质量(kbps)",
          "desc": "音频录制的编码速率，以千比特每秒 (kbps) 为单位。"
        }
      }
    },
    {
      "id": "start-user-media-recording-2",
      "scriptName": "StartUserMediaRecording2",
      "category": "recording",
      "list-name": "媒体录制",
      "display-text": "开始录制 ([i]{0} {1}[/i], [i]{2}[/i], [i]{3}[/i] kbps)",
