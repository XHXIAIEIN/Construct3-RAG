          "initialValue": "auto"
        },
        "video-codec": {
          "type": "combo",
          "name": "视频编解码器",
          "desc": "要使用的视频编解码器。",
          "items": {
            "none": "无(没有画面)",
            "auto": "自动",
            "vp8": "VP8",
            "vp9": "VP9",
            "h264": "H.264",
            "h265": "H.265"
          },
          "initialValue": "auto"
        },
        "audio-codec": {
          "type": "combo",
          "name": "音频编解码器",
          "desc": "要使用的音频编解码器。",
          "items": {
            "none": "无(没有音频)",
            "auto": "自动",
            "opus": "Opus",
            "aac": "AAC"
          },
          "initialValue": "auto"
        },
        "quality-kbps": {
          "type": "number",
          "name": "质量(kbps)",
          "desc": "音频录制的编码速率，以千比特每秒 (kbps) 为单位。"
        }
      }
    },
    {
      "id": "stop-recording",
      "scriptName": "StopRecording",
      "category": "recording",
      "list-name": "停止录制",
      "display-text": "停止录制",
      "description": "结束视频录制。处理完成后将触发 '录制完成' 条件。"
    },
    {
      "id": "set-recording-paused",
      "scriptName": "SetRecordingPaused",
      "category": "recording",
      "list-name": "暂停录制",
      "display-text": "暂停录制：[i]{0}[/i]",
      "description": "暂停或恢复正在进行的录制。",
      "params": {
        "paused": {
          "type": "boolean",
          "name": "暂停",
          "desc": "选中此项可暂停录制，取消选中此项可恢复录制。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "recordingurl",
      "scriptName": "RecordingURL",
      "category": "recording",
      "translated-name": "录制文件地址",
      "description": "返回可被浏览器对象下载使用的录像文件URL。",
      "returnType": "string"
    },
    {
      "id": "recording-type",
      "scriptName": "RecordingType",
      "category": "recording",
      "translated-name": "录制类型",
      "description": "返回录制结果的MIME类型，如：\"video/webm\"",
      "returnType": "string"
    },
    {
      "id": "recording-file-extension",
      "scriptName": "RecordingFileExtension",
      "category": "recording",
      "translated-name": "录制文件扩展名",
