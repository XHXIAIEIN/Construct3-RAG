{
  "id": "button",
  "name": "按钮",
  "description": "浏览器基本样式的按钮或复选框组件，通常用于系统级的点击交互。如果你希望显示游戏按钮，建议使用精灵图，并通过鼠标、触控进行交互。",
  "type": "plugin",
  "aceCategories": {
    "button": "按钮"
  },
  "conditions": [
    {
      "id": "on-clicked",
      "scriptName": "OnClicked",
      "category": "button",
      "list-name": "点击按钮",
      "display-text": "点击按钮",
      "description": "单击按钮时触发。",
      "isTrigger": true
    },
    {
      "id": "is-checked",
      "scriptName": "IsChecked",
      "category": "button",
      "list-name": "已勾选",
      "display-text": "已勾选",
      "description": "检测复选框是否已被勾选。"
    },
    {
      "id": "compare-text",
      "scriptName": "CompareText",
      "category": "button",
      "list-name": "比较文本",
      "display-text": "按钮文本是[b]{0}[/b] [i]({1})[/i]",
      "description": "比较按钮的文本。",
      "params": {
        "text-to-compare": {
          "type": "string",
          "name": "要比较的文本",
          "desc": "与按钮文本进行比较的文本。"
        },
        "case-sensitivity": {
          "type": "combo",
          "name": "区分大小写",
          "desc": "是否严格区分大小写字母。如果不区分，则 'ABC' 也能匹配到 'abc'。",
          "items": {
            "ignore-case": "忽略大小写",
            "case-sensitive": "区分大小写"
          }
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-text",
      "scriptName": "SetText",
      "category": "button",
      "list-name": "设置按钮文字",
      "display-text": "设置按钮文字为{0}",
      "description": "设置按钮的文字。",
      "params": {
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "在按钮上显示的文本。"
        }
      }
    },
    {
      "id": "set-tooltip",
      "scriptName": "SetTooltip",
      "category": "button",
      "list-name": "设置工具提示",
      "display-text": "设置工具提示为{0}",
      "description": "设置按钮的工具提示。",
      "params": {
        "tooltip": {
          "type": "string",
          "name": "提示",
          "desc": "在按钮上设置的工具提示。"
        }
      }
    },
    {
      "id": "set-checked",
      "scriptName": "SetChecked",
      "category": "button",
      "list-name": "设置勾选状态",
      "display-text": "设置[b]{0}[/b]",
      "description": "勾选或取消选中一个复选框。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "选择复选框状态。",
          "items": {
            "unchecked": "待勾选",
            "checked": "已勾选"
          }
        }
      }
    },
    {
      "id": "toggle-checked",
      "scriptName": "ToggleChecked",
      "category": "button",
      "list-name": "反转勾选",
      "display-text": "反转勾选",
      "description": "切换复选框"
    }
  ],
  "expressions": [
    {
      "id": "text",
      "scriptName": "Text",
      "category": "button",
      "translated-name": "文本",
      "description": "获取按钮文字",
      "returnType": "string"
    }
  ],
  "properties": {
    "type": {
      "name": "类型",
      "desc": "要使用的按钮类型。",
      "items": {
        "button": "按钮",
        "checkbox": "复选框"
      }
    },
    "text": {
      "name": "文本",
      "desc": "按钮的初始文本。"
    },
    "tooltip": {
      "name": "提示",
      "desc": "将鼠标悬停在控件上时显示此文本。"
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "选择场景开始时对象是否可见。"
    },
    "enabled": {
      "name": "启用",
      "desc": "在初始状态下，默认启用还是禁用按钮。"
    },
    "auto-font-size": {
      "name": "自动字体大小",
      "desc": "根据图层比例自动设置字体大小。"
    },
    "checked": {
      "name": "已勾选",
      "desc": "对于复选框，初始检查状态。"
    },
    "id": {
      "name": "ID",
      "desc": "可选的元素ID，允许通过CSS设置样式。"
    },
    "class": {
      "name": "Class",
      "desc": "可选的元素Class，允许通过CSS设置样式。"
    }
  }
}