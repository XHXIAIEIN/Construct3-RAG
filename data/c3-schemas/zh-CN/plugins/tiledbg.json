{
  "id": "tiledbg",
  "name": "平铺图",
  "description": "将图像以平铺重复的方式显示，这比堆满精灵工作效率更快。",
  "type": "plugin",
  "aceCategories": {
    "appearance": "显示",
    "image": "图像",
    "web": "网络",
    "tile-randomization": "纹理混合"
  },
  "conditions": [
    {
      "id": "is-tile-randomization-enabled",
      "scriptName": "IsTileRandomizationEnabled",
      "category": "tile-randomization",
      "list-name": "已开启纹理混合",
      "display-text": "已开启纹理混合",
      "description": "检测纹理混合功能是否已启用。"
    },
    {
      "id": "on-image-url-loaded",
      "scriptName": "OnURLLoaded",
      "category": "web",
      "list-name": "网络图像加载完成",
      "display-text": "网络图像加载完成",
      "description": "执行 '加载网络图像' 动作后，图像加载完成时触发。",
      "isTrigger": true
    },
    {
      "id": "on-image-url-failed",
      "scriptName": "OnURLFailed",
      "category": "web",
      "list-name": "当图像链接读取失败",
      "display-text": "当图像链接读取失败",
      "description": "执行 '加载网络图像' 动作后，图像加载失败时触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "设置混合模式",
      "display-text": "设置混合模式为[i]{0}[/i]",
      "description": "设置此对象的背景混合模式。",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "混合模式",
          "desc": "为此对象选择新的混合模式。",
          "items": {
            "normal": "正常",
            "additive": "叠加",
            "xor": "重叠消除",
            "copy": "前景覆盖",
            "destination-over": "背景穿透",
            "source-in": "前景剪贴",
            "destination-in": "背景剪贴",
            "source-out": "前景剔除",
            "destination-out": "背景剔除",
            "source-atop": "前景混合",
            "destination-atop": "背景混合",
            "lighten": "变亮",
            "darken": "变暗",
            "multiply": "正片叠底",
            "screen": "滤色"
          }
        }
      }
    },
    {
      "id": "set-image-offset-x",
      "scriptName": "SetImageOffsetX",
      "category": "image",
      "list-name": "设置图像X偏移",
      "display-text": "设置图像偏移X为[i]{0}[/i]",
      "description": "设置图像在X轴的偏移量",
      "params": {
        "offset-x": {
          "type": "number",
          "name": "X偏移值",
          "desc": "图像在X轴的偏移量"
        }
      }
    },
    {
      "id": "set-image-offset-y",
      "scriptName": "SetImageOffsetY",
      "category": "image",
      "list-name": "设置图像Y偏移",
      "display-text": "设置图像偏移Y为[i]{0}[/i]",
      "description": "设置图片内Y轴偏移量",
      "params": {
        "offset-y": {
          "type": "number",
          "name": "Y偏移值",
          "desc": "图像在Y轴的偏移量"
        }
      }
    },
    {
      "id": "set-image-scale-x",
      "scriptName": "SetImageScaleX",
      "category": "image",
      "list-name": "设置图像X缩放",
      "display-text": "设置图像X缩放为[i]{0}[/i]",
      "description": "设置图片内X轴缩放量",
      "params": {
        "scale-x": {
          "type": "number",
          "name": "X轴比例",
          "desc": "图像在 X 轴的缩放比例，以百分比表示。"
        }
      }
    },
    {
      "id": "set-image-scale-y",
      "scriptName": "SetImageScaleY",
      "category": "image",
      "list-name": "设置图像Y缩放",
      "display-text": "设置图像Y缩放为[i]{0}[/i]",
      "description": "设置图片内Y轴缩放量",
      "params": {
        "scale-y": {
          "type": "number",
          "name": "Y轴比例",
          "desc": "图像在 Y 轴的缩放比例，以百分比表示。"
        }
      }
    },
    {
      "id": "set-image-angle",
      "scriptName": "SetImageAngle",
      "category": "image",
      "list-name": "设置图像角度",
      "display-text": "设置图像角度为[i]{0}[/i]°",
      "description": "设置图片角度",
      "params": {
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "设置内部图像的角度，以度数为单位。"
        }
      }
    },
    {
      "id": "set-tile-randomization-enabled",
      "scriptName": "SetTileRandomizationEnabled",
      "category": "tile-randomization",
      "list-name": "启用纹理混合",
      "display-text": "[b]{0}[/b]纹理混合",
      "description": "启用或禁用纹理混合功能。",
      "params": {
        "enabled": {
          "type": "boolean",
          "name": "启用",
          "desc": "启用或禁用纹理混合功能。"
        }
      }
    },
    {
      "id": "set-tile-pos-random",
      "scriptName": "SetTilePosRandom",
      "category": "tile-randomization",
      "list-name": "设置扰动位置",
      "display-text": "设置纹理混合(扰动位置: [i]{0}[/i], [i]{1}[/i])",
      "description": "设置纹理混合的水平和垂直的随机偏移量。",
      "params": {
        "x-random": {
          "type": "number",
          "name": "扰动X",
          "desc": "在水平方向的随机偏移量，从0到100。"
        },
        "y-random": {
          "type": "number",
          "name": "扰动Y",
          "desc": "在垂直方向的随机偏移量，从0到100。"
        }
      }
    },
    {
      "id": "set-tile-angle-random",
      "scriptName": "SetTileAngleRandom",
      "category": "tile-randomization",
      "list-name": "设置扰动角度",
      "display-text": "设置纹理混合(扰动角度: [i]{0}[/i])",
      "description": "设置图块纹理混合的角度扰动量。",
      "params": {
        "angle-random": {
          "type": "number",
          "name": "扰动的角度",
          "desc": "随机角度偏移量，从0到100。"
        }
      }
    },
    {
      "id": "set-tile-blend-margin",
      "scriptName": "SetTileBlendMargin",
      "category": "tile-randomization",
      "list-name": "设置边缘混合",
      "display-text": "设置边缘混合 [i]{0}[/i], [i]{1}[/i]",
      "description": "设置纹理淡出到相邻图块边缘的百分比。",
      "params": {
        "blend-margin-x": {
          "type": "number",
          "name": "边界混合X",
          "desc": "图块在水平方向淡出到相邻边缘的百分比，从0到100。"
        },
        "blend-margin-y": {
          "type": "number",
          "name": "边界混合Y",
          "desc": "图块在垂直方向淡出到相邻边缘的百分比，从0到100。"
        }
      }
    },
    {
      "id": "load-image-from-url",
      "scriptName": "LoadURL",
      "category": "web",
      "list-name": "加载网络图像",
      "display-text": "加载远程图像 [i]{0}[/i] (跨域 {1})",
      "description": "从远程服务器地址下载图像或图像数据。",
      "params": {
        "uri": {
          "type": "string",
          "name": "URI",
          "desc": "要下载数据的远程服务器地址。"
        },
        "cross-origin": {
          "type": "combo",
          "name": "跨域",
          "desc": "用于请求的跨源（CORS）模式。",
          "items": {
            "anonymous": "匿名",
            "none": "无"
          }
        }
      },
      "isAsync": true
    }
  ],
