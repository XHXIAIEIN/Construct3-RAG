{
  "id": "svgpicture",
  "name": "矢量图",
  "description": "显示项目中的 SVG 文件。",
  "type": "plugin",
  "aceCategories": {
    "appearance": "显示",
    "svg": "SVG"
  },
  "conditions": [],
  "actions": [
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "设置混合模式",
      "display-text": "设置混合模式为[i]{0}[/i]",
      "description": "设置此对象的背景混合模式。",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "混合模式",
          "desc": "为此对象选择新的混合模式。",
          "items": {
            "normal": "正常",
            "additive": "叠加",
            "xor": "重叠消除",
            "copy": "覆盖",
            "destination-over": "背景穿透",
            "source-in": "前景剪贴",
            "destination-in": "背景剪贴",
            "source-out": "前景剔除",
            "destination-out": "背景剔除",
            "source-atop": "前景混合",
            "destination-atop": "背景混合",
            "lighten": "变亮",
            "darken": "变暗",
            "multiply": "正片叠底",
            "screen": "滤色"
          }
        }
      }
    },
    {
      "id": "set-image",
      "scriptName": "SetImage",
      "category": "svg",
      "list-name": "设置图像",
      "display-text": "设置图像为[i]{0}[/i]",
      "description": "设置从项目文件中显示的SVG图像。",
      "params": {
        "file": {
          "type": "projectfile",
          "name": "文件",
          "desc": "从项目文件中加载SVG图像。"
        }
      },
      "isAsync": true
    },
    {
      "id": "set-image-by-name",
      "scriptName": "SetImageByName",
      "category": "svg",
      "list-name": "设置图像 (根据名称)",
      "display-text": "设置图像为[i]{0}[/i]",
      "description": "从字符串对应的项目文件中显示的SVG图像。",
      "params": {
        "file": {
          "type": "string",
          "name": "文件",
          "desc": "用于加载SVG图像的项目文件的名称字符串"
        }
      },
      "isAsync": true
    }
  ],
  "expressions": [],
  "properties": {
    "svg-file": {
      "name": "SVG文件",
      "desc": "选择要显示的SVG文件。"
    },
    "view-image": {
      "name": "图像",
      "desc": "单击查看对象的图像文件。",
      "link-text": "查看"
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "在场景开始时，对象是否可见。"
    },
    "origin": {
      "name": "图像原点",
      "desc": "选择图像原点的位置。",
      "items": {
        "top-left": "左上",
        "top": "顶部",
        "top-right": "右上",
        "left": "左",
        "center": "中心",
        "right": "右",
        "bottom-left": "左下",
        "bottom": "底部",
        "bottom-right": "右下"
      }
    }
  }
}