{
  "id": "mouse",
  "name": "鼠标",
  "description": "读取用户鼠标的相关操作。",
  "type": "plugin",
  "aceCategories": {
    "cursor": "光标",
    "mouse": "鼠标键",
    "pointer-lock": "光标锁",
    "wheel": "滚轮"
  },
  "conditions": [
    {
      "id": "on-click",
      "scriptName": "OnClick",
      "category": "mouse",
      "list-name": "鼠标点击",
      "display-text": "[b]{1}[/b]鼠标[b]{0}[/b]",
      "description": "单击或双击鼠标按键时触发。",
      "params": {
        "mouse-button": {
          "type": "combo",
          "name": "鼠标键",
          "desc": "选择要检查的鼠标按键。",
          "items": {
            "left": "左键",
            "middle": "中键",
            "right": "右键",
            "button-4": "鼠标键4",
            "button-5": "鼠标键5"
          }
        },
        "click-type": {
          "type": "combo",
          "name": "动作",
          "desc": "选择要检查的点击类型。注意，只有 '左键' 可以触发 '双击' 动作。",
          "items": {
            "clicked": "点击",
            "double-clicked": "双击"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-click",
      "scriptName": "OnAnyClick",
      "category": "mouse",
      "list-name": "任意点击",
      "display-text": "任意点击",
      "description": "单击或双击任意鼠标按键时触发。",
      "isTrigger": true
    },
    {
      "id": "mouse-button-is-down",
      "scriptName": "IsButtonDown",
      "category": "mouse",
      "list-name": "按住鼠标键",
      "display-text": "按住鼠标[b]{0}[/b]",
      "description": "检测当前是否按下鼠标按钮。",
      "params": {
        "mouse-button": {
          "type": "combo",
          "name": "鼠标键",
          "desc": "选择要检查的鼠标按钮。",
          "items": {
            "left": "左键",
            "middle": "中键",
            "right": "右键",
            "button-4": "鼠标键4",
            "button-5": "鼠标键5"
          }
        }
      }
    },
    {
      "id": "on-button-released",
      "scriptName": "OnRelease",
      "category": "mouse",
      "list-name": "松开鼠标键",
      "display-text": "松开鼠标[b]{0}[/b]",
      "description": "释放鼠标按钮时触发。",
      "params": {
        "mouse-button": {
          "type": "combo",
          "name": "鼠标键",
          "desc": "选择要检查的鼠标按钮。",
          "items": {
            "left": "左键",
            "middle": "中键",
            "right": "右键",
            "button-4": "鼠标键4",
            "button-5": "鼠标键5"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-object-clicked",
      "scriptName": "OnObjectClicked",
      "category": "mouse",
      "list-name": "点击对象",
      "display-text": "[b]{1}[/b]鼠标[b]{0}[/b] {2}",
      "description": "单击或双击对象时触发。",
      "params": {
        "mouse-button": {
          "type": "combo",
          "name": "鼠标键",
          "desc": "选择要检查的鼠标按钮。",
          "items": {
            "left": "左键",
            "middle": "中键",
            "right": "右键",
            "button-4": "鼠标键4",
            "button-5": "鼠标键5"
          }
        },
        "click-type": {
          "type": "combo",
          "name": "动作",
          "desc": "选择要检查的点击类型。注意，只有 '左键' 可以触发 '双击' 动作。",
          "items": {
            "clicked": "点击",
            "double-clicked": "双击"
          }
        },
        "object-clicked": {
          "type": "object",
          "name": "被点击的对象",
          "desc": "选择要检查单击的对象。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "cursor-is-over-object",
      "scriptName": "IsOverObject",
      "category": "mouse",
      "list-name": "悬停在对象",
      "display-text": "悬停在 {0}",
      "description": "检查鼠标光标是否在对象上。",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查鼠标悬停的对象。"
        }
      }
    },
    {
      "id": "on-mouse-wheel",
      "scriptName": "OnWheel",
      "category": "mouse",
      "list-name": "转动滚轮",
      "display-text": "滚轮{0}转动",
      "description": "滚动鼠标滚轮时触发。",
      "params": {
        "direction": {
          "type": "combo",
          "name": "方向",
          "desc": "选择检测鼠标滚轮滚动的方向。",
          "items": {
            "down": "向下",
            "up": "向上",
            "any": "任意"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-pointer-locked",
      "scriptName": "OnPointerLocked",
      "category": "pointer-lock",
      "list-name": "光标锁启用",
      "display-text": "光标锁启用",
      "description": "执行 '锁定光标' 动作后，光标锁定成功时触发。",
      "isTrigger": true
    },
    {
      "id": "on-pointer-unlocked",
      "scriptName": "OnPointerUnlocked",
      "category": "pointer-lock",
      "list-name": "光标锁解除",
      "display-text": "光标锁解除",
      "description": "在 '启用光标锁' 条件触发后，再次将光标锁解除时触发。",
      "isTrigger": true
    },
    {
      "id": "on-pointer-lock-error",
      "scriptName": "OnPointerLockError",
      "category": "pointer-lock",
      "list-name": "光标锁异常",
      "display-text": "光标锁异常",
      "description": "光标锁出现异常错误时触发。",
      "isTrigger": true
    },
    {
      "id": "has-pointer-lock",
      "scriptName": "HasPointerLock",
      "category": "pointer-lock",
      "list-name": "已启用光标锁",
      "display-text": "已启用光标锁",
      "description": "光标已经被锁定时触发。"
    },
    {
      "id": "on-movement",
      "scriptName": "OnMovement",
      "category": "pointer-lock",
      "list-name": "移动鼠标",
      "display-text": "移动鼠标",
      "description": "鼠标每次发生移动时触发。注意，这也适用于没有光标锁的情况。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "set-cursor-style2",
      "scriptName": "SetCursor2",
      "category": "mouse",
      "list-name": "设置光标样式",
      "display-text": "设置光标样式为[b]{0}[/b]",
      "description": "更改鼠标的光标样式。",
      "params": {
        "cursor-style": {
          "type": "combo-grouped",
          "name": "光标样式",
          "desc": "选择要设置的光标样式。"
        }
      }
    },
    {
      "id": "set-cursor-from-sprite",
      "scriptName": "SetCursorSprite",
      "category": "mouse",
      "list-name": "设置指针样式为精灵",
      "display-text": "设置指针样式为{0}",
      "description": "将鼠标指针样式设置为精灵当前播放动画的图像。注意，此精灵对象需要放置在场景中。",
      "params": {
        "sprite": {
          "type": "object",
          "name": "精灵",
          "desc": "选择一个精灵对象作为指针的图像。"
        }
      }
    },
    {
      "id": "request-pointer-lock",
      "scriptName": "RequestPointerLock",
      "category": "pointer-lock",
      "list-name": "启用光标锁",
      "display-text": "启用光标锁 (禁用指针加速: [i]{0}[/i])",
      "description": "请求锁定光标指针，通常用于控制3D相机。",
      "params": {
        "unadjusted-movement": {
          "type": "boolean",
          "name": "禁用指针加速",
          "desc": "禁用系统的指针加速调整，以访问原始鼠标输入。"
        }
      }
    },
    {
      "id": "release-pointer-lock",
      "scriptName": "ReleasePointerLock",
      "category": "pointer-lock",
      "list-name": "解除光标锁",
      "display-text": "解除光标锁",
      "description": "释放光标锁，恢复正常的鼠标光标行为。"
    }
  ],
  "expressions": [
    {
      "id": "x",
      "scriptName": "X",
      "category": "cursor",
      "translated-name": "X",
      "description": "获取鼠标在场景的X坐标。可选填入图层参数，获取在特定图层的位置，考虑滚动、旋转、缩放的结果。",
      "returnType": "number"
    },
    {
      "id": "y",
      "scriptName": "Y",
      "category": "cursor",
      "translated-name": "Y",
      "description": "获取鼠标在场景中的Y坐标。可选填入图层参数，获取在特定图层的位置，考虑滚动、旋转、缩放的结果。",
      "returnType": "number"
    },
    {
      "id": "absolutex",
      "scriptName": "AbsoluteX",
      "category": "cursor",
      "translated-name": "绝对坐标X",
      "description": "获取鼠标在画布中的绝对坐标X。",
      "returnType": "number"
    },
    {
      "id": "absolutey",
      "scriptName": "AbsoluteY",
      "category": "cursor",
      "translated-name": "绝对坐标Y",
      "description": "获取鼠标在画布中的绝对坐标Y。",
      "returnType": "number"
    },
    {
      "id": "movement-x",
      "scriptName": "MovementX",
      "category": "pointer-lock",
      "translated-name": "移动向量X",
      "description": "开启指针锁定时，获得指针的水平运动量。",
      "returnType": "number"
    },
    {
      "id": "movement-y",
      "scriptName": "MovementY",
      "category": "pointer-lock",
      "translated-name": "移动向量Y",
      "description": "开启指针锁定时，获得指针的垂直运动量。",
      "returnType": "number"
    },
    {
      "id": "wheel-delta-x",
      "scriptName": "WheelDeltaX",
      "category": "wheel",
      "translated-name": "滚轮增量X",
      "description": "获取鼠标滚轮在当前触发器的X轴滚动量。",
      "returnType": "number"
    },
    {
      "id": "wheel-delta-y",
      "scriptName": "WheelDeltaY",
      "category": "wheel",
      "translated-name": "滚轮增量Y",
      "description": "获取鼠标滚轮在当前触发器的Y轴滚动量。",
      "returnType": "number"
    },
    {
      "id": "wheel-delta-z",
      "scriptName": "WheelDeltaZ",
      "category": "wheel",
      "translated-name": "滚轮增量Z",
      "description": "获取鼠标滚轮在当前触发器的Z轴滚动量。",
      "returnType": "number"
    }
  ],
  "properties": {}
}