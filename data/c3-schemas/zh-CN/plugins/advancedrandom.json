{
  "id": "advancedrandom",
  "name": "高级随机",
  "description": "更高级的随机数生成器，可以生成概率表，或指定随机种子。",
  "type": "plugin",
  "aceCategories": {
    "advancedrandom": "高级随机",
    "gradients": "渐变",
    "permutation-tables": "序列表",
    "probability-tables": "概率表"
  },
  "conditions": [],
  "actions": [
    {
      "id": "createGradient",
      "scriptName": "CreateGradient",
      "category": "gradients",
      "list-name": "生成渐变",
      "display-text": "生成线性渐变 (类型: [b]{1}[/b], 名称: [b]{0}[/b])",
      "description": "生成一个线性渐变。",
      "params": {
        "name": {
          "type": "string",
          "name": "名称",
          "desc": "渐变的名称，用于后续事件的使用。"
        },
        "isColor": {
          "type": "combo",
          "name": "类型",
          "desc": "设置渐变生成的内容，是数值还是颜色。",
          "items": {
            "number": "数值",
            "color": "颜色"
          }
        }
      }
    },
    {
      "id": "addStop",
      "scriptName": "AddStop",
      "category": "gradients",
      "list-name": "添加经过点",
      "display-text": "添加渐变经过点(位置: [b]{0}[/b], 数值: [b]{1}[/b])",
      "description": "在当前渐变的位置添加经过点",
      "params": {
        "position": {
          "type": "number",
          "name": "终点位置",
          "desc": "要添加的渐变经过点的位置。可以是任何数字，通常建议在 0-1 范围内。"
        },
        "value": {
          "type": "number",
          "name": "终点数值",
          "desc": "添加到经过点的值。可以是任何数字，或使用 rgbEx 或 rgba 表达式指定颜色。"
        }
      }
    },
    {
      "id": "setGradient",
      "scriptName": "SetGradient",
      "category": "gradients",
      "list-name": "设置当前渐变",
      "display-text": "设置当前渐变为[b]{0}[/b]",
      "description": "设置当前的渐变，用于后续的引用。",
      "params": {
        "name": {
          "type": "string",
          "name": "名称",
          "desc": "渐变的名称"
        }
      }
    },
    {
      "id": "createPermutationTable",
      "scriptName": "CreatePermutationTable",
      "category": "permutation-tables",
      "list-name": "创建序列表",
      "display-text": "创建序列表 (起始: {1}, 长度: {0})",
      "description": "创建一个随机排序的数字序列。",
      "params": {
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "序列表的长度。"
        },
        "offset": {
          "type": "number",
          "name": "起始值",
          "desc": "序列表中的首位最小值。"
        }
      }
    },
    {
      "id": "shufflePermutationTable",
      "scriptName": "ShufflePermutationTable",
