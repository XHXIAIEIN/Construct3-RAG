      "display-text": "导入概率表[b]{0}[/b] (JSON: [b]{1}[/b])",
      "description": "从 JSON 字符串创建新的加权概率表。数据结构使用权重和名称组成的数组。",
      "params": {
        "name": {
          "type": "string",
          "name": "名称",
          "desc": "概率表的名称"
        },
        "json": {
          "type": "string",
          "name": "JSON",
          "desc": "用于序列化概率表的JSON字符串"
        }
      }
    },
    {
      "id": "addProbabilityEntry",
      "scriptName": "AddProbabilityEntry",
      "category": "probability-tables",
      "list-name": "增加概率权重",
      "display-text": "添加元素 [b]{0}[/b] 权重 [b]{1}[/b]",
      "description": "在当前概率表中添加元素",
      "params": {
        "value": {
          "type": "any",
          "name": "数值",
          "desc": "元素的值"
        },
        "weight": {
          "type": "number",
          "name": "元素权重",
          "desc": "此在列表中出现的概率权重"
        }
      }
    },
    {
      "id": "removeProbabilityEntry",
      "scriptName": "RemoveProbabilityEntry",
      "category": "probability-tables",
      "list-name": "删除概率元素",
      "display-text": "移除权重为 [b]{1}[/b] 的 [b]{0}[/b] 元素",
      "description": "从当前概率表中删除与指定权重相同的元素。填写 0 时指定第 1 项。",
      "params": {
        "value": {
          "type": "any",
          "name": "数值",
          "desc": "元素的数值"
        },
        "weight": {
          "type": "number",
          "name": "元素权重",
          "desc": "此元素的权重，只有权重相同的才会被删除。填写 0 则匹配第 1 项。"
        }
      }
    },
    {
      "id": "setProbabilityTable",
      "scriptName": "SetProbabilityTable",
      "category": "probability-tables",
      "list-name": "设置当前概率表",
      "display-text": "设置当前概率表为 [b]{0}[/b]",
      "description": "设置当前概率表",
      "params": {
        "name": {
          "type": "string",
          "name": "名称",
          "desc": "概率表的名称"
        }
      }
    },
