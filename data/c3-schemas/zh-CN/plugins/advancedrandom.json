      "list-name": "打乱序列表",
      "display-text": "打乱序列表",
      "description": "将当前序列表的位置排列随机打乱。"
    },
    {
      "id": "createProbabilityTable",
      "scriptName": "CreateProbabilityTable",
      "category": "probability-tables",
      "list-name": "创建概率表",
      "display-text": "创建概率表 [b]{0}[/b]",
      "description": "创建一个加权概率表，指定每个元素出现的概率。",
      "params": {
        "name": {
          "type": "string",
          "name": "名称",
          "desc": "概率表名称"
        }
      }
    },
    {
      "id": "createProbabilityTableFromJSON",
