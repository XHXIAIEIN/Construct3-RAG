{
  "id": "filechooser",
  "name": "文件选择",
  "description": "允许用户从其设备中选择文件，并访问所选文件。",
  "type": "plugin",
  "aceCategories": {
    "file-chooser": "文件选择器"
  },
  "conditions": [
    {
      "id": "on-changed",
      "scriptName": "OnChanged",
      "category": "file-chooser",
      "list-name": "选择新文件",
      "display-text": "选择新文件",
      "description": "在进行文件选择时触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "release-file",
      "scriptName": "ReleaseFile",
      "category": "file-chooser",
      "list-name": "释放文件",
      "display-text": "释放文件 [i]{0}[/i]",
      "description": "释放文件，使其不再使用内存。",
      "params": {
        "file-url": {
          "type": "string",
          "name": "文件URL",
          "desc": "要释放的文件的URL。"
        }
      }
    },
    {
      "id": "click",
      "scriptName": "Click",
      "category": "file-chooser",
      "list-name": "点击",
      "display-text": "点击(激活文件选择器)",
      "description": "激活文件选择器，就像点击了文件选择器按钮一样。注意，这可能只在用户输入触发器中有效。"
    },
    {
      "id": "clear",
      "scriptName": "Clear",
      "category": "file-chooser",
      "list-name": "清空",
      "display-text": "清空",
      "description": "清除当前所有已选择的文件，恢复为初始状态。"
    }
  ],
  "expressions": [
    {
      "id": "filecount",
      "scriptName": "FileCount",
      "category": "file-chooser",
      "translated-name": "文件数量",
      "description": "所选文件的数量。",
      "returnType": "number"
    },
    {
      "id": "filenameat",
      "scriptName": "FileNameAt",
      "category": "file-chooser",
      "translated-name": "获取文件名称",
      "description": "索引中所选文件的名称。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文件在列表的索引，从 0 开始计数。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "filesizeat",
      "scriptName": "FileSizeAt",
      "category": "file-chooser",
      "translated-name": "获取文件大小",
      "description": "索引处所选文件的大小。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文件在列表的索引，从 0 开始计数。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "filetypeat",
      "scriptName": "FileTypeAt",
      "category": "file-chooser",
      "translated-name": "获取文件类型",
      "description": "索引中所选文件的MIME类型。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文件在列表的索引，从 0 开始计数。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "fileurlat",
      "scriptName": "FileURLAt",
      "category": "file-chooser",
      "translated-name": "获取文件链接",
      "description": "用于在索引处访问所选文件数据的URL。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文件在列表的索引，从 0 开始计数。"
        }
      },
      "returnType": "string"
    }
  ],
  "properties": {
    "accept": {
      "name": "同意",
      "desc": "文件类型过滤器，例如 .png 或 image/*"
    },
    "select": {
      "name": "选择",
      "desc": "是否允许单个或多个文件选择。",
      "items": {
        "single": "单个",
        "multiple": "多人"
      }
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "在场景开始时，对象是否可见。"
    },
    "id": {
      "name": "ID",
      "desc": "控件的可选ID，允许使用页面HTML中的CSS设置样式。"
    },
    "class": {
      "name": "Class",
      "desc": "可选项，添加 Class 元素来设置样式。"
    }
  }
}