            "sha-256": "SHA-256",
            "sha-384": "SHA-384",
            "sha-512": "SHA-512"
          }
        },
        "tag": {
          "type": "string",
          "name": "标签(可选)",
          "desc": "用于识别不同的哈希加密动作，方便进行管理。"
        }
      },
      "isAsync": true
    },
    {
      "id": "encrypt-binary",
      "scriptName": "EncryptBinary",
      "category": "encryption",
      "list-name": "加密数据(二进制对象)",
      "display-text": "加密 {0} (算法: [i]{1}[/i], 密钥: [i]{2}[/i], 加密次数: [i]{3}[/i], 标签: [i]{4}[/i])",
      "description": "通过密码学算法，对二进制数据对象的内容进行加密。",
      "params": {
        "binary-data": {
          "type": "object",
          "name": "来源",
          "desc": "选择二进制数据对象，对其数据内容进行加密。"
        },
        "algorithm": {
          "type": "combo",
          "name": "算法",
          "desc": "要使用的加密算法。",
          "items": {
            "aes-gcm": "AES-GCM"
          }
        },
        "password": {
          "type": "string",
          "name": "密钥",
          "desc": "用来加密数据的密钥（区分大小写）。反向解密时，只有相同的密钥才能正确读取内容。"
        },
        "iterations": {
          "type": "number",
          "name": "迭代",
          "desc": "对内容反复加密的次数。越高的值需要更长的生成时间，但会更加安全，更难被破解。"
        },
        "tag": {
          "type": "string",
          "name": "标签(可选)",
          "desc": "用于识别不同的加密动作，方便进行管理。"
        }
      },
      "isAsync": true
    },
