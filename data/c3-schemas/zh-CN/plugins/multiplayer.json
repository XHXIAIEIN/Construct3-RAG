          "type": "combo",
          "name": "精度",
          "desc": "选择要同步的上述数据的精度，更高的精度需要使用更多的带宽。",
          "items": {
            "high-double-8-bytes": "高 (双精度, 8字节)",
            "normal-float-4-bytes": "常规 (单精度, 4字节)",
            "low-int16-2-bytes": "低 (16位整数, 2字节)"
          },
          "initialValue": "normal-float-4-bytes"
        },
        "bandwidth": {
          "type": "combo",
          "name": "带宽",
          "desc": "选择此对象的带宽同步设置。建议只在运动峰值可预测的情况下选择 '低带宽' 模式 (例如匀速直线运动) 。",
          "items": {
            "normal-bandwidth-unpredictable": "正常 (不可预测)",
            "low-bandwidth-highly-predictable": "低 (峰值可预测)",
            "very-low-bandwidth-essentially-static": "非常低 (几乎静态)"
          }
        }
      }
    },
    {
