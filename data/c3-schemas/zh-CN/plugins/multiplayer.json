          "type": "combo",
          "name": "模式",
          "desc": "此消息的传输模式。'有序可靠' 和 '无序可靠' 均保证信息可以被送达，因延迟而推迟接收时间。'不可靠' 在网络不佳时可能被丢失。",
          "items": {
            "reliable-ordered": "有序可靠",
            "reliable-unordered": "无序可靠",
            "unreliable": "不可靠"
          }
        }
      }
    },
    {
      "id": "simulate-latency",
      "scriptName": "SimulateLatency",
      "category": "room",
      "list-name": "模拟网络延迟",
      "display-text": "模拟网络延迟 [i]{0}[/i]秒 (随机波动:[i]{1}[/i], 丢包概率: [i]{2}[/i])",
      "description": "模拟发送与接收消息时产生的延迟和数据丢失的过程。用于在本地的房主端测试，模拟遇到现实中的网络延迟时可能出现的影响。",
      "params": {
        "latency": {
          "type": "number",
          "name": "延迟",
          "desc": "要模拟的网络延迟，以秒为单位。这将导致发送和接收的消息都被人为进行延迟。"
        },
        "pdv": {
          "type": "number",
          "name": "延迟波动",
          "desc": "在标准网络延迟的基础上，增加一个从 0 到目标值之间的随机秒数 (PDV)，用于模拟真实环境中，玩家与本机发送或接受消息时的延迟。"
        },
        "packet-loss": {
          "type": "number",
          "name": "丢包概率",
          "desc": "模拟数据包丢失的百分比概率，数值范围从 0 到 1，如 0.05 表示有 5％ 的几率丢失数据。用于模拟在发送和接收的消息可能被人为的忽略或进一步延迟。"
        }
      }
    },
    {
      "id": "sync-object-2",
      "scriptName": "SyncObject2",
      "category": "room",
      "list-name": "同步对象",
      "display-text": "同步对象 {0}([b]X[/b]: [i]{1}[/i], [b]Y[/b]: [i]{2}[/i], [b]角度[/b]: [i]{3}[/i], 精度 [i]{4}[/i], 带宽: [i]{5}[/i])",
