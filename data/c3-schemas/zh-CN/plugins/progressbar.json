{
  "id": "progressbar",
  "name": "进度条",
  "description": "浏览器基本样式的进度条组件，通常用于跟踪系统级的任务进程。如果你希望显示游戏生命条、进度等，建议使用九宫图、精灵、平铺图。",
  "type": "plugin",
  "aceCategories": {
    "progress-bar": "进度条"
  },
  "conditions": [
    {
      "id": "on-clicked",
      "scriptName": "OnClicked",
      "category": "progress-bar",
      "list-name": "点击",
      "display-text": "点击",
      "description": "当进度条被点击时触发",
      "isTrigger": true
    },
    {
      "id": "compare-progress",
      "scriptName": "CompareProgress",
      "category": "progress-bar",
      "list-name": "比较进度",
      "display-text": "进度 {0} [i]{1}[/i]",
      "description": "比较当前进度值",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "要比较的进度值。"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-tooltip",
      "scriptName": "SetTooltip",
      "category": "progress-bar",
      "list-name": "设置工具提示",
      "display-text": "设置工具提示为{0}",
      "description": "设置进度条的提示信息",
      "params": {
        "tooltip": {
          "type": "string",
          "name": "提示",
          "desc": "要在进度条上设置的工具提示。"
        }
      }
    },
    {
      "id": "set-progress",
      "scriptName": "SetProgress",
      "category": "progress-bar",
      "list-name": "设置进度",
      "display-text": "设置进度为[b]{0}[/b]",
      "description": "设置栏的进度值。",
      "params": {
        "value": {
          "type": "number",
          "name": "值",
          "desc": "要设置的进度值。"
        }
      }
    },
    {
      "id": "set-maximum",
      "scriptName": "SetMaximum",
      "category": "progress-bar",
      "list-name": "设置最大值",
      "display-text": "设置最大值为[b]{0}[/b]",
      "description": "设置栏的最大进度值。",
      "params": {
        "maximum": {
          "type": "number",
          "name": "最大值",
          "desc": "进度的新最大值。"
        }
      }
    },
    {
      "id": "make-indeterminate",
      "scriptName": "SetIndeterminate",
      "category": "progress-bar",
      "list-name": "使不确定",
      "display-text": "使不确定",
      "description": "使进度条显示不确定（未知）进度。"
    }
  ],
  "expressions": [
    {
      "id": "progress",
      "scriptName": "Progress",
      "category": "progress-bar",
      "translated-name": "进度",
      "description": "当前进度值。",
      "returnType": "number"
    },
    {
      "id": "maximum",
      "scriptName": "Maximum",
      "category": "progress-bar",
      "translated-name": "最大值",
      "description": "当前最大进度值。",
      "returnType": "number"
    }
  ],
  "properties": {
    "value": {
      "name": "值",
      "desc": "进度条的初始值。"
    },
    "maximum": {
      "name": "最大值",
      "desc": "进度条的最大值。 对于不确定的进度条，设置为0。"
    },
    "tooltip": {
      "name": "提示",
      "desc": "将鼠标悬停在控件上时显示此文本。"
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "选择在场景开始时，对象是否可见。"
    },
    "id": {
      "name": "ID",
      "desc": "可选的元素ID，允许通过CSS设置样式。"
    },
    "class": {
      "name": "Class",
      "desc": "可选的元素Class，允许通过CSS设置样式。"
    }
  }
}