      "category": "text",
      "translated-name": "标签位置Y",
      "description": "获取指定的 BBCode Tag 标签所在位置的Y坐标。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要使用的标签。"
        },
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "标签的索引编号，从0开始计数。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "tag-width",
      "scriptName": "TagWidth",
      "category": "text",
      "translated-name": "标签宽度",
      "description": "获取指定的 BBCode Tag 标签所在位置的宽度。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要使用的标签。"
        },
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "标签的索引编号，从0开始计数。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "tag-height",
      "scriptName": "TagHeight",
      "category": "text",
      "translated-name": "标签高度",
      "description": "获取指定的 BBCode Tag 标签所在位置的高度。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要使用的标签。"
        },
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "标签的索引编号，从0开始计数。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "as-html",
      "scriptName": "AsHTML",
      "category": "text",
      "translated-name": "导出HTML",
