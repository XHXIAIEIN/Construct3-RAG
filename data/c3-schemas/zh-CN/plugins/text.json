        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要检测的Y坐标。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "tag-count",
      "scriptName": "TagCount",
      "category": "text",
      "translated-name": "标签数量",
      "description": "获取指定的 BBCode Tag 标签数量。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要使用的标签。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "tag-x",
      "scriptName": "TagX",
