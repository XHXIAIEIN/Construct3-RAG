{
  "id": "text",
  "name": "文本",
  "description": "在屏幕中显示一些文本。",
  "type": "plugin",
  "aceCategories": {
    "appearance": "外观",
    "text": "文本"
  },
  "conditions": [
    {
      "id": "compare-text",
      "scriptName": "CompareText",
      "category": "text",
      "list-name": "比较文本",
      "display-text": "文本是[b]{0}[/b] [i]({1})[/i]",
      "description": "比较此对象中的文本。",
      "params": {
        "text-to-compare": {
          "type": "string",
          "name": "要比较的文字",
          "desc": "输入要与对象内容进行比较的文本。"
        },
        "case-sensitivity": {
          "type": "combo",
          "name": "区分大小写",
          "desc": "是否严格区分大小写字母。如果不区分，则 'ABC' 也能匹配到 'abc'。",
          "items": {
            "ignore-case": "忽略大小写",
            "case-sensitive": "区分大小写"
          }
        }
      }
    },
    {
      "id": "is-running-typewriter-text",
      "scriptName": "IsRunningTypewriterText",
      "category": "text",
      "list-name": "打字机正在运行",
      "display-text": "打字机正在运行",
      "description": "检测打字机当前是否正在运行。"
    },
    {
      "id": "on-typewriter-text-finished",
      "scriptName": "OnTypewriterTextFinished",
      "category": "text",
      "list-name": "打字机效果完成",
      "display-text": "打字机效果完成",
      "description": "当文本将所有文字全部显示完成时触发。",
      "isTrigger": true
    },
    {
      "id": "has-tag-at-position",
      "scriptName": "HasTagAtPosition",
      "category": "text",
      "list-name": "位置存在标签",
      "display-text": "位置 ([i]{1}[/i], [i]{2}[/i]) 存在标签 [b]{0}[/b]",
      "description": "检测指定位置是否包含 BBCode Tag 标签。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要检测的标签。"
        },
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要检测的X坐标。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要检测的Y坐标。"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-font-face",
      "scriptName": "SetFontFace",
      "category": "appearance",
      "list-name": "设置字体",
      "display-text": "设置字体为[i]{0}[/i] ([i]{1}[/i])",
      "description": "设置用于显示文本的字体。",
      "params": {
        "font-face": {
          "type": "string",
          "name": "字体",
          "desc": "要设置的新字体名称。"
        },
        "style": {
          "type": "combo",
          "name": "样式",
          "desc": "为指定的字体选择样式。",
          "items": {
            "normal": "常规",
            "bold": "粗体",
            "italic": "斜体",
            "bold-and-italic": "粗体和斜体"
          }
        }
      }
    },
    {
      "id": "set-font-size",
      "scriptName": "SetFontSize",
      "category": "appearance",
      "list-name": "设置字号",
      "display-text": "设置字号为[i]{0}[/i]px",
      "description": "设置字号。",
      "params": {
        "size-pt": {
          "type": "number",
          "name": "字号(px)",
          "desc": "设置字号大小。"
        }
      }
    },
    {
      "id": "set-font-color",
      "scriptName": "SetFontColor",
      "category": "appearance",
      "list-name": "设置字体颜色",
      "display-text": "设置字体颜色为[i]{0}[/i]",
      "description": "设置字体颜色。",
      "params": {
        "color": {
          "type": "number",
          "name": "颜色",
          "desc": "新字体颜色。请使用颜色表达式，例如 rgbEx255(255, 0, 0) 或 rgbEx(100, 0, 0) 等。"
        }
      }
    },
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "设置混合模式",
      "display-text": "设置混合模式为[i]{0}[/i]",
      "description": "设置此对象的背景混合模式。",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "混合模式",
          "desc": "为此对象选择新的混合模式。",
          "items": {
            "normal": "正常",
            "additive": "叠加",
            "xor": "重叠消除",
            "copy": "前景覆盖",
            "destination-over": "背景穿透",
            "source-in": "前景剪贴",
            "destination-in": "背景剪贴",
            "source-out": "前景剔除",
            "destination-out": "背景剔除",
            "source-atop": "前景混合",
            "destination-atop": "背景混合",
            "lighten": "变亮",
            "darken": "变暗",
            "multiply": "正片叠底",
            "screen": "滤色"
          }
        }
      }
    },
    {
      "id": "set-line-height",
      "scriptName": "SetLineHeight",
      "category": "appearance",
      "list-name": "设置行距",
      "display-text": "设置行距为[i]{0}[/i]",
      "description": "基于默认行高的额外间距偏移量，以像素为单位。 默认行间距是0。",
      "params": {
        "line-height": {
          "type": "number",
          "name": "行距",
          "desc": "基于默认行高的额外间距偏移量，以像素为单位。 默认行间距是0。"
        }
      }
    },
    {
      "id": "set-horizontal-alignment",
      "scriptName": "SetHAlign",
      "category": "appearance",
      "list-name": "设置水平对齐",
      "display-text": "将水平对齐设置到 [i]{0}[/i]",
      "description": "设置文本的水平对齐方式。",
      "params": {
        "horizontal-alignment": {
          "type": "combo",
          "name": "水平对齐",
          "desc": "选择一种水平对齐方式。",
          "items": {
            "left": "左对齐",
            "center": "居中",
            "right": "右对齐"
          }
        }
      }
    },
    {
      "id": "set-vertical-alignment",
      "scriptName": "SetVAlign",
      "category": "appearance",
      "list-name": "设置垂直对齐",
      "display-text": "将垂直对齐设置到 [i]{0}[/i]",
      "description": "设置文本的垂直对齐方式。",
      "params": {
        "vertical-alignment": {
          "type": "combo",
          "name": "垂直对齐",
          "desc": "选择一种垂直对齐方式。",
          "items": {
            "top": "顶部",
            "center": "居中",
            "bottom": "底部"
          }
        }
      }
    },
    {
      "id": "set-wrapping",
      "scriptName": "SetWrapping",
      "category": "appearance",
      "list-name": "设置自动换行",
      "display-text": "设置换行规则为[i]{0}[/i]",
      "description": "自动换行的规则，是以空格分隔的词组，还是按每个字符。",
      "params": {
        "wrapping": {
          "type": "combo",
          "name": "自动换行",
          "desc": "当内容超出对象宽度时，自动换行的截断规则。以空格分隔的单词，或按字符截断。选择亚洲语言时，会尽可能避免标点符号换行。",
          "items": {
            "word": "词组",
            "character": "字符",
            "cjk": "亚洲语言"
          }
        }
      }
    },
    {
      "id": "set-text-direction",
      "scriptName": "SetTextDirection",
      "category": "appearance",
      "list-name": "设置书写方向",
      "display-text": "设置书写方向为[i]{0}[/i]",
      "description": "设置文本书写方向，如从左到右，还是从右到左。",
      "params": {
        "direction": {
          "type": "combo",
          "name": "方向",
          "desc": "文本书写的方向。",
          "items": {
            "ltr": "从左向右",
            "rtl": "从右向左"
          }
        }
      }
    },
    {
      "id": "set-resolution-mode",
      "scriptName": "SetResolutionMode",
      "category": "appearance",
      "list-name": "设置缩放模式",
      "display-text": "设置缩放模式为[b]{0}[/b] ([i]{1}[/i])",
      "description": "更改文本的缩放模式。是自适应场景的缩放比例，还是使用固定缩放比例。用于改善文本缩放时产生的模糊感。",
      "params": {
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "设置文本的分辨率渲染方式。选择与当前显示分辨率匹配，或缩放到固定比例。",
          "items": {
            "auto": "自动",
            "fixed": "固定"
          }
        },
        "fixed-scale": {
          "type": "number",
          "name": "固定比例",
          "desc": "选择固定分辨率时，要使用的缩放比例，默认值为 1 。"
        }
      }
    },
    {
      "id": "set-text",
      "scriptName": "SetText",
      "category": "text",
      "list-name": "设置文本",
      "display-text": "设置文本内容为[i]{0}[/i]",
      "description": "设置文本显示的内容。",
      "params": {
        "text": {
          "type": "any",
          "name": "文本",
          "desc": "在 \"双引号\" 里填写要更改的文本内容。字符串中可使用 BBCode 进行文本格式化。在字符串外可通过 & 符号拼接变量或表达式。"
        }
      }
    },
    {
      "id": "append-text",
      "scriptName": "AppendText",
      "category": "text",
      "list-name": "追加文本",
      "display-text": "追加文本 [i]{0}[/i]",
      "description": "将文本添加到现有文本的末尾。",
      "params": {
        "text": {
          "type": "any",
          "name": "文本",
          "desc": "在当前文本内容后面继续追加的内容。如需换行，请使用 & 符号连接字符串与换行表达式。例如：\"文本1\" & newline & \"文本2\""
        }
      }
    },
    {
      "id": "typewriter-text",
      "scriptName": "TypewriterText",
      "category": "text",
      "list-name": "逐字显示",
      "display-text": "在 [i]{1}[/i] 秒内，逐字显示[i]{0}[/i]",
      "description": "在一段时间内，逐字显示一串文本，直到完全显示。实现打字机效果。",
      "params": {
        "text": {
          "type": "any",
          "name": "文本",
          "desc": "要逐字显示的文本。"
        },
        "duration": {
          "type": "number",
          "name": "持续时间",
          "desc": "文本完全显示所需的总时间，以秒为单位。如希望每秒显示字符数，可使用 len(Self.PlainText) / 10 表达式，表示每秒显示 10 个字符。"
        }
      }
    },
    {
      "id": "typewriter-finish",
      "scriptName": "TypewriterFinish",
      "category": "text",
      "list-name": "立即显示完成",
      "display-text": "立即显示完成",
      "description": "强制将打字机效果立即显示所有文本。"
    },
    {
      "id": "change-icon-set",
      "scriptName": "ChangeIconSet",
      "category": "text",
      "list-name": "更换图标集",
      "display-text": "更换图标集: {0}",
      "description": "更改用于文本图标的精灵对象。",
      "params": {
        "icon-set": {
          "type": "object",
          "name": "图标集",
          "desc": "启用富文本功能时，允许使用 [icon=tag] 标签引用带有动画帧标签的精灵对象的图像，在文本中显示图标。"
        }
      }
    },
    {
      "id": "update-html",
      "scriptName": "UpdateHTML",
      "category": "text",
      "list-name": "转换HTML",
      "display-text": "转换HTML",
      "description": "将当前的文本转换为HTML字符串，并更新 '转换字符串' 表达式的返回内容。",
      "isAsync": true
    },
    {
      "id": "set-read-aloud",
      "scriptName": "SetReadAloud",
      "category": "text",
      "list-name": "设置文本朗读",
      "display-text": "[i]{0}[/i]朗读内容",
      "description": "使用屏幕阅读器时，当文本首次出现或内容发生变化时，允许设备的辅助功能朗读这段文本。",
      "params": {
        "enable": {
          "type": "boolean",
          "name": "启用",
          "desc": "是否允许朗读"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "facename",
      "scriptName": "FaceName",
      "category": "appearance",
      "translated-name": "字体名称",
      "description": "获取当前的字体名称。",
      "returnType": "string"
    },
    {
      "id": "facesize",
      "scriptName": "FaceSize",
      "category": "appearance",
      "translated-name": "字体大小",
      "description": "获取当前的字体大小（pt）。",
      "returnType": "number"
    },
    {
      "id": "lineheight",
      "scriptName": "LineHeight",
      "category": "appearance",
      "translated-name": "行高",
      "description": "获取行间距",
      "returnType": "number"
    },
    {
      "id": "textwidth",
      "scriptName": "TextWidth",
      "category": "appearance",
      "translated-name": "文本宽度",
      "description": "获取文本的实际内容宽度，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "textheight",
      "scriptName": "TextHeight",
      "category": "appearance",
      "translated-name": "文本高度",
      "description": "获取文本的实际内容高度，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "text",
      "scriptName": "Text",
      "category": "text",
      "translated-name": "文本内容",
      "description": "获取对象的文本。",
      "returnType": "string"
    },
    {
      "id": "plaintext",
      "scriptName": "PlainText",
      "category": "text",
