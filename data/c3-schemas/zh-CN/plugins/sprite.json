{
  "id": "sprite",
  "name": "精灵",
  "description": "可以添加多张图片组成动画的对象，它是大多数项目的重要组成部分。",
  "type": "plugin",
  "aceCategories": {
    "animations": "动画",
    "appearance": "显示",
    "collisions": "碰撞",
    "misc": "其他",
    "size-position": "尺寸和位置",
    "web": "网络图像"
  },
  "conditions": [
    {
      "id": "is-animation-playing",
      "scriptName": "IsAnimPlaying",
      "category": "animations",
      "list-name": "正在播放",
      "display-text": "正在播放 {0} 动画",
      "description": "检测当前正在播放哪个的动画。",
      "params": {
        "animation": {
          "type": "animation",
          "name": "动画",
          "desc": "要检测的动画名称。"
        }
      }
    },
    {
      "id": "compare-animation-frame",
      "scriptName": "CompareFrame",
      "category": "animations",
      "list-name": "比较帧数",
      "display-text": "动画帧 {0} {1}",
      "description": "测试当前显示的动画帧。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "number": {
          "type": "number",
          "name": "数字",
          "desc": "要比较的动画帧编号（从0开始计数）。"
        }
      }
    },
    {
      "id": "on-animation-finished",
      "scriptName": "OnAnimFinished",
      "category": "animations",
      "list-name": "动画播放完成",
      "display-text": "动画 {0} 播放完成",
      "description": "动画播放结束时触发。",
      "params": {
        "animation": {
          "type": "animation",
          "name": "动画",
          "desc": "要检测的动画名称。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-animation-finished",
      "scriptName": "OnAnyAnimFinished",
      "category": "animations",
      "list-name": "任意动画播放完成",
      "display-text": "任意动画播放完成",
      "description": "任意动画播放完成时触发",
      "isTrigger": true
    },
    {
      "id": "on-animation-frame-changed",
      "scriptName": "OnFrameChanged",
      "category": "animations",
      "list-name": "切换动画帧",
      "display-text": "切换动画帧",
      "description": "动画帧切换时触发",
      "isTrigger": true
    },
    {
      "id": "compare-animation-speed",
      "scriptName": "CompareAnimSpeed",
      "category": "animations",
      "list-name": "比较播放速度",
      "display-text": "动画播放速度 {0} {1}",
      "description": "比较当前动画帧播放速度",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "number": {
          "type": "number",
          "name": "数字",
          "desc": "要比较的动画速度。"
        }
      }
    },
    {
      "id": "compare-animation-frame-tag",
      "scriptName": "CompareFrameTag",
      "category": "animations",
      "list-name": "比较动画帧标签",
      "display-text": "动画帧标签 {0} {1}",
      "description": "与当前动画帧的标签进行比较。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "tag": {
          "type": "animationframe",
          "name": "标签",
          "desc": "用于比较的动画帧标签。"
        }
      }
    },
    {
      "id": "is-mirrored",
      "scriptName": "IsMirrored",
      "category": "appearance",
      "list-name": "已左右翻转",
      "display-text": "已左右翻转",
      "description": "测试对象是否已被设置 '左右翻转' 动作。"
    },
    {
      "id": "is-flipped",
      "scriptName": "IsFlipped",
      "category": "appearance",
      "list-name": "已上下翻转",
      "display-text": "已上下翻转",
      "description": "测试对象是否已被设置 上下翻转' 操作。"
    },
    {
      "id": "collisions-enabled",
      "scriptName": "IsCollisionEnabled",
      "category": "collisions",
      "list-name": "已启用碰撞",
      "display-text": "已启用碰撞",
      "description": "检测对象的碰撞功能是否已启用，并且允许触发碰撞事件。"
    },
    {
      "id": "on-image-url-loaded",
      "scriptName": "OnURLLoaded",
      "category": "web",
      "list-name": "网络图像加载完成",
      "display-text": "网络图像加载完成",
      "description": "执行 '加载远程图像' 动作，图像加载完成时触发。",
      "isTrigger": true
    },
    {
      "id": "on-image-url-failed",
      "scriptName": "OnURLFailed",
      "category": "web",
      "list-name": "网络图像加载失败",
      "display-text": "网络图像加载失败",
      "description": "执行 '加载网络图像' 动作后，图像加载失败时触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "stop-animation",
      "scriptName": "StopAnim",
      "category": "animations",
      "list-name": "停止播放",
      "display-text": "停止播放动画",
      "description": "停止播放当前动画。"
    },
    {
      "id": "start-animation",
      "scriptName": "StartAnim",
      "category": "animations",
      "list-name": "开始播放",
      "display-text": "从{0}开始播放动画",
      "description": "如果已停止，则启动当前动画。",
      "params": {
        "from": {
          "type": "combo",
          "name": "从",
          "desc": "选择是否将动画恢复或倒回到第一帧。",
          "items": {
            "current-frame": "当前帧",
            "beginning": "起始帧"
          }
        }
      }
    },
    {
      "id": "set-animation",
      "scriptName": "SetAnim",
      "category": "animations",
      "list-name": "设置动画",
      "display-text": "设置动画为[b]{0}[/b](从{1}播放)",
      "description": "设置当前动画",
      "params": {
        "animation": {
          "type": "animation",
          "name": "动画",
          "desc": "要设置的动画的名称。"
        },
        "from": {
          "type": "combo",
          "name": "开始",
          "desc": "选择从当前帧开始播放，或是从动画第一帧播放。",
          "items": {
            "current-frame": "当前帧",
            "beginning": "起始帧"
          },
          "initialValue": "beginning"
        }
      }
    },
    {
      "id": "set-animation-frame",
      "scriptName": "SetAnimFrame",
      "category": "animations",
      "list-name": "设置动画帧",
      "display-text": "设置动画帧为[b]{0}[/b]",
      "description": "通过动画帧的编号或标签，设置当前动画帧。",
      "params": {
        "frame-number": {
          "type": "animationframe",
          "name": "编号",
          "desc": "要设置的动画帧编号（从0开始），或标签。"
        }
      }
    },
    {
      "id": "set-animation-speed",
      "scriptName": "SetAnimSpeed",
      "category": "animations",
      "list-name": "设置播放速度",
      "display-text": "设置动画播放速度为[b]{0}[/b]",
      "description": "设置当前动画速度。",
      "params": {
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "新动画速度，每秒动画帧数。"
        }
      }
    },
    {
      "id": "set-repeat-to-frame",
      "scriptName": "SetAnimRepeatToFrame",
      "category": "animations",
      "list-name": "设置重复帧",
      "display-text": "设置重复起始帧为[b]{0}[/b]",
      "description": "设置要从哪一帧开始重复播放，仅在循环播放的动画表中生效。",
      "params": {
        "frame-number": {
          "type": "animationframe",
          "name": "编号",
          "desc": "要重复的动画帧编号（从0开始）。"
        }
      }
    },
    {
      "id": "add-remove-animation",
      "scriptName": "AddRemoveAnimation",
      "category": "animations",
      "list-name": "添加/删除动画",
      "display-text": "{0} 动画 [b]{1}[/b]",
      "description": "添加或删除对象的动画。",
      "params": {
        "which": {
          "type": "combo",
          "name": "方式",
          "desc": "添加新动画或删除现有动画。",
          "items": {
            "add": "添加",
            "remove": "移除"
          }
        },
        "name": {
          "type": "animation",
          "name": "名称",
          "desc": "添加或删除的动画名称。"
        }
      }
    },
    {
      "id": "add-remove-animation-frame",
      "scriptName": "AddRemoveAnimationFrame",
      "category": "animations",
      "list-name": "添加/删除动画帧",
      "display-text": "{0} 动画帧 [b]{1}[/b] 到 [i]{2}[/i]",
      "description": "在当前动画中添加或删除动画帧。",
      "params": {
        "which": {
          "type": "combo",
          "name": "方式",
          "desc": "添加或删除现有的动画帧。",
          "items": {
            "add": "添加",
            "remove": "移除"
          }
        },
        "animation": {
          "type": "animation",
          "name": "动画",
          "desc": "要修改的动画的名称。"
        },
        "where": {
          "type": "animationframe",
          "name": "位置",
          "desc": "要插入或删除动画帧的编号或标签。使用 -1 指定最后一帧。"
        }
      }
    },
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "设置混合模式",
      "display-text": "设置混合模式为[i]{0}[/i]",
      "description": "设置此对象的背景混合模式。",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "混合模式",
          "desc": "为此对象选择新的混合模式。",
          "items": {
            "normal": "正常",
            "additive": "叠加",
            "xor": "重叠消除",
            "copy": "覆盖",
            "destination-over": "背景穿透",
            "source-in": "前景剪贴",
            "destination-in": "背景剪贴",
            "source-out": "前景剔除",
            "destination-out": "背景剔除",
            "source-atop": "前景混合",
            "destination-atop": "背景混合",
            "lighten": "变亮",
            "darken": "变暗",
            "multiply": "正片叠底",
            "screen": "滤色"
          }
        }
      }
    },
    {
      "id": "set-mirrored",
      "scriptName": "SetMirrored",
      "category": "appearance",
      "list-name": "设置左右翻转",
      "display-text": "[b]{0}[/b]",
      "description": "将对象设置为左右翻转，或恢复正常。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "选择将对象左右翻转，或恢复正常。",
          "items": {
            "mirrored": "左右翻转",
            "not-mirrored": "关闭左右翻转"
          }
        }
      }
    },
    {
      "id": "set-flipped",
      "scriptName": "SetFlipped",
      "category": "appearance",
      "list-name": "设置上下翻转",
      "display-text": "[b]{0}[/b]",
      "description": "将对象垂直翻转，或恢复正常。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "选择将对象垂直翻转，或恢复正常。",
          "items": {
            "flipped": "上下翻转",
            "not-flipped": "关闭上下翻转"
          }
        }
      }
    },
    {
      "id": "spawn-another-object",
      "scriptName": "Spawn",
      "category": "misc",
      "list-name": "生成其他对象",
      "display-text": "生成对象 {0} 到图像点 [i]{2}[/i] (图层: [b]{1}[/b], 对象层级: [i]{3}[/i], 继承模板: [i]{4}[/i])",
      "description": "在此对象上创建另一个对象。新对象将继承此对象的角度。",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要创建的对象类型。"
        },
        "layer": {
          "type": "layer",
          "name": "图层",
          "desc": "新实例对象要创建到的图层名称或编号。"
        },
        "image-point": {
          "type": "any",
          "name": "图像点",
          "desc": "输入图像点的名称或编号，对象原点的图像点编号是 0"
        },
        "create-hierarchy": {
          "type": "boolean",
          "name": "创建子对象",
          "desc": "根据在场景中设置的对象层级关系，创建此对象所有的子对象。在当前事件范围，被创建的子对象也会一起被选择。"
        },
        "template-name": {
          "type": "template",
          "name": "模板名称",
          "desc": "在生成对象时，继承特定的模板对象。模板可在实例对象的属性栏中定义。"
        }
      }
    },
    {
      "id": "set-collisions-enabled",
      "scriptName": "SetCollisions",
      "category": "misc",
      "list-name": "启用碰撞",
      "display-text": "[b]{0}[/b]碰撞",
      "description": "对象是否能触发碰撞相关的事件。",
      "params": {
        "collisions": {
          "type": "combo",
          "name": "碰撞",
          "desc": "启用或禁用此对象的碰撞。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          }
        }
      }
    },
    {
      "id": "set-solid-collision-filter",
      "scriptName": "SetSolidCollisionFilter",
      "category": "misc",
      "list-name": "设置实体碰撞过滤",
      "display-text": "设置实体碰撞过滤 (模式: [i]{0}[/i], 实体标签: [b]{1}[/b])",
      "description": "启用或禁用与其他带有实体行为对象的碰撞。使用空格分隔多个标签。",
      "params": {
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "若使用 '包含' 模式，只能与带有相同标签的实体行为对象发生碰撞。使用 '排除' 模式则会忽略带有该标签的实体行为对象的碰撞。",
          "items": {
            "inclusive": "包含",
            "exclusive": "排除"
          }
        },
        "tags": {
          "type": "string",
          "name": "标签",
          "desc": "填写一个字符串，可以是任意内容，用于区分不同的实体。使用空格分隔多个标签。"
        }
      }
    },
    {
      "id": "set-scale",
      "scriptName": "SetScale",
      "category": "size-position",
      "list-name": "设置缩放比例",
      "display-text": "设置缩放比例为[i]{0}[/i]",
      "description": "将宽度和高度设置为其原始大小的倍数。",
      "params": {
        "scale": {
          "type": "number",
          "name": "大小",
          "desc": "设置对象整体尺寸的倍数，1：原始尺寸，2：扩大两倍，0.5：缩小一半"
        }
      }
    },
    {
      "id": "load-image-from-url",
      "scriptName": "LoadURL",
      "category": "web",
      "list-name": "加载远程图像",
      "display-text": "加载远程图像 [i]{0}[/i] ({1}, 跨域 {2})",
      "description": "将当前显示的动画帧替换为从远程地址加载的图像，也可通过 AJAX 对象请求项目文件夹的本地文件。",
      "params": {
        "uri": {
          "type": "string",
          "name": "URI",
          "desc": "要导入的远程图像地址或通过表达式返回的数据地址。"
        },
        "size": {
          "type": "combo",
          "name": "缩放",
          "desc": "使用新图像的尺寸大小，或保持当前精灵的尺寸。",
          "items": {
            "resize-to-image-size": "缩放至新图片尺寸",
            "keep-current-size": "保持当前尺寸"
          }
        },
        "cross-origin": {
          "type": "combo",
          "name": "跨域",
          "desc": "如何处理请求的跨域（CORS）模式。",
          "items": {
            "anonymous": "匿名",
            "none": "无"
          }
        }
      },
      "isAsync": true
    }
  ],
