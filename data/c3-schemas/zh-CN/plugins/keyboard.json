      "list-name": "按下按键码",
      "display-text": "按下 [b]{0}[/b] 按键码",
      "description": "按下按键码对应的按键时触发。",
      "params": {
        "keycode": {
          "type": "number",
          "name": "按键码",
          "desc": "输入要测试的按键码。"
        }
      },
      "isTrigger": true
    },
    {
