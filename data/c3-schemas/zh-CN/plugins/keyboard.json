  "actions": [
    {
      "id": "lock-keyboard",
      "scriptName": "LockKeyboard",
      "category": "keyboard-lock",
      "list-name": "锁定键盘",
      "display-text": "锁定键盘(按键: [i]{0}[/i]))",
      "description": "请求锁定键盘，允许游戏在全屏模式下访问特殊按键或组合键，而不被浏览器/应用程序捕获。注意：仅在全屏模式下生效。",
      "params": {
        "keys": {
          "type": "string",
          "name": "按键",
          "desc": "要锁定的按键名，以逗号区分多个按键名。留空默认所有按键。注：按键名使用 keyCode 标准。"
        }
      },
      "isAsync": true
    },
    {
      "id": "unlock-keyboard",
      "scriptName": "UnlockKeyboard",
      "category": "keyboard-lock",
      "list-name": "解锁键盘",
      "display-text": "解锁键盘",
      "description": "解锁的键盘锁，恢复按键的默认处理。"
    }
  ],
  "expressions": [
    {
      "id": "lastkeycode",
      "scriptName": "LastKeyCode",
      "category": "key-codes",
      "translated-name": "按键码",
