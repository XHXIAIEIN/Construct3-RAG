      "params": {
        "key": {
          "type": "keyb",
          "name": "按键",
          "desc": "选择一个键盘上的按键。注意：请避免使用一些不常用的按键。因为在不同的地区、不同操作系统、不同输入设备，用户使用的键盘可能并不相同，可能没有部分按键或按键的位置布局也不一致。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-key-pressed",
