  "actions": [
    {
      "id": "request-device",
      "scriptName": "RequestDevice",
      "category": "bluetooth",
      "list-name": "请求设备",
      "display-text": "请求设备(服务[i]{0}[/i]，设备名称[i]{1}[/i]，设备名称前缀[i]{2}[/i]，可选服务[i]{3}[/i]，接受所有设备[i]{4}[/i])",
      "description": "请求最近的蓝牙设备 必须在用户输入操作中被调用",
      "params": {
        "services": {
          "type": "string",
          "name": "服务",
          "desc": "可选蓝牙服务名称，十六进制ID或UUID的列表，以逗号分隔。"
        },
        "device-name": {
          "type": "string",
          "name": "设备名",
          "desc": "要过滤的设备名"
        },
        "device-name-prefix": {
          "type": "string",
          "name": "设备前缀",
          "desc": "要过滤的设备前缀"
        },
        "optional-services": {
          "type": "string",
          "name": "可选服务",
          "desc": "可选蓝牙服务名称，十六进制ID或UUID的列表，以逗号分隔。"
        },
        "accept-all-devices": {
          "type": "combo",
          "name": "允许所有设备",
          "desc": "显示所有设备（即时不符合上面条件）",
          "items": {
            "no": "否",
            "yes": "是"
          }
        }
      }
    },
    {
      "id": "disconnect-device",
      "scriptName": "DisconnectDevice",
      "category": "bluetooth",
      "list-name": "与设备断开连接",
      "display-text": "与设备[i]{0}[/i]断开连接",
      "description": "断开一个已经连接的设备",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "要断开连接的设备 留空为默认设备"
        }
      }
    },
    {
      "id": "request-primary-services",
      "scriptName": "RequestPrimaryServices",
      "category": "services",
      "list-name": "请求次要服务",
      "display-text": "为设备 [i]{0}[/i]请求次要服务",
      "description": "加载一个设备可用次要服务的列表 将触发当次要服务加载完成时",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "要请求次要服务的设备ID  留空危默认"
        }
      },
      "isAsync": true
    },
    {
      "id": "request-characteristics",
      "scriptName": "RequestCharacteristics",
      "category": "services",
      "list-name": "请求蓝牙特性",
      "display-text": "为设备 [i]{0}[/i] 请求蓝牙特性服务 [i]{1}[/i]",
      "description": "加载主要服务的可用特性列表。完成后触发 '特性加载完成' 条件。",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "设备ID 为空则为默认设备"
        },
        "service": {
          "type": "string",
          "name": "服务",
          "desc": "服务名称，UUID或十六进制ID，用于获取特征数据。"
        }
      },
      "isAsync": true
    },
    {
      "id": "read-characteristic-binary",
      "scriptName": "ReadCharacteristicBinary",
      "category": "characteristics",
      "list-name": "读取二进制文件",
      "display-text": "从设备[i]{0}[/i] 的服务 [i]{1}[/i] 蓝牙特性 [i]{2}[/i] 读取数据到 {3} 中",
      "description": "从蓝牙设备中读取二进制数据并存入二进制数据对象中",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "设备ID 为空则为默认设备"
        },
        "service": {
          "type": "string",
          "name": "服务",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "characteristic": {
          "type": "string",
          "name": "特征数据",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "binary-data": {
          "type": "object",
          "name": "终点",
          "desc": "要读取的二进制数据"
        }
      },
      "isAsync": true
    },
    {
      "id": "read-characteristic-value",
      "scriptName": "ReadCharacteristicValue",
      "category": "characteristics",
      "list-name": "读取值",
      "display-text": "从设备 [i]{0}[/i] 的服务 [i]{1}[/i] 特性 [i]{2}[/i] 中读取信息",
      "description": "从蓝牙特性中读取文字或数字",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "设备ID 为空则为默认设备"
        },
        "service": {
          "type": "string",
          "name": "服务",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "characteristic": {
          "type": "string",
          "name": "特征数据",
          "desc": "服务名、UUID或十六进制ID。"
        }
      },
      "isAsync": true
    },
    {
      "id": "write-characteristic-binary",
      "scriptName": "WriteCharacteristicBinary",
      "category": "characteristics",
      "list-name": "写二进制",
      "display-text": "向设备 [i]{0}[/i] 的服务 [i]{1}[/i] 特性 [i]{2}[/i] 写入数据  {3}",
      "description": "向蓝牙设备写入二进制数据",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "设备ID 为空则为默认设备"
        },
        "service": {
          "type": "string",
          "name": "服务",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "characteristic": {
          "type": "string",
          "name": "特征数据",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "binary-data": {
          "type": "object",
          "name": "数据",
          "desc": "要写入的二进制值"
        }
      },
      "isAsync": true
    },
    {
      "id": "start-stop-characteristic-notifications",
      "scriptName": "StartStopCharacteristicNotifications",
      "category": "characteristics",
      "list-name": "开始/停止推送",
      "display-text": "{3}设备[i]{0}[/i]服务[i]{1}[/i]特性[i]{2}[/i]",
      "description": "启动或停止此特性的通知",
      "params": {
        "device-id": {
          "type": "string",
          "name": "设备ID",
          "desc": "设备ID 为空则为默认设备"
        },
        "service": {
          "type": "string",
          "name": "服务",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "characteristic": {
          "type": "string",
          "name": "特征数据",
          "desc": "服务名、UUID或十六进制ID。"
        },
        "notifications": {
          "type": "combo",
          "name": "通知",
          "desc": "用来设置启动或停止此特性的通知",
          "items": {
            "start": "开始",
            "stop": "停下"
          }
        }
      }
    }
  ],
