{
  "id": "clipboard",
  "name": "剪贴板",
  "description": "访问系统剪贴板功能，进行复制和粘贴操作。",
  "type": "plugin",
  "aceCategories": {
    "clipboard": "剪贴板"
  },
  "conditions": [
    {
      "id": "on-copy-success",
      "scriptName": "OnCopySuccess",
      "category": "clipboard",
      "list-name": "复制成功",
      "display-text": "复制成功",
      "description": "复制到剪贴板成功时触发。",
      "isTrigger": true
    },
    {
      "id": "on-copy-error",
      "scriptName": "OnCopyError",
      "category": "clipboard",
      "list-name": "复制失败",
      "display-text": "复制失败",
      "description": "复制到剪贴板失败时触发。",
      "isTrigger": true
    },
    {
      "id": "on-paste-text",
      "scriptName": "OnPasteText",
      "category": "clipboard",
      "list-name": "粘贴文本",
      "display-text": "粘贴文本",
      "description": "成功粘贴文本时触发。",
      "isTrigger": true
    },
    {
      "id": "on-paste-binary",
      "scriptName": "OnPasteBinary",
      "category": "clipboard",
      "list-name": "粘贴二进制",
      "display-text": "粘贴二进制数据 (对象: {0}, 类型: [i]{1}[/i])",
      "description": "成功粘贴二进制数据时触发。",
      "params": {
        "receive-to": {
          "type": "object",
          "name": "二进制数据",
          "desc": "选择 '二进制数据' 对象，将粘贴的二进制数据写入到对象中。"
        },
        "type": {
          "type": "string",
          "name": "类型",
          "desc": "粘贴数据的类型（又称 MIME 类型）。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-paste-error",
      "scriptName": "OnPasteError",
      "category": "clipboard",
      "list-name": "粘贴失败",
      "display-text": "粘贴失败",
      "description": "粘贴失败时触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "copy-text",
      "scriptName": "CopyText",
      "category": "clipboard",
      "list-name": "复制文本",
      "display-text": "复制文本 [i]{0}[/i]",
      "description": "复制文本数据到剪贴板。注意：这可能会显示一个权限提示，需要用户授权通过才能继续执行。",
      "params": {
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "要复制到剪贴板的文本。"
        }
      },
      "isAsync": true
    },
    {
      "id": "copy-binary",
      "scriptName": "CopyBinary",
      "category": "clipboard",
      "list-name": "复制二进制数据",
      "display-text": "复制二进制数据 {0} (类型: [i]{1}[/i])",
      "description": "复制某些二进制数据到剪贴板。注意：这可能会显示一个权限提示，需要用户授权通过才能继续执行。",
      "params": {
        "data": {
          "type": "object",
          "name": "二进制数据",
          "desc": "要复制到剪贴板的二进制数据对象。"
        },
        "type": {
          "type": "string",
          "name": "类型",
          "desc": "被复制的数据类型（又称 MIME 类型）。"
        }
      },
      "isAsync": true
    },
    {
      "id": "request-paste-text",
      "scriptName": "RequestPasteText",
      "category": "clipboard",
      "list-name": "请求粘贴文本",
      "display-text": "请求粘贴文本",
      "description": "请求从剪贴板中读取文本数据。注意：这可能会显示一个权限提示，需要用户授权通过才能继续执行。",
      "isAsync": true
    },
    {
      "id": "request-paste-binary",
      "scriptName": "RequestPasteBinary",
      "category": "clipboard",
      "list-name": "请求粘贴二进制数据",
      "display-text": "请求粘贴二进制数据",
      "description": "请求从剪贴板中读取二进制数据。注意：这可能会显示一个权限提示，需要用户授权通过才能继续执行。",
      "isAsync": true
    }
  ],
  "expressions": [
    {
      "id": "pasted-text",
      "scriptName": "PastedText",
      "category": "clipboard",
      "translated-name": "剪贴文本",
      "description": "触发 '粘贴文本' 动作后，从剪贴板中读取到的文本。",
      "returnType": "string"
    }
  ],
  "properties": {}
}