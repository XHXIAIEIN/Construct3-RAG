{
  "id": "iframe",
  "name": "内嵌网页",
  "description": "在框架中显示另一个站点的网页内容。",
  "type": "plugin",
  "aceCategories": {
    "iframe": "内嵌网页"
  },
  "conditions": [],
  "actions": [
    {
      "id": "navigate-url",
      "scriptName": "NavigateURL",
      "category": "iframe",
      "list-name": "跳转到链接",
      "display-text": "跳转到 [b]{0}[/b]",
      "description": "在框架中加载新链接",
      "params": {
        "url": {
          "type": "string",
          "name": "URL",
          "desc": "要加载的链接"
        }
      }
    },
    {
      "id": "display-html-string",
      "scriptName": "DisplayHTMLString",
      "category": "iframe",
      "list-name": "显示HTML内容",
      "display-text": "显示HTML内容 [b]{0}[/b]",
      "description": "在框架中加载HTML 如有不受信任的内容请启用沙盒",
      "params": {
        "html": {
          "type": "string",
          "name": "HTML",
          "desc": "要加载的HTML内容字符串。如果有任何不可信任的内容，请启用沙盒模式。"
        }
      }
    }
  ],
  "expressions": [],
  "properties": {
    "url": {
      "name": "URL",
      "desc": "要加载到内嵌网页中的链接"
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "场景开始时，对象是否可见。"
    },
    "id": {
      "name": "ID",
      "desc": "可选的元素ID，允许使用 CSS 定位此元素，更改外观样式。"
    },
    "permissions": {
      "name": "权限",
      "desc": "控制显示页权限的设置。"
    },
    "allow": {
      "name": "特性",
      "desc": "可选的特性策略字符串，用于允许指定的显示页面执行某些操作。如：全屏播放视频。"
    },
    "enable-sandbox": {
      "name": "沙盒模式",
      "desc": "在显示页面时启用 '沙盒' 属性以增强安全性。"
    },
    "sandbox": {
      "name": "沙盒特性",
      "desc": "在 '沙盒' 模式下，对显示页面启用的额外限制条件字符串。"
    },
    "html": {
      "name": "HTML 内容",
      "desc": "要加载到内嵌网页的HTML内容，仅在 'URL' 属性为空时有效。"
    }
  },
  "commonAces": {
    "conditions": [
      "is-visible",
      "compare-instance-variable",
      "is-boolean-instance-variable-set",
      "pick-highestlowest",
      "pick-by-unique-id",
      "has-tags",
      "on-created",
      "on-destroyed",
      "on-instance-signal",
      "compare-x",
      "compare-y",
      "is-on-screen",
      "is-outside-layout",
      "pick-nearestfurthest",
      "compare-width",
      "compare-height",
      "is-on-layer",
      "pick-topbottom",
      "on-hierarchy-ready",
      "has-parent",
      "has-children",
      "pick-parent",
      "pick-children",
      "pick-nth-child",
      "compare-child-count"
    ],
    "actions": [
      "set-visible",
      "set-instvar-value",
      "add-to-instvar",
      "subtract-from-instvar",
      "set-boolean-instvar",
      "toggle-boolean-instvar",
      "destroy",
      "change-tags",
      "set-from-json",
      "instance-signal",
      "instance-wait-for-signal",
      "set-x",
      "set-y",
      "set-position",
      "set-position-to-another-object",
      "move-at-angle",
      "set-width",
      "set-height",
      "set-size",
      "move-to-top",
      "move-to-bottom",
      "move-to-layer",
      "move-to-object",
      "add-child",
      "remove-child",
      "remove-from-parent",
      "set-css-style",
      "set-elem-attribute",
      "remove-elem-attribute"
    ],
    "expressions": [
      "count",
      "pickedcount",
      "uid",
      "iid",
      "asjson",
      "objecttypename",
      "get-tags",
      "get-tags-count",
      "get-tag-at",
      "x",
      "y",
      "dt",
      "width",
      "height",
      "bboxleft",
      "bboxtop",
      "bboxback",
      "bboxright",
      "bboxbottom",
      "bboxfront",
      "bboxmidx",
      "bboxmidy",
      "bboxmidz",
      "layernumber",
      "layername",
      "zindex",
      "parent-uid",
      "child-count",
      "all-child-count",
      "template-name"
    ]
  }
}