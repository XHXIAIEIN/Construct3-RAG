        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查被触摸的对象。"
        }
      }
    },
    {
      "id": "compare-touch-speed",
      "scriptName": "CompareTouchSpeed",
      "category": "touch",
      "list-name": "比较滑动速度",
      "display-text": "触控点[b]{0}[/b]滑动速度 {1}[b]{2} [/b]",
      "description": "比较触控点的速度，用于检测特定的手势，如轻扫、滑动、捏合等。",
      "params": {
        "touch-index": {
          "type": "number",
          "name": "触控点",
          "desc": "要检测的触控点的索引，从0开始的计数。如第 1 根手指的索引为0，第 2 根手指的索引为1...以此类推。"
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "speed": {
          "type": "number",
          "name": "速度",
          "desc": "要比较的速度，以每秒绝对像素为单位。"
        }
      }
    },
