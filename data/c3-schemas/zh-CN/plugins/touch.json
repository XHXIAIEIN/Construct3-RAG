{
  "id": "touch",
  "name": "触控",
  "description": "接收触屏设备的输入，以及访问设备的陀螺仪功能，获取其方向和运动。",
  "type": "plugin",
  "aceCategories": {
    "gestures": "手势",
    "orientation-motion": "方向和运动",
    "touch": "触控"
  },
  "conditions": [
    {
      "id": "on-hold",
      "scriptName": "OnHoldGesture",
      "category": "gestures",
      "list-name": "长按屏幕",
      "display-text": "长按屏幕",
      "description": "按住屏幕任意位置并保持一段时间时触发。",
      "isTrigger": true
    },
    {
      "id": "on-tap",
      "scriptName": "OnTapGesture",
      "category": "gestures",
      "list-name": "点击屏幕",
      "display-text": "点击屏幕",
      "description": "在屏幕任意位置进行点击手势时触发。（点击手势：在相同位置快速触摸并松开。）",
      "isTrigger": true
    },
    {
      "id": "on-double-tap",
      "scriptName": "OnDoubleTapGesture",
      "category": "gestures",
      "list-name": "双击屏幕",
      "display-text": "双击屏幕",
      "description": "在屏幕任意位置，快速进行两次点击手势时触发。",
      "isTrigger": true
    },
    {
      "id": "on-hold-over-object",
      "scriptName": "OnHoldGestureObject",
      "category": "gestures",
      "list-name": "长按对象",
      "display-text": "长按 {0}",
      "description": "按住对象，并保持一段时间时触发。",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查的对象。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-tap-object",
      "scriptName": "OnTapGestureObject",
      "category": "gestures",
      "list-name": "点击对象",
      "display-text": "点击 {0}",
      "description": "在对象上进行点击手势时触发。（点击手势：在相同位置快速触摸并松开。）",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查的对象。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-double-tap-object",
      "scriptName": "OnDoubleTapGestureObject",
      "category": "gestures",
      "list-name": "双击对象",
      "display-text": "双击 {0}",
      "description": "在对象上快速进行两次点击手势时触发。",
      "params": {
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "选择要检查的对象。"
        }
      },
      "isTrigger": true
    },
    {
      "id": "compare-orientation",
      "scriptName": "CompareOrientation",
      "category": "orientation-motion",
      "list-name": "比较设备方向",
      "display-text": "[b]{0}[/b] 方向 {1} [b]{2}[/b]",
      "description": "比较设备的当前方向，或倾斜角度。",
      "params": {
        "orientation": {
          "type": "combo",
          "name": "方向",
          "desc": "要比较的方向。alpha: 水平方向, beta: 前后倾斜, gamma: 左右倾斜。",
          "items": {
            "alpha": "Alpha",
            "beta": "Beta",
            "gamma": "Gamma"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "angle": {
          "type": "number",
          "name": "角度",
          "desc": "要比较的角度方向，以度为单位。"
        }
      }
    },
    {
      "id": "compare-acceleration",
      "scriptName": "CompareAcceleration",
      "category": "orientation-motion",
      "list-name": "比较设备加速度",
      "display-text": "{0} 加速度 {1} [b]{2}[/b]",
      "description": "比较设备沿轴的加速度。",
      "params": {
        "axis": {
          "type": "combo",
          "name": "轴",
          "desc": "选择要比较加速度的轴，以及测量是否应包括重力。",
          "items": {
            "x-with-gravity": "X (包含重力)",
            "y-with-gravity": "Y (包含重力)",
            "z-with-gravity": "Z (包含重力)",
            "x-without-gravity": "X (不计算重力)",
            "y-without-gravity": "Y (不计算重力)",
            "z-without-gravity": "Z (不计算重力)"
          }
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "acceleration": {
          "type": "number",
          "name": "加速度",
          "desc": "要比较的加速度，单位为m/s^2。"
        }
      }
    },
    {
      "id": "on-permission-granted",
      "scriptName": "OnPermissionGranted",
      "category": "orientation-motion",
      "list-name": "权限被允许",
      "display-text": "[i]{0}[/i]权限被允许",
      "description": "执行 '请求权限' 动作后，权限被允许时触发。",
      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "请求的权限类型。",
          "items": {
            "orientation": "方向",
            "motion": "运动"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-permission-denied",
      "scriptName": "OnPermissionDenied",
      "category": "orientation-motion",
      "list-name": "权限被拒绝",
      "display-text": "请求[i]{0}[/i]权限被拒绝",
      "description": "执行 '请求权限' 动作后，权限请求被拒绝时触发。",
      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "请求的权限类型。",
          "items": {
            "orientation": "方向",
            "motion": "运动"
          }
        }
      },
      "isTrigger": true
    },
    {
      "id": "on-any-touch-start",
