  "properties": {
    "in-memory-only": {
      "name": "仅储存在内存",
      "desc": "启用后，数据仅储在当前页面加载的内存中，页面关闭后被清除。可以通过 '临时内存数据' 表达式手动储存到本地，并通过 '加载临时内存数据' 来还原。"
    }
  }
