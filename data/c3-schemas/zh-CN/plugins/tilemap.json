  "conditions": [
    {
      "id": "compare-tile-at",
      "scriptName": "CompareTileAt",
      "category": "tilemap",
      "list-name": "比较图块ID",
      "display-text": "图块 ({0}, {1}) {2} {3}",
      "description": "比较某个位置的图块编号。",
      "params": {
        "tile-x": {
          "type": "number",
          "name": "图块X",
          "desc": "要比较的图块位于瓦片图 X 轴的序列。使用 PositionToTileX() 表达式可转换场景坐标到图块序列。"
        },
        "tile-y": {
          "type": "number",
          "name": "图块Y",
          "desc": "要比较的图块位于瓦片图 Y 轴的序列。使用 PositionToTileY() 表达式可转换场景坐标到图块序列。"
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "tile": {
          "type": "number",
          "name": "图块编号",
          "desc": "要比较的图块编号。"
        }
      }
    },
    {
