{
  "id": "drawingcanvas",
  "name": "画布",
  "description": "可以进行自由绘画的特殊画布。",
  "type": "plugin",
  "aceCategories": {
    "appearance": "显示",
    "canvas": "画布",
    "drawing-general": "绘图：常规",
    "drawing-polygons": "绘图：多边形"
  },
  "conditions": [
    {
      "id": "on-saved-image",
      "scriptName": "OnSavedImage",
      "category": "canvas",
      "list-name": "图像保存完成",
      "display-text": "图像保存完成",
      "description": "执行 '保存图像' 动作后，图像保存完成时触发。",
      "isTrigger": true
    },
    {
      "id": "on-snapshot",
      "scriptName": "OnSnapshot",
      "category": "canvas",
      "list-name": "快照完成",
      "display-text": "截屏完成",
      "description": "在 '保存快照' 动作执行后，返回的 '保存快照地址' 表达式数据可用时触发。",
      "isTrigger": true
    },
    {
      "id": "on-resolution-changed",
      "scriptName": "OnResolutionChanged",
      "category": "canvas",
      "list-name": "分辨率发生更改",
      "display-text": "分辨率发生更改",
      "description": "当画布的分辨率被更改时触发。 重新绘制内容以在新的分辨率下显示。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "设置混合模式",
      "display-text": "设置混合模式为[i]{0}[/i]",
      "description": "设置此对象的背景混合模式。",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "混合模式",
          "desc": "为此对象选择新的混合模式。",
          "items": {
            "normal": "正常",
            "additive": "叠加",
            "xor": "重叠消除",
            "copy": "覆盖",
            "destination-over": "背景穿透",
            "source-in": "前景剪贴",
            "destination-in": "背景剪贴",
            "source-out": "前景剔除",
            "destination-out": "背景剔除",
            "source-atop": "前景混合",
            "destination-atop": "背景混合",
            "lighten": "变亮",
            "darken": "变暗",
            "multiply": "正片叠底",
            "screen": "滤色"
          }
        }
      }
    },
    {
      "id": "save-image",
      "scriptName": "SaveImage",
      "category": "canvas",
      "list-name": "保存图像",
      "display-text": "保存图像 ({0}, 品质: [i]{1}[/i] 偏移: [i]{2}[/i], [i]{3}[/i] 大小: [i]{4}[/i] x [i]{5}[/i])",
      "description": "保存当前画布的图像。完成后触发 '图像保存完成' 条件，并使用 '图像保存地址' 表达式获取图像的地址。",
      "params": {
        "format": {
          "type": "combo",
          "name": "图像格式",
          "desc": "选择要保存图像的文件格式。PNG是无损的，但JPEG文件更小。",
          "items": {
            "png": "PNG",
            "jpeg": "JPEG"
          }
        },
        "jpeg-quality": {
          "type": "number",
          "name": "JPEG品质",
          "desc": "仅适用于 'JPEG' 图像格式，控制输出品质从 0 (最差) 到 100 (最好)，但品质越小图像则越模糊，设为 100 则无损输出。"
        },
        "x": {
          "type": "number",
          "name": "X",
          "desc": "截取快照区域的X偏移量，基于设备画布像素。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "截取快照区域的Y偏移量，基于设备画布像素。"
        },
        "width": {
          "type": "number",
          "name": "宽度",
          "desc": "截屏区域的宽度，以画布设备像素为单位，使用 0 则使用完整宽度。"
        },
        "height": {
          "type": "number",
          "name": "高度",
          "desc": "截屏区域的高度，以画布设备像素为单位，使用 0 则使用完整高度。"
        }
      },
      "isAsync": true
    },
    {
      "id": "save-snapshot",
      "scriptName": "SaveSnapshot",
      "category": "canvas",
      "list-name": "保存快照",
      "display-text": "保存快照",
      "description": "保存当前画布的图像副本，用于读取画布的像素颜色。",
      "isAsync": true
    },
    {
      "id": "clear-snapshot",
      "scriptName": "ClearSnapshot",
      "category": "canvas",
      "list-name": "清理快照",
      "display-text": "清理快照",
      "description": "释放内存中已保存的画布快照。"
    },
    {
      "id": "snapshot-set-pixel",
      "scriptName": "SnapshotSetPixel",
      "category": "canvas",
      "list-name": "设置快照像素颜色",
      "display-text": "设置像素颜色 (位置: [i]{0}[/i], [i]{1}[/i], 颜色: [i]{2}[/i])",
      "description": "设置快照的图像某个像素点的颜色。",
      "params": {
        "x": {
          "type": "number",
          "name": "X",
          "desc": "要读取的像素位于快照中的X坐标，以像素为单位。"
        },
        "y": {
          "type": "number",
          "name": "Y",
          "desc": "要读取的像素位于快照中的Y坐标，以像素为单位。"
        },
        "color": {
          "type": "number",
          "name": "颜色",
          "desc": "要设置的像素颜色。"
        }
      }
    },
    {
      "id": "load-snapshot",
      "scriptName": "LoadSnapshot",
      "category": "canvas",
      "list-name": "加载快照",
      "display-text": "加载快照",
      "description": "将快照重新加载到画布，覆盖当前的图像。"
    },
    {
      "id": "set-resolution-mode",
      "scriptName": "SetResolutionMode",
      "category": "canvas",
      "list-name": "设置缩放模式",
      "display-text": "设置缩放模式为[b]{0}[/b] ([i]{1}[/i] x [i]{2}[/i])",
      "description": "更改画布的缩放模式。是自适应场景的缩放比例，还是使用固定缩放比例。用于改善文本缩放时产生的模糊感。",
      "params": {
        "mode": {
          "type": "combo",
          "name": "模式",
          "desc": "画布的自动匹配成项目的分辨率，还是始终使用固定的分辨率。",
          "items": {
            "auto": "自动",
            "fixed": "固定"
          }
        },
        "fixed-width": {
          "type": "number",
          "name": "固定宽度",
          "desc": "固定分辨率时，使用的水平分辨率，以像素为单位。"
        },
        "fixed-height": {
          "type": "number",
          "name": "固定高度",
          "desc": "固定分辨率时，使用的垂直分辨率，以像素为单位。"
        }
      }
    },
    {
