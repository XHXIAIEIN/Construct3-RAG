{
  "id": "dictionary",
  "name": "字典",
  "description": "将数据存储在对应的字段里。相比本地变量，字典的数据存储方式更自由。",
  "type": "plugin",
  "aceCategories": {
    "dictionary": "字典",
    "for-each": "遍历",
    "json": "JSON"
  },
  "conditions": [
    {
      "id": "compare-value",
      "scriptName": "CompareValue",
      "category": "dictionary",
      "list-name": "比较值",
      "display-text": "字段[b]{0}[/b]的值 {1} [b]{2}[/b]",
      "description": "比较一个字段对应的值。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "要检测的字段名称。"
        },
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "value": {
          "type": "any",
          "name": "值",
          "desc": "要比较的值。"
        }
      }
    },
    {
      "id": "has-key",
      "scriptName": "HasKey",
      "category": "dictionary",
      "list-name": "字段已存在",
      "display-text": "字段 [b]{0}[/b] 已存在",
      "description": "检测指定的字段是否已储存。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "检测指定的字段名称是否存在。"
        }
      }
    },
    {
      "id": "is-empty",
      "scriptName": "IsEmpty",
      "category": "dictionary",
      "list-name": "如果为空",
      "display-text": "如果为空",
      "description": "检测字典是否为空，没有储存任何字段。"
    },
    {
      "id": "for-each-key",
      "scriptName": "ForEachKey",
      "category": "for-each",
      "list-name": "遍历字段",
      "display-text": "遍历字段",
      "description": "对当前字典中的所有字段执行一遍动作。"
    },
    {
      "id": "compare-current-value",
      "scriptName": "CompareCurrentValue",
      "category": "for-each",
      "list-name": "比较当前值",
      "display-text": "当前值 {0} [b]{1}[/b]",
      "description": "在循环中遍历当前字段的值。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "value": {
          "type": "any",
          "name": "值",
          "desc": "要比较的值。"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "add-key",
      "scriptName": "AddKey",
      "category": "dictionary",
      "list-name": "添加字段",
      "display-text": "添加字段[i]{0}[/i]: [i]{1}[/i]",
      "description": "添加新的字段到字典中，如果字段已存在，则覆盖旧的字段值。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "字段的名称。 如果字段已存在，会覆盖旧的字段值。"
        },
        "value": {
          "type": "any",
          "name": "值",
          "desc": "存储到字段的值。"
        }
      }
    },
    {
      "id": "set-key",
      "scriptName": "SetKey",
      "category": "dictionary",
      "list-name": "设置字段",
      "display-text": "设置字段[i]{0}[/i]: [i]{1}[/i]",
      "description": "设置字段的值。如果字段不存在，此操作无效。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "字段的名称。 如果字段不存在，此操作无效。"
        },
        "value": {
          "type": "any",
          "name": "值",
          "desc": "存储到字段的值。"
        }
      }
    },
    {
      "id": "delete-key",
      "scriptName": "DeleteKey",
      "category": "dictionary",
      "list-name": "删除字段",
      "display-text": "删除字段[i]{0}[/i]",
      "description": "从本地存储中删除字段。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "要删除的字段名称。"
        }
      }
    },
    {
      "id": "clear",
      "scriptName": "Clear",
      "category": "dictionary",
      "list-name": "清空字典",
      "display-text": "清空字典",
      "description": "从本地存储中删除所有字段和值，返回空白对象。"
    },
    {
      "id": "load",
      "scriptName": "JSONLoad",
      "category": "json",
      "list-name": "导入数据",
      "display-text": "导入对象数据[i]{0}[/i]",
      "description": "字典文件的JSON格式。如果想希望导入项目的字典文件，通过 AJAX 对象请求项目文件，请求完成后通过 'AJAX.请求数据' 表达式获得数组文件的数据导入。",
      "params": {
        "json": {
          "type": "string",
          "name": "JSON",
          "desc": "字典文件的JSON格式。如果想希望导入项目的字典文件，通过 AJAX 对象请求项目文件，请求完成后通过 'AJAX.请求数据' 表达式获得数组文件的数据导入。"
        }
      }
    },
    {
      "id": "download",
      "scriptName": "JSONDownload",
      "category": "json",
      "list-name": "下载",
      "display-text": "下载 JSON数据文件 [i]{0}[/i]",
      "description": "将字典的内容下载为JSON文件。",
      "params": {
        "filename": {
          "type": "string",
          "name": "文件名",
          "desc": "要下载的文件的名称。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "get",
      "scriptName": "Get",
      "category": "dictionary",
      "translated-name": "读取",
      "description": "获取指定字段的值。 如果字段不存在，则返回0。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "要获取的字段名称。"
        }
      },
      "returnType": "any"
    },
    {
      "id": "get-default",
      "scriptName": "GetDefault",
      "category": "dictionary",
      "translated-name": "安全读取",
      "description": "获取指定字段的值，或者字段不存在时返回的自定义字符。",
      "params": {
        "key": {
          "type": "string",
          "name": "字段",
          "desc": "要获取的字段名称。"
        },
        "default": {
          "type": "any",
          "name": "默认值",
          "desc": "若字段不存在时，默认返回的值。"
        }
      },
      "returnType": "any"
    },
    {
      "id": "keycount",
      "scriptName": "KeyCount",
      "category": "dictionary",
      "translated-name": "字段数量",
      "description": "获取本地存储中已存在的字段总数。",
      "returnType": "number"
    },
    {
      "id": "currentkey",
      "scriptName": "CurrentKey",
      "category": "for-each",
      "translated-name": "当前字段",
      "description": "在循环中获取当前字段的名称。",
      "returnType": "string"
    },
    {
      "id": "currentvalue",
      "scriptName": "CurrentValue",
      "category": "for-each",
      "translated-name": "当前值",
      "description": "在循环中获取当前字段的值。",
      "returnType": "any"
    },
    {
      "id": "asjson",
      "scriptName": "AsJSON",
      "category": "json",
      "translated-name": "导出对象数据",
      "description": "将字典导出为JSON格式的字符串。后续在 '导入数据' 动作中使用，常用于保存在本地存储中。",
      "returnType": "string"
    }
  ],
  "properties": {}
}