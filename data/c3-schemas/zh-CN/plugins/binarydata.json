        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "要插入的值"
        },
        "offset": {
          "type": "number",
          "name": "偏移",
          "desc": "起始位的偏移量，以字节为单位。"
        },
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要填充的区域长度，以字节为单位。使用 -1 表示尾部。"
        }
      }
    },
    {
      "id": "copy",
      "scriptName": "Copy",
      "category": "binarydata",
      "list-name": "复制",
      "display-text": "复制 {0} 到 [i]{3}[/i] (范围: [i]{1}[/i], [i]{2}[/i])",
      "description": "将一段数据从二进制数据对象复制到这个缓冲区的特定位置。",
      "params": {
        "source": {
          "type": "object",
          "name": "来源",
          "desc": "二进制对象，用于复制里面的缓冲区数据。"
        },
        "start": {
          "type": "number",
          "name": "起始位置",
          "desc": "范围的起始值(包含)，以字节为单位。"
        },
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "字节范围长度。使用 -1 表示尾部。"
        },
        "target": {
          "type": "number",
          "name": "目标",
          "desc": "插入范围的位置，以字节为单位。"
        }
      }
    },
    {
      "id": "set-value",
      "scriptName": "SetValue",
      "category": "binarydata",
      "list-name": "写入值",
      "display-text": "写入 [i]{1}[/i] 到缓冲区 (类型:  {0}, 偏移: [i]{2}[/i])",
