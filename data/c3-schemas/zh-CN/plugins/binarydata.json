      "description": "用指定值填充范围。",
      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "要插入的数值类型。",
          "items": {
            "uint8": "Uint8",
            "int8": "Int8",
            "uint16": "Uint16",
            "int16": "Int16",
            "uint32": "Uint32",
            "int32": "Int32",
            "float32": "Float32",
            "float64": "Float64"
