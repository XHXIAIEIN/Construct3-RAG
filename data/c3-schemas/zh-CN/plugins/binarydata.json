{
  "id": "binarydata",
  "name": "二进制",
  "description": "用于读写二进制数据。",
  "type": "plugin",
  "aceCategories": {
    "binarydata": "二进制",
    "compression": "二进制: 解码"
  },
  "conditions": [
    {
      "id": "compare-length",
      "scriptName": "CompareLength",
      "category": "binarydata",
      "list-name": "比较长度",
      "display-text": "长度 {0} [b]{1}[/b]字节",
      "description": "比较缓冲区的长度，以字节为单位。",
      "params": {
        "cmp": {
          "type": "cmp",
          "name": "比较",
          "desc": "用哪种方式比较长度。"
        },
        "length": {
          "type": "number",
          "name": "长度",
          "desc": "要进行比较的长度，以字节为单位。"
        }
      }
    },
    {
      "id": "compare-value",
      "scriptName": "CompareValue",
      "category": "binarydata",
      "list-name": "比较值",
      "display-text": "{0} 于 [b]{1}[/b] {2} [b]{3}[/b]",
      "description": "比较缓冲区中偏移量处的值。",
      "params": {
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "要读取的数值类型。",
          "items": {
            "uint8": "Uint8",
            "int8": "Int8",
            "uint16": "Uint16",
            "int16": "Int16",
            "uint32": "Uint32",
            "int32": "Int32",
            "float32": "Float32",
            "float64": "Float64"
          }
        },
        "offset": {
          "type": "number",
          "name": "偏移",
          "desc": "数值的偏移量，以字节为单位。"
        },
        "cmp": {
          "type": "cmp",
          "name": "比较",
          "desc": "用哪种方式比较。"
        },
        "value": {
          "type": "number",
          "name": "值",
          "desc": "要比较的值。"
        }
      }
    },
    {
      "id": "on-compression-finished",
      "scriptName": "OnCompressionFinished",
      "category": "compression",
      "list-name": "压缩完成",
      "display-text": "压缩完成",
      "description": "压缩完成的时候触发。",
