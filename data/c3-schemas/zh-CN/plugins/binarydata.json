        "string": {
          "type": "string",
          "name": "字符串",
          "desc": "要设置的字符串。"
        },
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "将字符串设置为文本(UTF-8)、二进制(Base64)、十六进制。",
          "items": {
            "text": "字符串",
            "base64": "二进制",
            "hex": "十六进制"
          }
        }
      }
    },
    {
      "id": "set-from-binary-data",
      "scriptName": "SetFromBinaryData",
      "category": "binarydata",
      "list-name": "写入二进制",
      "display-text": "写入 {0} 到缓冲区",
