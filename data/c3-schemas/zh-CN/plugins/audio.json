    {
      "id": "add-filter-effect",
      "scriptName": "AddFilterEffect",
      "category": "effects",
      "list-name": "添加滤波器",
      "display-text": "添加{1}滤波器效果 (音频标签: {0}, 频率: [i]{2}[/i], 失谐: [i]{3}[/i], Q: [i]{4}[/i], 增益: [i]{5}[/i], 混合: [i]{6}[/i])",
      "description": "添加 Biquad Filter 滤波器效果。实现各种频率变化声音。",
      "params": {
        "tag": {
          "type": "string",
          "name": "标签",
          "desc": "要处理的音频标签。"
        },
        "type": {
          "type": "combo",
          "name": "类型",
          "desc": "要添加的滤波器类型。",
          "items": {
            "low-pass": "低通",
            "high-pass": "高通",
            "band-pass": "带通",
            "low-shelf": "低频",
            "high-shelf": "高频",
            "peaking": "峰值",
            "notch": "陷波",
            "all-pass": "全通"
          }
        },
        "frequency": {
          "type": "number",
          "name": "频率",
          "desc": "滤波器的频率，以赫兹为单位。"
        },
        "detune": {
          "type": "number",
          "name": "失谐",
          "desc": "滤波器的失谐量，以音分为单位。用于调节跑调的效果，或模拟年久失修而走音的乐器。"
        },
        "q": {
          "type": "number",
          "name": "Q",
          "desc": "滤波器的品质因子, 默认为 1，范围从 0.0001 到 1000。Q值越高，损耗越大，用于模拟随振荡衰减的频率。"
        },
        "gain": {
          "type": "number",
          "name": "增益",
          "desc": "滤波器的增益，以分贝为单位。如果滤波器使用增益。"
        },
        "mix": {
          "type": "number",
          "name": "混合",
          "desc": "调节湿/干的混合程度，范围从 0 (无效果) 到 100 (完全效果)。"
        }
      }
    },
