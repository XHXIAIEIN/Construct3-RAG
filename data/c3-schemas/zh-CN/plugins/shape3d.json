{
  "id": "shape3d",
  "name": "3D形状",
  "description": "简单的 3D 形状支持，如创建一个立方体，每个面都可以自定义图像。",
  "type": "plugin",
  "aceCategories": {
    "3d-shape": "3D形状"
  },
  "conditions": [
    {
      "id": "compare-shape",
      "scriptName": "CompareShape",
      "category": "3d-shape",
      "list-name": "比较形状",
      "display-text": "形状为[i]{0}[/i]",
      "description": "测试当前设置的形状。",
      "params": {
        "shape": {
          "type": "combo",
          "name": "形状",
          "desc": "要检查的形状。",
          "items": {
            "box": "方盒",
            "prism": "棱镜",
            "wedge": "斜坡",
            "pyramid": "金字塔",
            "corner-in": "尖角(内)",
            "corner": "尖角(外)"
          }
        }
      }
    },
    {
      "id": "compare-z-height",
      "scriptName": "CompareZHeight",
      "category": "3d-shape",
      "list-name": "比较形状高度",
      "display-text": "形状高度 {0} {1}",
      "description": "比较形状在Z轴方向的高度。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "z-height": {
          "type": "number",
          "name": "形状高度",
          "desc": "比较形状在Z轴方向的高度。"
        }
      }
    },
    {
      "id": "is-face-visible",
      "scriptName": "IsFaceVisible",
      "category": "3d-shape",
      "list-name": "朝面可见",
      "display-text": "[i]{0}[/i] 朝面可见",
      "description": "检测对象某个朝面是否可见。",
      "params": {
        "face": {
          "type": "combo",
          "name": "朝面",
          "desc": "要检查的朝面。",
          "items": {
            "back": "背面",
            "front": "顶面",
            "left": "左面",
            "right": "右面",
            "top": "顶面",
            "bottom": "底面"
          }
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-shape",
      "scriptName": "SetShape",
      "category": "3d-shape",
      "list-name": "设置形状",
      "display-text": "设置形状为[b]{0}[/b]",
      "description": "更改为不同的 3D 形状类型。",
      "params": {
        "shape": {
          "type": "combo",
          "name": "形状",
          "desc": "要设置的形状。",
          "items": {
            "box": "方盒",
            "prism": "棱镜",
            "wedge": "斜坡",
            "pyramid": "金字塔",
            "corner-in": "尖角(内)",
            "corner": "尖角(外)"
          }
        }
      }
    },
    {
      "id": "set-z-height",
      "scriptName": "SetZHeight",
      "category": "3d-shape",
      "list-name": "设置形状高度",
      "display-text": "设置形状高度为[b]{0}[/b]",
      "description": "设置形状在Z轴方向的高度。",
      "params": {
        "z-height": {
          "type": "number",
          "name": "形状高度",
          "desc": "要设置的形状的Z轴高度。"
        }
      }
    },
    {
      "id": "set-face-visible",
      "scriptName": "SetFaceVisible",
      "category": "3d-shape",
      "list-name": "设置朝面可见",
      "display-text": "[b]{1}[/b][i]{0}[/i]可见",
      "description": "设置形状的某个朝面是否可见。",
      "params": {
        "face": {
          "type": "combo",
          "name": "朝面",
          "desc": "要检查的朝面。",
          "items": {
            "back": "背面",
            "front": "顶面",
            "left": "左面",
            "right": "右面",
            "top": "顶面",
            "bottom": "底面"
          }
        },
        "visible": {
          "type": "boolean",
          "name": "可见",
          "desc": "显示或隐藏形状的朝面。"
        }
      }
    },
    {
      "id": "set-back-face-culling",
      "scriptName": "SetBackFaceCulling",
      "category": "3d-shape",
      "list-name": "启用背面剔除",
      "display-text": "设置背面剔除(启用: [b]{0}[/b])",
      "description": "设置是否自动隐藏背对镜头的面部。",
      "params": {
        "back-face-culling": {
          "type": "boolean",
          "name": "背面剔除",
          "desc": "是否启用背面剔除。"
        }
      }
    },
    {
      "id": "set-face-image",
      "scriptName": "SetFaceImage",
      "category": "3d-shape",
      "list-name": "设置朝面图像",
      "display-text": "设置朝面图像 (朝面: [i]{0}[/i], 图像:[i]{1}[/i])",
      "description": "设置形状朝面使用的对象图像。",
      "params": {
        "face": {
          "type": "combo",
          "name": "朝面",
          "desc": "要更改图像的朝面。",
          "items": {
            "back": "背面",
            "front": "顶面",
            "left": "左面",
            "right": "右面",
            "top": "顶面",
            "bottom": "底面"
          }
        },
        "image": {
          "type": "combo",
          "name": "图像",
          "desc": "用于朝面的图像。",
          "items": {
            "back": "背面",
            "front": "顶面",
            "left": "左面",
            "right": "右面",
            "top": "顶面",
            "bottom": "底面"
          }
        }
      }
    },
    {
      "id": "set-z-tiling-factor",
      "scriptName": "SetZTilingFactor",
      "category": "3d-shape",
      "list-name": "设置平铺系数",
      "display-text": "设置平铺系数为[b]{0}[/b]",
      "description": "设置应用于Z轴上的纹理平铺系数。数值越大，图像重复越密集。",
      "params": {
        "z-tiling-factor": {
          "type": "number",
          "name": "平铺系数",
          "desc": "要设置的平铺系数。"
        }
      }
    },
    {
      "id": "set-face-object",
      "scriptName": "SetFaceObject",
      "category": "3d-shape",
      "list-name": "设置朝面对象",
      "display-text": "设置朝面图像 (朝面: [i]{0}[/i], 对象:{1})",
      "description": "选择一个对象，使用其图像作为3D形状朝向面的图像。注意，对象的实例必须放置在相同的场景中。后续想要操作此对象时，需先选择该3D形状对象。",
      "params": {
        "face": {
          "type": "combo",
          "name": "朝面",
          "desc": "要更改哪个朝面的图像。",
          "items": {
            "back": "背面",
            "front": "顶面",
            "left": "左面",
            "right": "右面",
            "top": "顶面",
            "bottom": "底面"
          }
        },
        "object": {
          "type": "object",
          "name": "对象",
          "desc": "用于朝向显示的对象。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "z-height",
      "scriptName": "ZHeight",
      "category": "3d-shape",
      "translated-name": "形状高度",
      "description": "形状在 Z 轴上的高度。视角从 100 的高度向下看。",
