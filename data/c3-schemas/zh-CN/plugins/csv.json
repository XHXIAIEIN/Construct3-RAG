{
  "id": "csv",
  "name": "CSV",
  "description": "逗号分隔值的文件格式，以纯文本形式存储表格数据。",
  "type": "plugin",
  "aceCategories": {
    "csv": "CSV"
  },
  "conditions": [
    {
      "id": "on-parse-error",
      "scriptName": "OnParseError",
      "category": "csv",
      "list-name": "解析失败",
      "display-text": "解析失败",
      "description": "存在无效数据，无法进行解析时触发。",
      "isTrigger": true
    },
    {
      "id": "on-parse-success",
      "scriptName": "OnParseSuccess",
      "category": "csv",
      "list-name": "解析成功",
      "display-text": "解析成功",
      "description": "成功解析 JSON 字符串时触发。",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "parse-csv",
      "scriptName": "ParseCSV",
      "category": "csv",
      "list-name": "解析CSV",
      "display-text": "解析CSV(内容: [i]{0}[/i], 数据类型: [i]{3}[/i], 分隔符 [i]{1}[/i], 储存到: {2}）",
      "description": "从CSV文件中解析数据并将结果存储在数组对象中。",
      "params": {
        "csv": {
          "type": "string",
          "name": "CSV",
          "desc": "要解析的一串由逗号分隔的字符串。"
        },
        "delimiter": {
          "type": "string",
          "name": "分隔符",
          "desc": "填入 CSV 的分隔符，可能是逗号、空格、或制表符。制表符可通过表达式引用。"
        },
        "array": {
          "type": "object",
          "name": "数组",
          "desc": "选择一个数组对象来存储转换的数据。"
        },
        "data-type": {
          "type": "combo",
          "name": "数据类型",
          "desc": "选择转换结果的数据类型。",
          "items": {
            "auto": "自动",
            "string": "字符串",
            "number": "数字"
          }
        }
      }
    },
    {
      "id": "generate-csv",
      "scriptName": "GenerateCSV",
      "category": "csv",
      "list-name": "生成CSV",
      "display-text": "生成CSV(来源: [i]{0}[/i], 分隔符为[i]{1}[/i])",
      "description": "将数组对象中的数据转换为CSV数据，并返回CSV数据的表达式。",
      "params": {
        "array": {
          "type": "object",
          "name": "数组",
          "desc": "选择一个数组对象。"
        },
        "delimiter": {
          "type": "string",
          "name": "分隔符",
          "desc": "填入 CSV 的分隔符，可能是逗号、空格、或制表符。制表符可通过表达式引用。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "generated-csv",
      "scriptName": "GeneratedCSV",
      "category": "csv",
      "translated-name": "生成CSV",
      "description": "执行 '生成CSV' 动作后，获取生成的CSV数据字符串。",
      "returnType": "string"
    },
    {
      "id": "tab-character",
      "scriptName": "TabCharacter",
      "category": "csv",
      "translated-name": "制表符",
      "description": "一个制表符，可以作为分隔符，有时非常有用。",
      "returnType": "string"
    }
  ],
  "properties": {}
}