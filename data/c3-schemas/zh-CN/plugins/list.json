{
  "id": "list",
  "name": "列表",
  "description": "用于从中选择选项的列表框或下拉列表。",
  "type": "plugin",
  "aceCategories": {
    "items": "列表项",
    "list": "列表"
  },
  "conditions": [
    {
      "id": "compare-selection",
      "scriptName": "CompareSelection",
      "category": "list",
      "list-name": "比较当前选择项索引",
      "display-text": "当前选择项索引 {0} [b]{1}[/b]",
      "description": "要比较的选项的索引。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "要比较的所选项的索引。"
        }
      }
    },
    {
      "id": "on-selection-changed",
      "scriptName": "OnSelectionChanged",
      "category": "list",
      "list-name": "选择项变更",
      "display-text": "选择项变更",
      "description": "当前的选择项发生变化时触发。注意，这不包括重复点击相同的选项。",
      "isTrigger": true
    },
    {
      "id": "on-clicked",
      "scriptName": "OnClicked",
      "category": "list",
      "list-name": "点击列表",
      "display-text": "点击列表",
      "description": "单击列表控件时触发。",
      "isTrigger": true
    },
    {
      "id": "on-double-clicked",
      "scriptName": "OnDoubleClicked",
      "category": "list",
      "list-name": "双击列表",
      "display-text": "双击列表",
      "description": "双击列表控件时触发。",
      "isTrigger": true
    },
    {
      "id": "compare-selected-item-text",
      "scriptName": "CompareSelectedText",
      "category": "list",
      "list-name": "比较当前选择项内容",
      "display-text": "当前选择项内容为[b]{0}[/b] [i]({1})[/i]",
      "description": "比较当前已选择项的文本。",
      "params": {
        "text-to-compare": {
          "type": "string",
          "name": "要比较的内容",
          "desc": "要进行比较的文本。"
        },
        "case-sensitivity": {
          "type": "combo",
          "name": "区分大小写",
          "desc": "是否严格区分大小写字母。如果不区分，则 'ABC' 也能匹配到 'abc'。",
          "items": {
            "ignore-case": "忽略大小写",
            "case-sensitive": "区分大小写"
          }
        }
      }
    },
    {
      "id": "compare-item-text-at",
      "scriptName": "CompareTextAt",
      "category": "list",
      "list-name": "比较选项文本",
      "display-text": "选项[b]{0}[/b]是[b]{1}[/b] [i]({2})[/i]",
      "description": "比较列表中选项的文本。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "要比较的选项在列表的索引位置，从 0 开始计数。"
        },
        "text-to-compare": {
          "type": "string",
          "name": "要比较的文字",
          "desc": "输入要与项目文本进行比较的文本。"
        },
        "case-sensitivity": {
          "type": "combo",
          "name": "区分大小写",
          "desc": "是否严格区分大小写字母。如果不区分，则 'ABC' 也能匹配到 'abc'。",
          "items": {
            "ignore-case": "忽略大小写",
            "case-sensitive": "区分大小写"
          }
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-selection",
      "scriptName": "Select",
      "category": "items",
      "list-name": "选择项目",
      "display-text": "选择列表第 [i]{0}[/i] 项",
      "description": "在列表中选择一个选项。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "要选择的选项在列表的索引位置，从 0 开始计数。"
        }
      }
    },
    {
      "id": "add-item",
      "scriptName": "AddItem",
      "category": "items",
      "list-name": "添加选项",
      "display-text": "添加选项 [i]{0}[/i]",
      "description": "添加选项到列表中。",
      "params": {
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "要添加的项目文本。"
        }
      }
    },
    {
      "id": "add-item-at",
      "scriptName": "AddItemAt",
      "category": "items",
      "list-name": "添加选项到位置",
      "display-text": "添加选项 [i]{0}[/i] 到位置 [i]{1}[/i]",
      "description": "添加待选项到列表指定位置。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "将选项添加到列表的索引位置，从0开始计数。"
        },
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "要添加的待选项的文本。"
        }
      }
    },
    {
      "id": "remove",
      "scriptName": "Remove",
      "category": "items",
      "list-name": "移除",
      "display-text": "删除选项 [i]{0}[/i]",
      "description": "从列表中删除选项。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "要删除的项的从零开始的索引。"
        }
      }
    },
    {
      "id": "set-item-text",
      "scriptName": "SetItemText",
      "category": "items",
      "list-name": "设置选项文本",
      "display-text": "设置列表选项[i]{0}[/i]文本为[i]{1}[/i]",
      "description": "设置列表中选项的文本。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "要更改的项的从零开始的索引。"
        },
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "要设置的选项文本。"
        }
      }
    },
    {
      "id": "clear",
      "scriptName": "Clear",
      "category": "items",
      "list-name": "清空列表",
      "display-text": "清空列表",
      "description": "删除列表中的所有待选项。"
    },
    {
      "id": "set-tooltip",
      "scriptName": "SetTooltip",
      "category": "list",
      "list-name": "设置工具提示",
      "display-text": "设置工具提示为[i]{0}[/i]",
      "description": "设置列表的工具提示。",
      "params": {
        "tooltip": {
          "type": "string",
          "name": "工具提示",
          "desc": "要弹出的工具提示信息。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "itemcount",
      "scriptName": "ItemCount",
      "category": "list",
      "translated-name": "列表项数量",
      "description": "列表中的选项数量。",
      "returnType": "number"
    },
    {
      "id": "selectedindex",
      "scriptName": "SelectedIndex",
      "category": "list",
      "translated-name": "已选项索引",
      "description": "当前所选项目的从零开始的索引。",
      "returnType": "number"
    },
    {
      "id": "selectedtext",
      "scriptName": "SelectedText",
      "category": "list",
      "translated-name": "已选项文本",
      "description": "当前选项的文本。",
      "returnType": "string"
    },
    {
      "id": "selectedcount",
      "scriptName": "SelectedCount",
      "category": "list",
      "translated-name": "已选项数量",
      "description": "在多选列表框中，当前所选项目的数量。",
      "returnType": "number"
    },
    {
      "id": "selectedindexat",
      "scriptName": "SelectedIndexAt",
      "category": "list",
      "translated-name": "获取已选项索引",
      "description": "在多选列表框中，当前选中的第N个项目的索引。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文本在已选项的索引，从 0 开始计数。"
        }
      },
      "returnType": "number"
    },
    {
      "id": "selectedtextat",
      "scriptName": "SelectedTextAt",
      "category": "list",
      "translated-name": "获取已选项文本",
      "description": "在多选列表框中，当前选中的第N个项目的文本。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文本在已选项的索引，从 0 开始计数。"
        }
      },
      "returnType": "string"
    },
    {
      "id": "itemtextat",
      "scriptName": "ItemTextAt",
      "category": "list",
      "translated-name": "获取选项文本",
      "description": "获取列表中第n个项目的文本。",
      "params": {
        "index": {
          "type": "number",
          "name": "索引",
          "desc": "文本在列表选项的索引，从 0 开始计数。"
        }
      },
      "returnType": "string"
    }
  ],
  "properties": {
    "items": {
      "name": "列表项",
      "desc": "列表初始存在的选项，用换行分隔。"
    },
    "tooltip": {
      "name": "提示",
      "desc": "将鼠标悬停在控件上时显示此文本。"
    },
    "initially-visible": {
      "name": "初始可见",
      "desc": "选择在场景开始时，对象是否可见。"
    },
    "enabled": {
      "name": "启用",
      "desc": "是否在启动时启用或禁用列表。"
    },
    "type": {
      "name": "类型",
      "desc": "要使用哪种控件。",
      "items": {
        "list-box": "列表框",
        "dropdown-list": "下拉列表"
      }
    },
    "multi-select": {
      "name": "多选",
      "desc": "对于列表框，是否允许多个选择。"
    },
    "auto-font-size": {
      "name": "自动字体大小",
      "desc": "根据图层比例自动设置字体大小。"
    },
    "id": {
      "name": "ID",
      "desc": "控件的可选ID，允许使用页面HTML中的CSS设置样式。"
    },
    "class": {
      "name": "Class",
      "desc": "可选项，添加 Class 元素来设置样式。"
    }
  }
}