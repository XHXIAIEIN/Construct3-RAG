{
  "text": {
    "plugins": {
      "sprite": {
        "name": "精灵",
        "description": "可以添加多张图片组成动画的对象，它是大多数项目的重要组成部分。",
        "properties": {
          "edit-animations": {
            "name": "动画",
            "desc": "单击以编辑对象的动画。",
            "link-text": "编辑"
          },
          "make-original-size": {
            "name": "图像尺寸",
            "desc": "单击以将对象设置为与其图像相同的大小。",
            "link-text": "恢复尺寸"
          },
          "initially-visible": {
            "name": "初始可见",
            "desc": "在场景开始时，对象是否可见。"
          },
          "initial-animation": {
            "name": "初始动画",
            "desc": "初始显示的动画。"
          },
          "initial-frame": {
            "name": "初始帧数",
            "desc": "初始显示的动画帧。"
          },
          "enable-collisions": {
            "name": "允许碰撞",
            "desc": "对象是否注册碰撞事件。注意，在真正触发碰撞事件前，禁用此选项不会提升性能。"
          },
          "live-preview": {
            "name": "预览",
            "desc": "在编辑器中进行实时预览。"
          }
        },
        "aceCategories": {
          "animations": "动画",
          "appearance": "显示",
          "collisions": "碰撞",
          "misc": "其他",
          "size-position": "尺寸和位置",
          "web": "网络图像"
        },
        "conditions": {
          "is-animation-playing": {
            "list-name": "正在播放",
            "display-text": "正在播放 {0} 动画",
            "description": "检测当前正在播放哪个的动画。",
            "params": {
              "animation": {
                "name": "动画",
                "desc": "要检测的动画名称。"
              }
            }
          },
          "compare-animation-frame": {
            "list-name": "比较帧数",
            "display-text": "动画帧 {0} {1}",
            "description": "测试当前显示的动画帧。",
            "params": {
              "comparison": {
                "name": "比较",
                "desc": "选择一种比较方式。"
              },
              "number": {
                "name": "数字",
                "desc": "要比较的动画帧编号（从0开始计数）。"
              }
            }
          },
          "on-animation-finished": {
            "list-name": "动画播放完成",
            "display-text": "动画 {0} 播放完成",
            "description": "动画播放结束时触发。",
            "params": {
              "animation": {
                "name": "动画",
                "desc": "要检测的动画名称。"
              }
            }
          },
          "on-any-animation-finished": {
            "list-name": "任意动画播放完成",
            "display-text": "任意动画播放完成",
            "description": "任意动画播放完成时触发"
          },
          "on-animation-frame-changed": {
            "list-name": "切换动画帧",
            "display-text": "切换动画帧",
            "description": "动画帧切换时触发"
          },
          "compare-animation-speed": {
            "list-name": "比较播放速度",
            "display-text": "动画播放速度 {0} {1}",
            "description": "比较当前动画帧播放速度",
            "params": {
              "comparison": {
                "name": "比较",
                "desc": "选择一种比较方式。"
              },
              "number": {
                "name": "数字",
                "desc": "要比较的动画速度。"
              }
            }
          },
          "is-mirrored": {
            "list-name": "已左右翻转",
            "display-text": "已左右翻转",
            "description": "测试对象是否已被设置 '左右翻转' 动作。"
          },
          "is-flipped": {
            "list-name": "已上下翻转",
            "display-text": "已上下翻转",
            "description": "测试对象是否已被设置 上下翻转' 操作。"
          },
          "collisions-enabled": {
            "list-name": "已启用碰撞",
            "display-text": "已启用碰撞",
            "description": "检测对象的碰撞功能是否已启用，并且允许触发碰撞事件。"
          },
          "on-image-url-loaded": {
            "list-name": "网络图像加载完成",
            "display-text": "网络图像加载完成",
            "description": "执行 '加载远程图像' 动作，图像加载完成时触发。"
          },
          "on-image-url-failed": {
            "list-name": "网络图像加载失败",
            "display-text": "网络图像加载失败",
            "description": "执行 '加载网络图像' 动作后，图像加载失败时触发。"
          },
          "compare-animation-frame-tag": {
            "list-name": "比较动画帧标签",
            "display-text": "动画帧标签 {0} {1}",
            "description": "与当前动画帧的标签进行比较。",
            "params": {
              "comparison": {
                "name": "比较",
                "desc": "选择一种比较方式。"
              },
              "tag": {
                "name": "标签",
                "desc": "用于比较的动画帧标签。"
              }
            }
          }
        },
        "actions": {
          "stop-animation": {
            "list-name": "停止播放",
            "display-text": "停止播放动画",
            "description": "停止播放当前动画。"
          },
          "start-animation": {
            "list-name": "开始播放",
            "display-text": "从{0}开始播放动画",
            "description": "如果已停止，则启动当前动画。",
            "params": {
              "from": {
                "name": "从",
                "desc": "选择是否将动画恢复或倒回到第一帧。",
                "items": {
                  "current-frame": "当前帧",
                  "beginning": "起始帧"
                }
              }
            }
          },
          "set-animation": {
            "list-name": "设置动画",
            "display-text": "设置动画为[b]{0}[/b](从{1}播放)",
            "description": "设置当前动画",
            "params": {
              "animation": {
                "name": "动画",
                "desc": "要设置的动画的名称。"
              },
              "from": {
                "name": "开始",
                "desc": "选择从当前帧开始播放，或是从动画第一帧播放。",
                "items": {
                  "current-frame": "当前帧",
                  "beginning": "起始帧"
                }
              }
            }
          },
          "set-animation-frame": {
            "list-name": "设置动画帧",
            "display-text": "设置动画帧为[b]{0}[/b]",
            "description": "通过动画帧的编号或标签，设置当前动画帧。",
            "params": {
              "frame-number": {
                "name": "编号",
                "desc": "要设置的动画帧编号（从0开始），或标签。"
              }
            }
          },
          "set-animation-speed": {
            "list-name": "设置播放速度",
            "display-text": "设置动画播放速度为[b]{0}[/b]",
            "description": "设置当前动画速度。",
            "params": {
              "speed": {
                "name": "速度",
                "desc": "新动画速度，每秒动画帧数。"
              }
            }
          },
          "set-repeat-to-frame": {
            "list-name": "设置重复帧",
            "display-text": "设置重复起始帧为[b]{0}[/b]",
            "description": "设置要从哪一帧开始重复播放，仅在循环播放的动画表中生效。",
            "params": {
              "frame-number": {
                "name": "编号",
                "desc": "要重复的动画帧编号（从0开始）。"
              }
            }
          },
          "set-blend-mode": {
            "list-name": "设置混合模式",
            "display-text": "设置混合模式为[i]{0}[/i]",
            "description": "设置此对象的背景混合模式。",
            "params": {
              "blend-mode": {
                "name": "混合模式",
                "desc": "为此对象选择新的混合模式。",
                "items": {
                  "normal": "正常",
                  "additive": "叠加",
                  "xor": "重叠消除",
                  "copy": "覆盖",
                  "destination-over": "背景穿透",
                  "source-in": "前景剪贴",
                  "destination-in": "背景剪贴",
                  "source-out": "前景剔除",
                  "destination-out": "背景剔除",
                  "source-atop": "前景混合",
                  "destination-atop": "背景混合",
                  "lighten": "变亮",
                  "darken": "变暗",
                  "multiply": "正片叠底",
                  "screen": "滤色"
                }
              }
            }
          },
          "set-mirrored": {
            "list-name": "设置左右翻转",
            "display-text": "[b]{0}[/b]",
            "description": "将对象设置为左右翻转，或恢复正常。",
            "params": {
              "state": {
                "name": "状态",
                "desc": "选择将对象左右翻转，或恢复正常。",
                "items": {
                  "mirrored": "左右翻转",
                  "not-mirrored": "关闭左右翻转"
                }
              }
            }
          },
          "set-flipped": {
            "list-name": "设置上下翻转",
            "display-text": "[b]{0}[/b]",
            "description": "将对象垂直翻转，或恢复正常。",
            "params": {
              "state": {
                "name": "状态",
                "desc": "选择将对象垂直翻转，或恢复正常。",
                "items": {
                  "flipped": "上下翻转",
                  "not-flipped": "关闭上下翻转"
                }
              }
            }
          },
          "spawn-another-object": {
            "list-name": "生成其他对象",
            "description": "在此对象上创建另一个对象。新对象将继承此对象的角度。",
            "params": {
              "object": {
                "name": "对象",
                "desc": "选择要创建的对象类型。"
              },
              "layer": {
                "name": "图层",
                "desc": "新实例对象要创建到的图层名称或编号。"
              },
              "image-point": {
                "name": "图像点",
                "desc": "输入图像点的名称或编号，对象原点的图像点编号是 0"
              },
              "create-hierarchy": {
                "name": "创建子对象",
                "desc": "根据在场景中设置的对象层级关系，创建此对象所有的子对象。在当前事件范围，被创建的子对象也会一起被选择。"
              },
              "template-name": {
                "name": "模板名称",
                "desc": "在生成对象时，继承特定的模板对象。模板可在实例对象的属性栏中定义。"
              }
            },
            "display-text": "生成对象 {0} 到图像点 [i]{2}[/i] (图层: [b]{1}[/b], 对象层级: [i]{3}[/i], 继承模板: [i]{4}[/i])"
          },
          "set-collisions-enabled": {
            "list-name": "启用碰撞",
            "display-text": "[b]{0}[/b]碰撞",
            "description": "对象是否能触发碰撞相关的事件。",
            "params": {
              "collisions": {
                "name": "碰撞",
                "desc": "启用或禁用此对象的碰撞。",
                "items": {
                  "disabled": "禁用",
                  "enabled": "启用"
                }
              }
            }
          },
          "set-scale": {
            "list-name": "设置缩放比例",
            "display-text": "设置缩放比例为[i]{0}[/i]",
            "description": "将宽度和高度设置为其原始大小的倍数。",
            "params": {
              "scale": {
                "name": "大小",
                "desc": "设置对象整体尺寸的倍数，1：原始尺寸，2：扩大两倍，0.5：缩小一半"
              }
            }
          },
          "load-image-from-url": {
            "list-name": "加载远程图像",
            "display-text": "加载远程图像 [i]{0}[/i] ({1}, 跨域 {2})",
            "description": "将当前显示的动画帧替换为从远程地址加载的图像，也可通过 AJAX 对象请求项目文件夹的本地文件。",
            "params": {
              "uri": {
                "name": "URI",
                "desc": "要导入的远程图像地址或通过表达式返回的数据地址。"
              },
              "size": {
                "name": "缩放",
                "desc": "使用新图像的尺寸大小，或保持当前精灵的尺寸。",
                "items": {
                  "resize-to-image-size": "缩放至新图片尺寸",
                  "keep-current-size": "保持当前尺寸"
                }
              },
              "cross-origin": {
                "name": "跨域",
                "desc": "如何处理请求的跨域（CORS）模式。",
                "items": {
                  "anonymous": "匿名",
                  "none": "无"
                }
              }
            }
          },
          "set-solid-collision-filter": {
            "list-name": "设置实体碰撞过滤",
            "display-text": "设置实体碰撞过滤 (模式: [i]{0}[/i], 实体标签: [b]{1}[/b])",
            "description": "启用或禁用与其他带有实体行为对象的碰撞。使用空格分隔多个标签。",
            "params": {
              "mode": {
                "name": "模式",
                "desc": "若使用 '包含' 模式，只能与带有相同标签的实体行为对象发生碰撞。使用 '排除' 模式则会忽略带有该标签的实体行为对象的碰撞。",
                "items": {
                  "inclusive": "包含",
                  "exclusive": "排除"
                }
              },
              "tags": {
                "name": "标签",
                "desc": "填写一个字符串，可以是任意内容，用于区分不同的实体。使用空格分隔多个标签。"
              }
            }
          },
          "add-remove-animation": {
            "list-name": "添加/删除动画",
            "display-text": "{0} 动画 [b]{1}[/b]",
            "description": "添加或删除对象的动画。",
            "params": {
              "which": {
                "name": "方式",
                "desc": "添加新动画或删除现有动画。",
                "items": {
                  "add": "添加",
                  "remove": "移除"
                }
              },
              "name": {
                "name": "名称",
                "desc": "添加或删除的动画名称。"
              }
            }
          },
          "add-remove-animation-frame": {
            "list-name": "添加/删除动画帧",
            "display-text": "{0} 动画帧 [b]{1}[/b] 到 [i]{2}[/i]",
            "description": "在当前动画中添加或删除动画帧。",
            "params": {
              "which": {
                "name": "方式",
                "desc": "添加或删除现有的动画帧。",
                "items": {
                  "add": "添加",
                  "remove": "移除"
                }
              },
              "animation": {
                "name": "动画",
                "desc": "要修改的动画的名称。"
              },
              "where": {
                "name": "位置",
                "desc": "要插入或删除动画帧的编号或标签。使用 -1 指定最后一帧。"
              }
            }
          }
        },
        "expressions": {
          "animationframe": {
            "description": "当前动画帧编号（从0开始计数）。",
            "translated-name": "动画帧"
          },
          "animationframecount": {
            "description": "当前动画中的动画帧数。",
            "translated-name": "动画帧数量"
          },
          "animationname": {
            "description": "当前动画的名称。",
            "translated-name": "动画名称"
          },
          "animationspeed": {
            "description": "当前动画的播放速度，以每秒动画帧数为单位。",
            "translated-name": "动画播放速度"
          },
          "imagewidth": {
            "description": "当前动画帧的图像原始宽度，不受缩放影响。以像素为单位。",
            "translated-name": "原始图像宽度"
          },
          "imageheight": {
            "description": "当前动画帧的图像原始高度，不受缩放影响。以像素为单位。",
            "translated-name": "原始图像高度"
          },
          "imagepointx": {
            "description": "对象的图像点的X坐标。",
            "params": {
              "imagepoint": {
                "name": "图像点",
                "desc": "要获取的图像点的名称或编号。"
              }
            },
            "translated-name": "图像点X"
          },
          "imagepointy": {
            "description": "对象的图像点的Y坐标。",
            "params": {
              "imagepoint": {
                "name": "图像点",
                "desc": "要获取的图像点的名称或编号。"
              }
            },
            "translated-name": "图像点Y"
          },
          "imagepointcount": {
            "description": "当前动画帧存在图像点的数量。",
            "translated-name": "图像点数量"
          },
          "originalanimationspeed": {
            "description": "在动画编辑器中设置的原始动画播放速度，单位为每秒播放的动画帧数。",
            "translated-name": "原始动画速度"
          },
          "poly-point-x-at": {
            "description": "获取碰撞多边形点的X位置。",
            "params": {
              "index": {
                "name": "索引",
                "desc": "要获取的碰撞多边形点的索引，从 0 开始计数。"
              }
            },
            "translated-name": "获取多边形顶点X坐标"
          },
          "poly-point-y-at": {
            "description": "获取碰撞多边形点的Y位置。",
            "params": {
              "index": {
                "name": "索引",
                "desc": "要获取的碰撞多边形点的索引，从 0 开始计数。"
              }
            },
            "translated-name": "获取多边形顶点Y坐标"
          },
          "poly-point-count": {
            "description": "当前帧的碰撞多边形顶点的数量。",
            "translated-name": "多边形顶点数量"
          },
          "imagepointz": {
            "description": "对象图像点的Z轴位置。",
            "params": {
              "imagepoint": {
                "name": "图像点",
                "desc": "要获取的图像点的名称或编号。"
              }
            },
            "translated-name": "图像点Z"
          },
          "animationframetag": {
            "description": "用于标识动画帧的标签。",
            "translated-name": "动画帧标签"
          }
        },
        "debugger": {
          "animation-properties": {
            "title": "精灵动画",
            "current-animation": "当前动画",
            "current-frame": "当前帧",
            "is-playing": "正在播放",
            "speed": "速度",
            "repeats": "重复"
          }
        }
      }
    }
  }
}