{
  "id": "qrcode",
  "name": "二维码",
  "description": "在游戏中生成一个二维码。",
  "type": "plugin",
  "aceCategories": {
    "qrcode": "二维码"
  },
  "conditions": [],
  "actions": [
    {
      "id": "set-text",
      "scriptName": "SetText",
      "category": "qrcode",
      "list-name": "设置文本",
      "display-text": "设置文本内容为[i]{0}[/i]",
      "description": "设置二维码的文本内容。",
      "params": {
        "text": {
          "type": "string",
          "name": "文本",
          "desc": "二维码的文本内容。"
        }
      }
    },
    {
      "id": "set-correction-level",
      "scriptName": "SetCorrectionLevel",
      "category": "qrcode",
      "list-name": "设置容错率",
      "display-text": "设置容错率为[i]{0}[/i]",
      "description": "设置二维码的容错等级。容错率越高，二维码生成的码点越密度，可在遮挡越多的情况下被扫描出来。",
      "params": {
        "correction-level": {
          "type": "combo",
          "name": "容错率",
          "desc": "容错率越高，二维码生成的码点越密度，可在遮挡越多的情况下被扫描出来。",
          "items": {
            "l": "7%",
            "m": "15%",
            "q": "25%",
            "h": "30%"
          }
        }
      }
    }
  ],
  "expressions": [],
  "properties": {
    "text": {
      "name": "文本",
      "desc": "二维码的文本内容。"
    },
