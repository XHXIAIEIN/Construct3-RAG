{
  "id": "shadowcaster",
  "name": "投影对象",
  "description": "搭配 '投影光' 对象类型使用，让对象能被 '投影光' 对象投射阴影。",
  "type": "behavior",
  "aceCategories": {},
  "conditions": [
    {
      "id": "is-enabled",
      "scriptName": "IsEnabled",
      "category": "",
      "list-name": "已启用",
      "display-text": "{my} 已启用",
      "description": "测试行为当前是否启用。"
    },
    {
      "id": "compare-height",
      "scriptName": "CompareHeight",
      "category": "",
      "list-name": "比较投影高度",
      "display-text": "{my} 投影高度 {0} {1}",
      "description": "比较对象的高度，用于确定阴影投射的长度。",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "比较",
          "desc": "选择一种比较方式。"
        },
        "height": {
          "type": "number",
          "name": "投影高度",
          "desc": "要比较的对象投影高度。"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "set-enabled",
      "scriptName": "SetEnabled",
      "category": "",
      "list-name": "设置启用",
      "display-text": "[b]{0}[/b] {my}",
      "description": "启用或禁用此行为。",
      "params": {
        "state": {
          "type": "combo",
          "name": "状态",
          "desc": "设置对象是否投射阴影。",
          "items": {
            "disabled": "禁用",
            "enabled": "启用"
          },
          "initialValue": "enabled"
        }
      }
    },
    {
      "id": "set-height",
      "scriptName": "SetHeight",
      "category": "",
      "list-name": "设置投影高度",
      "display-text": "设置 {my}投影高度为[i]{0}[/i]",
      "description": "设置对象的投影高度，用于确定阴影投射的长度，以像素为单位。",
      "params": {
        "height": {
          "type": "number",
          "name": "投影高度",
          "desc": "对象的投影高度，用于确定阴影投射的长度，以像素为单位。"
        }
      }
    },
    {
      "id": "set-tag",
      "scriptName": "SetTag",
      "category": "",
      "list-name": "设置投影标签",
      "display-text": "设置 {my}投影标签为[i]{0}[/i]",
      "description": "设置投影标签，用于区分不同的投影光源。",
      "params": {
        "tag": {
          "type": "string",
          "name": "投影标签",
          "desc": "填写一个字符串，可以是任意内容，用于区分不同的投影光源。"
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "height",
      "scriptName": "Height",
      "category": "",
      "translated-name": "投影高度",
      "description": "对象的投影高度，用于确定阴影投射的距离，以像素为单位。",
      "returnType": "number"
    },
    {
      "id": "tag",
      "scriptName": "Tag",
      "category": "",
      "translated-name": "投影标签",
      "description": "对象的阴影标签。",
      "returnType": "string"
    }
  ],
  "properties": {
    "height": {
      "name": "投影高度",
      "desc": "对象的高度，用于确定阴影投射的长度，以像素为单位。"
    },
    "tag": {
      "name": "投影标签",
      "desc": "填写一个字符串，可以是任意内容，用于区分不同的投影光源。"
    },
    "enabled": {
      "name": "启用",
      "desc": "游戏初始化时，是否默认启用该行为。"
    }
  }
}