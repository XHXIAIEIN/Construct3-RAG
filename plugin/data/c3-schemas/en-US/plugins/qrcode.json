{
  "id": "qrcode",
  "name": "QR code",
  "description": "Display a QR code in your project.",
  "type": "plugin",
  "aceCategories": {
    "qrcode": "QR code"
  },
  "conditions": [],
  "actions": [
    {
      "id": "set-text",
      "scriptName": "SetText",
      "category": "qrcode",
      "list-name": "Set text",
      "display-text": "Set text to [i]{0}[/i]",
      "description": "Set the text content of the QR code.",
      "params": {
        "text": {
          "type": "string",
          "name": "Text",
          "desc": "Text content of the QR code."
        }
      }
    },
    {
      "id": "set-correction-level",
      "scriptName": "SetCorrectionLevel",
      "category": "qrcode",
      "list-name": "Set correction level",
      "display-text": "Set correction level to [i]{0}[/i]",
      "description": "Set the error correction level. Higher levels include more error correction data for reliability.",
      "params": {
        "correction-level": {
          "type": "combo",
          "name": "Correction level",
          "desc": "The error correction level. Higher levels include more error correction data for reliability.",
          "items": {
            "l": "Low (7%)",
            "m": "Medium (15%)",
            "q": "Quartile (25%)",
            "h": "High (30%)"
          }
        }
      }
    }
  ],
  "expressions": [],
  "properties": {
    "text": {
      "name": "Text",
      "desc": "Text content of the QR code."
    },
    "correction-level": {
      "name": "Correction level",
      "desc": "The error correction level. Higher levels include more error correction data for reliability.",
      "items": {
        "l": "Low (7%)",
        "m": "Medium (15%)",
        "q": "Quartile (25%)",
        "h": "High (30%)"
      }
    },
    "initially-visible": {
      "name": "Initially visible",
      "desc": "Choose whether the object is visible when the layout starts."
    }
  },
