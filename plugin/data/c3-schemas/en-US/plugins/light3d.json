            "spot": "Spot"
          }
        }
      }
    },
    {
      "id": "set-intensity",
      "scriptName": "SetIntensity",
      "category": "light",
      "list-name": "Set intensity",
      "display-text": "Set intensity to [i]{0}[/i]",
      "description": "Set how bright the light is.",
      "params": {
        "intensity": {
          "type": "number",
          "name": "Intensity",
          "desc": "The new light intensity."
        }
      }
    },
    {
      "id": "set-reference-distance",
      "scriptName": "SetReferenceDistance",
      "category": "light",
      "list-name": "Set reference distance",
      "display-text": "Set reference distance to [i]{0}[/i]",
      "description": "Set the distance at which lighting for a point light is at the specified intensity.",
      "params": {
        "reference-distance": {
          "type": "number",
          "name": "Reference distance",
          "desc": "The new reference distance."
        }
      }
    },
    {
      "id": "set-attenuation-factor",
      "scriptName": "SetAttenuationFactor",
      "category": "light",
      "list-name": "Set attenuation factor",
      "display-text": "Set attenuation factor to [i]{0}[/i]",
      "description": "Set how much the light intensity reduces with distance.",
      "params": {
        "attenuation-factor": {
          "type": "number",
          "name": "Attenuation factor",
          "desc": "The new attenuation factor from 0-100."
        }
      }
    },
    {
      "id": "set-radius",
      "scriptName": "SetRadius",
      "category": "light",
      "list-name": "Set radius",
      "display-text": "Set radius to [i]{0}[/i]",
