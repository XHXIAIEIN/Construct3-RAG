      "params": {
        "radius": {
          "type": "number",
          "name": "Radius",
          "desc": "The new radius."
        }
      }
    },
    {
      "id": "set-spot-angles",
      "scriptName": "SetSpotAngles",
      "category": "light",
      "list-name": "Set spotlight angles",
      "display-text": "Set spotlight inner angle to [i]{0}[/i] degrees, outer angle to [i]{1}[/i] degrees",
      "description": "Set the inner and outer cone angles for a spotlight.",
      "params": {
        "inner-angle": {
          "type": "number",
          "name": "Inner angle",
          "desc": "Spotlight inner cone angle in degrees."
        },
        "outer-angle": {
          "type": "number",
          "name": "Outer angle",
          "desc": "Spotlight outer cone angle in degrees."
        }
      }
    }
