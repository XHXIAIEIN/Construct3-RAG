{
  "id": "sliderbar",
  "name": "Slider bar",
  "description": "A slider bar allowing the user to pick a value between two values.",
  "type": "plugin",
  "aceCategories": {
    "slider-bar": "Slider bar"
  },
  "conditions": [
    {
      "id": "on-clicked",
      "scriptName": "OnClicked",
      "category": "slider-bar",
      "list-name": "On clicked",
      "display-text": "On clicked",
      "description": "Triggered when the slider bar is clicked.",
      "isTrigger": true
    },
    {
      "id": "compare-value",
      "scriptName": "CompareValue",
      "category": "slider-bar",
      "list-name": "Compare value",
      "display-text": "Slider value {0} [i]{1}[/i]",
      "description": "Compare the current value.",
      "params": {
        "comparison": {
          "type": "cmp",
          "name": "Comparison",
          "desc": "How to compare the current value."
        },
        "value": {
          "type": "number",
          "name": "Value",
          "desc": "Value to compare to."
        }
      }
    },
    {
      "id": "on-changed",
      "scriptName": "OnChanged",
      "category": "slider-bar",
      "list-name": "On changed",
      "display-text": "On changed",
      "description": "Triggered when the slider bar value is changed.",
      "isTrigger": true
    },
    {
      "id": "on-changing",
      "scriptName": "OnChanging",
      "category": "slider-bar",
      "list-name": "On changing",
      "display-text": "On changing",
      "description": "Triggered during the slider bar value being changed, such as while it is dragged.",
      "isTrigger": true
    }
  ],
  "actions": [
    {
      "id": "set-tooltip",
      "scriptName": "SetTooltip",
      "category": "slider-bar",
      "list-name": "Set tooltip",
      "display-text": "Set tooltip to {0}",
      "description": "Set the slider bar's tooltip.",
      "params": {
        "tooltip": {
          "type": "string",
          "name": "Tooltip",
          "desc": "The tooltip to set on the slider bar."
        }
      }
    },
    {
      "id": "set-value",
      "scriptName": "SetValue",
      "category": "slider-bar",
      "list-name": "Set value",
      "display-text": "Set value to [b]{0}[/b]",
      "description": "Set the value for the bar.",
      "params": {
        "value": {
          "type": "number",
          "name": "Value",
          "desc": "The value to set for the slider."
        }
      }
    },
    {
      "id": "set-maximum",
      "scriptName": "SetMaximum",
      "category": "slider-bar",
      "list-name": "Set maximum",
      "display-text": "Set maximum to [b]{0}[/b]",
      "description": "Set the maximum slider value for the bar.",
      "params": {
        "maximum": {
          "type": "number",
          "name": "Maximum",
          "desc": "The new maximum value for the slider bar."
        }
      }
    },
    {
      "id": "set-minimum",
      "scriptName": "SetMinimum",
      "category": "slider-bar",
      "list-name": "Set minimum",
      "display-text": "Set minimum to [b]{0}[/b]",
      "description": "Set the minimum slider value for the bar.",
      "params": {
        "minimum": {
          "type": "number",
          "name": "Minimum",
          "desc": "The new minimum value for the slider bar."
        }
      }
    },
    {
      "id": "set-step",
      "scriptName": "SetStep",
      "category": "slider-bar",
      "list-name": "Set step",
      "display-text": "Set step to [b]{0}[/b]",
      "description": "Set the slider value step for the bar.",
      "params": {
        "step": {
          "type": "number",
          "name": "Step",
          "desc": "The new stepping value for the slider bar."
        }
      }
    }
  ],
  "expressions": [
    {
      "id": "value",
      "scriptName": "Value",
      "category": "slider-bar",
      "translated-name": "Value",
      "description": "Current slider value.",
      "returnType": "number"
    },
    {
      "id": "maximum",
      "scriptName": "Maximum",
      "category": "slider-bar",
      "translated-name": "Maximum",
      "description": "Current maximum value.",
      "returnType": "number"
    },
    {
      "id": "minimum",
      "scriptName": "Minimum",
      "category": "slider-bar",
      "translated-name": "Minimum",
      "description": "Current minimum value.",
      "returnType": "number"
    },
    {
      "id": "step",
      "scriptName": "Step",
      "category": "slider-bar",
      "translated-name": "Step",
      "description": "Current step value.",
      "returnType": "number"
    }
  ],
  "properties": {
    "value": {
      "name": "Value",
      "desc": "Initial value of the slider bar."
    },
    "minimum": {
      "name": "Minimum",
      "desc": "The minimum value of the slider bar."
    },
    "maximum": {
      "name": "Maximum",
      "desc": "The maximum value of the slider bar."
    },
    "step": {
      "name": "Step",
      "desc": "The step value, giving the increments along the slider."
    },
    "tooltip": {
      "name": "Tooltip",
      "desc": "Display this text when hovering the mouse over the control."
    },
    "initially-visible": {
      "name": "Initially visible",
      "desc": "Choose if the object is visible when the layout starts."
    },
    "enabled": {
      "name": "Enabled",
      "desc": "Whether the slider is enabled or disabled on startup."
    },
    "id": {
      "name": "ID",
      "desc": "An optional ID for the element allowing it to be styled with CSS."
    },
    "class": {
      "name": "Class",
      "desc": "An optional class for the element allowing it to be styled with CSS."
    }
  },
