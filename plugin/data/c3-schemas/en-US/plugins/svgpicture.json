      "is-within-angle",
      "is-clockwise-from",
      "is-between-angles",
      "is-visible",
      "compare-opacity",
      "is-effect-enabled",
      "compare-instance-variable",
      "is-boolean-instance-variable-set",
      "pick-highestlowest",
