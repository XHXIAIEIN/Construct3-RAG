{
  "id": "svgpicture",
  "name": "SVG Picture",
  "description": "Display an SVG file imported to the project.",
  "type": "plugin",
  "aceCategories": {
    "appearance": "Appearance",
    "svg": "SVG"
  },
  "conditions": [],
  "actions": [
    {
      "id": "set-blend-mode",
      "scriptName": "SetEffect",
      "category": "appearance",
      "list-name": "Set blend mode",
      "display-text": "Set blend mode to [i]{0}[/i]",
      "description": "Set the background blend mode for this object.",
      "params": {
        "blend-mode": {
          "type": "combo",
          "name": "Blend mode",
          "desc": "Choose the new blend mode for this object.",
          "items": {
            "normal": "Normal",
            "additive": "Additive",
            "xor": "XOR",
            "copy": "Copy",
            "destination-over": "Destination over",
            "source-in": "Source in",
            "destination-in": "Destination in",
            "source-out": "Source out",
            "destination-out": "Destination out",
            "source-atop": "Source atop",
            "destination-atop": "Destination atop",
            "lighten": "Lighten",
            "darken": "Darken",
            "multiply": "Multiply",
            "screen": "Screen"
          }
        }
      }
    },
    {
      "id": "set-image",
      "scriptName": "SetImage",
      "category": "svg",
      "list-name": "Set image",
      "display-text": "Set image to [i]{0}[/i]",
      "description": "Set the SVG image to be displayed from a project file.",
      "params": {
        "file": {
          "type": "projectfile",
          "name": "File",
          "desc": "A project file to load an SVG image from."
        }
      },
      "isAsync": true
    },
    {
      "id": "set-image-by-name",
      "scriptName": "SetImageByName",
      "category": "svg",
      "list-name": "Set image (by name)",
      "display-text": "Set image to [i]{0}[/i]",
      "description": "Set the SVG image to be displayed from a string of a project file.",
      "params": {
        "file": {
          "type": "string",
          "name": "File",
          "desc": "A string of the name of a project file to load an SVG image from."
        }
      },
      "isAsync": true
    }
  ],
  "expressions": [],
  "properties": {
    "svg-file": {
      "name": "SVG file",
      "desc": "Pick an SVG file imported to the project to display."
    },
    "view-image": {
      "name": "Image",
      "desc": "Click to view the object's image file.",
      "link-text": "View"
    },
    "initially-visible": {
      "name": "Initially visible",
      "desc": "Choose whether the object is visible when the layout starts."
    },
    "origin": {
      "name": "Origin",
      "desc": "Choose the location of the origin in the object.",
      "items": {
        "top-left": "Top-left",
        "top": "Top",
        "top-right": "Top-right",
        "left": "Left",
        "center": "Center",
        "right": "Right",
        "bottom-left": "Bottom-left",
        "bottom": "Bottom",
        "bottom-right": "Bottom-right"
      }
    }
  },
  "commonAces": {
