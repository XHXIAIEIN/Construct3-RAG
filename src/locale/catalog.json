    "grammar": {
      "list": {
        "entity-quantifier-type": {
          "purpose": "Match an entity followed by a Chinese list quantifier and an ACE type.",
          "source": [
            "gold:ace-list-zh-02",
            "gold:ace-list-mixed-07"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._rule_based"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": null,
            "zh-CN": "^\\s*(?P<plugin>.+?)\\s*(?:有哪些|列出|所有|列举|的)\\s*(?:主要\\s*)?(?P<ace_type>{ace_type})\\s*$"
          }
        },
        "verb-entity-type": {
          "purpose": "Match an explicit Chinese list verb before an entity and ACE type.",
          "source": [
            "gold:ace-list-zh-03",
            "gold:ace-list-zh-08"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._rule_based"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": null,
            "zh-CN": "^\\s*(?:列出|列举|查看|显示|有哪些)\\s*(?P<plugin>.+?)\\s*(?:的|中的)?\\s*(?P<ace_type>{ace_type})\\s*$"
          }
        },
        "entity-type-suffix": {
          "purpose": "Match explicit list suffix forms in English, Chinese, and mixed-language requests.",
          "source": [
            "gold:ace-list-en-04",
            "gold:ace-list-mixed-06"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._rule_based"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": "^\\s*(?P<plugin>.+?)\\s*(?:的)?\\s*(?P<ace_type>{ace_type})\\s*list\\s*$",
            "zh-CN": "^\\s*(?P<plugin>.+?)\\s*(?:的)?\\s*(?P<ace_type>{ace_type})\\s*(?:列表|有哪些|一览)\\s*$"
          }
        }
      },
      "detail": {
        "entity-ace-usage": {
          "purpose": "Match bounded ACE detail requests that name both the Schema entity and ACE.",
          "source": [
            "gold:ace-detail-zh-01",
            "gold:ace-detail-en-03"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._rule_based"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": "^\\s*(?P<plugin>\\S+)\\s+(?P<ace_name>.+?)\\s+(?:parameters?|usage)\\s*$",
            "zh-CN": "^\\s*(?P<plugin>.+?)\\s*(?:的|中的)\\s*(?P<ace_name>.+?)\\s*(?:怎么用|参数|用法|怎么使用|有什么参数|参数是什么)\\s*$"
          }
        },
        "qualified-identifier": {
          "purpose": "Support the compact plugin:ace identifier form for deterministic detail lookup.",
          "source": [
            "contract:public direct lookup syntax",
            "gold:ace-detail-neutral-06"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._rule_based"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": "^\\s*(?P<plugin>[A-Za-z0-9_-]+):(?P<ace_name>[A-Za-z0-9_-]+)\\s*$",
            "zh-CN": null
          }
        }
      },
      "translate": {
        "command-term": {
          "purpose": "Match an explicit translation command followed by one bounded term.",
          "source": [
            "gold:translation-explicit-mixed-01"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._detect_translation"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": "^\\s*translate\\s+(?P<term>.+?)\\s*$",
            "zh-CN": "^\\s*翻译\\s+(?P<term>.+?)\\s*$"
          }
        },
        "term-to-language": {
          "purpose": "Match an explicit source term and requested target language.",
          "source": [
            "gold:translation-explicit-mixed-02",
            "gold:translation-explicit-zh-04"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._detect_translation"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": "^\\s*(?P<term>.+?)\\s*translate\\s*(?:to)?\\s*(?:chinese|english)\\s*$",
            "zh-CN": "^\\s*(?:把\\s*)?(?P<term>.+?)\\s*翻译\\s*(?:成)?\\s*(?:中文|英文)\\s*$"
          }
        },
        "term-language-name": {
          "purpose": "Match Chinese questions asking for the localized name of a concrete term.",
          "source": [
            "gold:translation-explicit-zh-03",
            "gold:translation-explicit-zh-05"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._detect_translation"
          ],
          "tests": [
            "tests/test_lookup.py",
            "tests/fixtures/query_gold.jsonl"
          ],
          "patterns": {
            "en-US": null,
            "zh-CN": "^\\s*(?P<term>.+?)\\s*(?:的)?\\s*(?:中文|英文)\\s*(?:是什么|怎么说)?\\s*$"
          }
        },
        "how-do-you-say": {
          "purpose": "Match the explicit English how-do-you-say translation construction.",
          "source": [
            "contract:bounded English term translation syntax"
          ],
          "consumers": [
            "src.lookup.intent.IntentClassifier._detect_translation"
          ],
          "tests": [
            "tests/test_lookup.py"
          ],
          "patterns": {
            "en-US": "^\\s*how\\s+do\\s+you\\s+say\\s+(?P<term>.+?)\\s+in\\s+(?:chinese|english)\\s*[?？]?\\s*$",
            "zh-CN": null
          }
        }
      }
