# Construct 3 RAG Configuration
# Copy to .env and edit as needed

# =============================================================================
# Mode
# =============================================================================
# Set to true for lookup-only mode (no Qdrant, no embedding, no Docker needed)
# LITE_MODE=true

# =============================================================================
# Vector Database (Qdrant) — not needed in lite mode
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# LLM (Ollama)
# =============================================================================
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434

# =============================================================================
# Embedding Model
# =============================================================================
# Qwen3-Embedding-0.6B: 1024 dims, 多语言 SOTA, instruction-tuned (默认推荐)
# Qwen3-Embedding-4B:   2560 dims, 需同时设置 EMBEDDING_DIMENSION=2560
# BAAI/bge-m3:          1024 dims, 支持 BGE_M3_NATIVE_SPARSE (需 FlagEmbedding)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# BGE_M3_NATIVE_SPARSE=true   # 仅当 EMBEDDING_MODEL=BAAI/bge-m3 时有效
