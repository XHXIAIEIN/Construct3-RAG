# Construct 3 RAG Configuration
# Copy to .env and edit as needed

# =============================================================================
# Mode
# =============================================================================
# Lookup-only is the default. Set false only when Qdrant and the semantic index
# are deliberately enabled (scripts/setup.py --full does this automatically).
LITE_MODE=true

# Construct data. C3_SCHEMA_DIR is optional; runtime otherwise prefers a matching
# generated cache and falls back to committed data/c3-schemas.
# C3_VERSION=r495.2
# C3_SCHEMA_DIR=D:/path/to/schemas
# RAG_SERVER_PORT=8765

# =============================================================================
# Vector Database (Qdrant) — not needed in lite mode
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# Embedding Model
# =============================================================================
# Qwen3-Embedding-0.6B: 1024 dims, 多语言 SOTA, instruction-tuned (默认推荐)
# Qwen3-Embedding-4B:   更高质量，需要更多显存
# BAAI/bge-m3:          1024 dims, 支持 BGE_M3_NATIVE_SPARSE (需 FlagEmbedding)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# BGE_M3_NATIVE_SPARSE=true   # 仅当 EMBEDDING_MODEL=BAAI/bge-m3 时有效
